{
	"name": "@create-something/shivworks-network",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev": "SHIVWORKS_LOCAL_DEV=1 vite dev",
		"dev:local": "SHIVWORKS_LOCAL_DEV=1 vite dev",
		"dev:prod-config": "vite dev",
		"dev:secrets": "SHIVWORKS_LOCAL_DEV=1 infisical run --env=dev -- vite dev",
		"migrate:local": "wrangler d1 migrations apply shivworks-network-db --local",
		"migrate:local:list": "wrangler d1 migrations list shivworks-network-db --local",
		"build": "vite build",
		"build:replit": "SHIVWORKS_DEPLOY_TARGET=replit vite build",
		"start:replit": "mkdir -p data && SHIVWORKS_DB_MODE=sqlite DATABASE_PATH=./data/shivworks-network.db HOST=0.0.0.0 PORT=3000 node build",
		"preview": "vite preview",
		"test": "svelte-kit sync && vitest --run --passWithNoTests",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write \"src/**/*.{ts,svelte,js}\" \"tests/**/*.ts\" \"*.{json,md,yml,yaml}\"",
		"format:check": "prettier --check \"src/**/*.{ts,svelte,js}\" \"tests/**/*.ts\" \"*.{json,md,yml,yaml}\"",
		"smoke": "playwright test",
		"test:e2e:auth": "playwright test tests/e2e/auth-smoke.spec.ts",
		"prepare": "node -e \"try{require.resolve('husky')}catch(e){process.exit(0)};require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"email:client-progress": "node --import tsx scripts/send-client-progress-email.ts",
		"deploy": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare --project-name=shivworks-network --branch=main",
		"deploy:preview": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare --project-name=shivworks-network --branch=staging",
		"deploy:staging": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare --project-name=shivworks-network --branch=staging",
		"migrate": "wrangler d1 migrations apply shivworks-network-db --remote",
		"migrate:list": "wrangler d1 migrations list shivworks-network-db --remote",
		"db:shell": "wrangler d1 execute shivworks-network-db --remote --command",
		"types": "wrangler types",
		"stream:configure": "node scripts/configure-stream-runtime.mjs",
		"load:smoke": "artillery run artillery/smoke.yml",
		"load:base": "artillery run artillery/base.yml",
		"load:auth": "artillery run artillery/authenticated.yml",
		"load:report": "artillery report artillery/report.json",
		"bulk-import": "node --import tsx scripts/bulk-import.ts",
		"verify:no-pii": "node scripts/verify-no-pii.mjs",
		"verify:no-pii:worktree": "node scripts/verify-no-pii.mjs --worktree",
		"validate:production-env": "node scripts/validate-production-env.mjs"
	},
	"lint-staged": {
		"*.{ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{js,mjs,cjs,json,md,yaml,yml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@clerk/backend": "^2.18.0",
		"@clerk/clerk-js": "^5.57.1",
		"@sentry/sveltekit": "^10.55.0",
		"better-sqlite3": "^12.6.2",
		"lucide-svelte": "^0.562.0",
		"pg": "^8.18.0",
		"resend": "^6.7.0",
		"tus-js-client": "^4.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241127.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^6.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/pg": "^8.16.0",
		"artillery": "^2.0.32",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.18.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.1",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.60.0",
		"vite": "6.4.2",
		"vitest": "^4.0.18",
		"wrangler": "^4.64.0"
	}
}
