	applyEntitlementMilestones: vi.fn(),
	rolloverStreakIfStale: vi.fn()
}));

import { handle } from './hooks.server';

describe('hooks.server (preview mode safety)', () => {
	beforeEach(() => {
		vi.clearAllMocks();
	});

	it('does not invoke getClerkClient or authenticateClerkRequest when AUTH_MODE=mock', async () => {
		const resolve = vi.fn(async () => new Response('ok'));

		const event = {
			request: new Request('https://network.shivworks.com/'),
			cookies: { get: vi.fn(() => undefined) },
			locals: {},
			platform: { env: { AUTH_MODE: 'mock', NODE_ENV: 'development' } }
		} as never;

