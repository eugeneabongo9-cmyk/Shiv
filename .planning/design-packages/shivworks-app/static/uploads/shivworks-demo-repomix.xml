<script lang="ts">
	import { onMount, onDestroy } from 'svelte';
	import { invalidateAll } from '$app/navigation';
	import type { PageData } from './$types';

	interface Props {
		data: PageData;
	}
	let { data }: Props = $props();

	let conversations = $derived(data.conversations);
	let eventSource: EventSource | null = null;

	function formatTimestamp(ts: number): string {
		const d = new Date(ts);
		const now = new Date();
		const sameDay = d.toDateString() === now.toDateString();
		if (sameDay) {
			return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
		}
		return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
	}

	function preview(body: string, fromMe: boolean): string {
		const text = body.replace(/\s+/g, ' ').trim();
		const truncated = text.length > 70 ? `${text.slice(0, 70)}…` : text;
		return fromMe ? `You: ${truncated}` : truncated;
	}

	onMount(() => {
		eventSource = new EventSource('/api/messages/stream');
		eventSource.addEventListener('dm.created', () => {
			invalidateAll();
		});
	});

	onDestroy(() => {
		eventSource?.close();
		eventSource = null;
	});
</script>

