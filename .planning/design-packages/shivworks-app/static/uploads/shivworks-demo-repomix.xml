        POST as postMessageHandler
} from './channels/[channelId]/messages/+server';
import {
        PATCH as patchMessageHandler,
        DELETE as deleteMessageHandler
} from './messages/[messageId]/+server';
import { POST as postReplyHandler } from './messages/[messageId]/replies/+server';
import { POST as postReactionHandler } from './messages/[messageId]/reactions/+server';
import { __resetRealtimeForTests } from '$lib/server/realtime';

type User = NonNullable<App.Locals['user']>;

function user(overrides: Partial<User> = {}): User {
        return {
                clerkUserId: 'user_bronze',
                email: 'b@example.com',
                name: 'Bronze',
                tier: 'bronze',
                role: 'member',
                accessStatus: 'active',
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString(),
                ...overrides
        };
}

function locals(u: User | null) {
        return {
                auth: u
