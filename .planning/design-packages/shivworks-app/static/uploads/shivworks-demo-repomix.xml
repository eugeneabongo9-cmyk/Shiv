<file path="scripts/check-auth-mode.mjs">
#!/usr/bin/env node
const nodeEnv = (process.env.NODE_ENV || '').toLowerCase();
const authMode = (process.env.AUTH_MODE || '').toLowerCase().trim();

const isProd = nodeEnv === 'production';

if (isProd && authMode === 'mock') {
	console.error(
		'\n[deploy precheck] AUTH_MODE=mock is not permitted when NODE_ENV=production.\n' +
			'Mock auth grants admin to every request and must never reach a deployed environment.\n\n' +
			'Fix: unset AUTH_MODE or set AUTH_MODE=clerk for the production build/deploy,\n' +
			'and ensure Clerk keys (PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY) are configured.\n'
	);
	process.exit(1);
}

if (authMode === 'mock') {
	console.warn(
		'[deploy precheck] AUTH_MODE=mock detected (NODE_ENV=' +
			(nodeEnv || 'unset') +
			'). Allowed for non-production only.'
	);
}

// In production, AUTH_MODE is either 'clerk' or unset (which defaults to clerk).
// Either way the app will try to authenticate via Clerk, so the required Clerk
// keys must be present or the first authenticated request will crash.
if (isProd && authMode !== 'mock') {
	const requiredClerkKeys = ['PUBLIC_CLERK_PUBLISHABLE_KEY', 'CLERK_SECRET_KEY'];
	const missingClerk = requiredClerkKeys.filter((k) => !process.env[k] || !process.env[k].trim());

	if (missingClerk.length > 0) {
		console.error(
			'\n[deploy precheck] Missing required Clerk environment variable(s) for production:\n' +
				missingClerk.map((k) => '  - ' + k).join('\n') +
				'\n\nAUTH_MODE=' +
				(authMode || 'unset (defaults to clerk in production)') +
				' requires real Clerk credentials. Without them, the app will boot but the first\n' +
				'authenticated request will fail.\n\n' +
				'Fix: configure the missing key(s) in your Cloudflare Pages / wrangler environment\n' +
				'and re-run the deploy.\n'
		);
		process.exit(1);
	}

	// Optional checks for other required production integrations. Gated on
	// NODE_ENV=production so dev / Replit preview builds are not affected.
	const optionalGroups = [
		{
			label: 'Stripe',
			keys: [
				'STRIPE_SECRET_KEY',
				'STRIPE_WEBHOOK_SECRET',
				'STRIPE_BRONZE_PRICE_ID',
				'STRIPE_VIP_PRICE_ID'
			]
		},
		{
			label: 'Resend',
			keys: ['RESEND_API_KEY']
		}
	];

	const missingOptional = [];
	for (const group of optionalGroups) {
		for (const key of group.keys) {
			if (!process.env[key] || !process.env[key].trim()) {
				missingOptional.push({ label: group.label, key });
			}
		}
	}

	if (missingOptional.length > 0) {
		console.error(
			'\n[deploy precheck] Missing required production environment variable(s):\n' +
				missingOptional.map(({ label, key }) => '  - ' + key + ' (' + label + ')').join('\n') +
				'\n\nThese keys are required for checkout, billing webhooks, and transactional email\n' +
				'to function in production.\n\n' +
				'Fix: configure the missing key(s) in your Cloudflare Pages / wrangler environment\n' +
				'and re-run the deploy.\n'
		);
		process.exit(1);
	}
}
</file>

