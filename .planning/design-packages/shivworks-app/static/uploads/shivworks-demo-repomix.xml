import type { Actions, PageServerLoad } from './$types';
import { fail } from '@sveltejs/kit';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
        getLatestModuleProgressForMember,
        getMemberProfile,
        listCourses,
        listEvents,
        listExternalLinks,
        listRecentUpdates,
        listSeries
} from '$lib/server/db/shivworks';
import { getMemberDossier } from '$lib/server/gamification';
import { requirePaidMember } from '$lib/server/guards';
import {
        dismissInAppNotification,
        listUnreadInAppNotifications
} from '$lib/server/in-app-notifications';
import { computeOnboardingChecklist } from '$lib/server/onboarding';
import { sortCoursesForDisplay } from '$lib/utils/course-order';

export const load: PageServerLoad = async ({ locals, platform }) => {
        const user = requirePaidMember(locals, '/dashboard');
        const db = getDBFromPlatform(platform);

        const [
                updates,
                courses,
                series,
                events,
                links,
                resumeItem,
                profile,
                dossier,
                onboarding
        ] = await Promise.all([
                listRecentUpdates(db, user, 4),
                listCourses(db, user),
                listSeries(db, user),
                listEvents(db, user),
                listExternalLinks(db, user),
                getLatestModuleProgressForMember(db, user),
                getMemberProfile(db, user.clerkUserId),
                getMemberDossier(db, user.clerkUserId, { activityLimit: 1, activityWindowDays: null }),
                computeOnboardingChecklist(db, user.clerkUserId, {
                        memberCreatedAt: Date.parse(user.createdAt) || undefined
                })
        ]);

        const sortedCourses = sortCoursesForDisplay(courses);
        const courseCounts = {
                total: courses.length,
                available: courses.filter((course) => course.status === 'available').length,
                roadmap: courses.filter((course) => course.status === 'coming_soon').length,
                archived: courses.filter((course) => course.status === 'archived').length
        };

        // Count of distinct courses completed for the dashboard tile. Uses
        // DISTINCT reference_id to avoid double-counting any historical duplicates.
        const courseCompleteRow = await db
                .prepare(
                        `SELECT COUNT(DISTINCT reference_id) AS n FROM member_training_points
                         WHERE member_id = ? AND action_type = 'course_complete' AND reference_id IS NOT NULL`
                )
                .bind(user.clerkUserId)
                .first<{ n: number | string }>();
        const coursesCompletedCount = Number(courseCompleteRow?.n ?? 0);

        const trainingStatus = {
                rankLabel: dossier.rank.rank.label,
                totalTp: dossier.totalTp,
                streakDays: dossier.streak.current,
                coursesCompleted: coursesCompletedCount
        };

        const notifications = await listUnreadInAppNotifications(db, user.clerkUserId, 3);

        return {
                user,
                updates,
                courses: sortedCourses.slice(0, 4),
                courseCounts,
                series,
                events: events.slice(0, 3),
                links,
                resumeItem,
                profile,
                trainingStatus,
                onboarding,
                notifications
        };
};

export const actions: Actions = {
        dismissNotification: async ({ request, locals, platform }) => {
                const user = requirePaidMember(locals, '/dashboard');
                const db = getDBFromPlatform(platform);
                const data = await request.formData();
                const id = String(data.get('notificationId') || '').trim();
                if (!id) return fail(400, { error: 'Missing notification id.' });
                await dismissInAppNotification(db, user.clerkUserId, id);
                return { success: true };
        }
};
