                                        Complete all five and earn 50 bonus Training Points and the Ready milestone.
                                </p>
                        </div>
                        <button
                                type="button"
                                class="checklist-dismiss"
                                onclick={dismiss}
                                disabled={busy}
                                aria-label="Dismiss checklist"
                        >
                                <X size={14} />
                        </button>
                </header>

                <div class="checklist-progress">
                        <div class="checklist-bar">
                                <div class="checklist-bar-fill" style="width: {pct}%"></div>
                        </div>
                        <span class="checklist-progress-label">{completedCount} of {totalCount} complete</span>
                </div>

                <ol class="checklist-items">
                        {#each current.items as item (item.key)}
                                <li class="checklist-item" class:checklist-item--done={item.complete}>
                                        <span class="checklist-mark" aria-hidden="true">
                                                {#if item.complete}
                                                        <Check size={12} />
                                                {/if}
                                        </span>
                                        <a href={item.href} class="checklist-link">
                                                <span class="checklist-text">{item.label}</span>
                                                {#if !item.complete}
                                                        <ArrowRight size={12} class="checklist-arrow" />
                                                {/if}
                                        </a>
                                </li>
                        {/each}
                </ol>

                {#if error}
                        <p class="checklist-error" role="alert">{error}</p>
                {/if}

                {#if allComplete}
                        <button type="button" class="checklist-finalize" onclick={finalize} disabled={busy}>
