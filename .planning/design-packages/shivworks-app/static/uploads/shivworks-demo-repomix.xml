<file path="src/routes/api/webhooks/stream/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { sendMediaUploadFailedEmail } from '$lib/email';
import { applyStreamMediaWebhookUpdate, getMemberByClerkId } from '$lib/server/db/shivworks';
import { resolveRuntimeEnv } from '$lib/server/env';
import { enqueueInAppNotification } from '$lib/server/in-app-notifications';
import { type StreamWebhookPayload, verifyStreamWebhookSignature } from '$lib/server/stream';

function normalizeState(payload: StreamWebhookPayload): 'processing' | 'ready' | 'failed' {
        const state = payload.status?.state?.toLowerCase();
        if (payload.readyToStream || state === 'ready') {
                return 'ready';
        }
        if (state === 'error' || state === 'failed') {
                return 'failed';
        }
        return 'processing';
}

export const POST: RequestHandler = async ({ request, platform }) => {
        const runtimeEnv = resolveRuntimeEnv(
                (platform as { env?: Record<string, string | undefined> } | undefined)?.env
        );
        if (!runtimeEnv.CLOUDFLARE_STREAM_WEBHOOK_SECRET) {
                return json({ success: false, error: 'Webhook secret is not configured' }, { status: 500 });
        }

        const rawBody = await request.text();
        const isValid = await verifyStreamWebhookSignature(
                request.headers.get('webhook-signature'),
                rawBody,
                runtimeEnv.CLOUDFLARE_STREAM_WEBHOOK_SECRET
        );
        if (!isValid) {
                return json({ success: false, error: 'Invalid webhook signature' }, { status: 401 });
        }

        let payload: StreamWebhookPayload;
        try {
                payload = JSON.parse(rawBody) as StreamWebhookPayload;
        } catch {
                return json({ success: false, error: 'Invalid JSON payload' }, { status: 400 });
        }
        if (!payload.uid) {
                return json({ success: false, error: 'Missing Stream UID' }, { status: 400 });
        }

        const db = getDBFromPlatform(platform);
        const updatedMedia = await applyStreamMediaWebhookUpdate(db, {
                streamUid: payload.uid,
                state: normalizeState(payload),
                durationSeconds: payload.duration ? Math.round(payload.duration) : null,
                sourceBytes: payload.size ?? null,
                failureReason: payload.status?.errorReasonText || payload.status?.errorReasonCode || null
        });

        if (!updatedMedia) {
                return json({ success: true, ignored: true, reason: 'stream_uid not found' }, { status: 202 });
        }

        if (
                updatedMedia.ingestStatus === 'failed' &&
                updatedMedia.createdByMemberId
        ) {
                const reason = updatedMedia.failureReason || 'Cloudflare Stream reported an unknown error.';
                const titleLabel = updatedMedia.title || updatedMedia.fileName || 'video upload';
                let freshlyEnqueued = false;
                try {
                        freshlyEnqueued = await enqueueInAppNotification(db, {
                                memberId: updatedMedia.createdByMemberId,
                                kind: 'media_upload_failed',
                                title: `Video upload failed: ${titleLabel}`,
                                body: `Cloudflare Stream could not process this upload. Reason: ${reason}. Re-upload from the admin uploads page.`,
                                ctaLabel: 'Open admin uploads',
                                ctaHref: '/admin#failed-uploads',
                                sourceRef: `media_asset:${updatedMedia.id}`
                        });
                } catch (error) {
                        console.error('Failed to enqueue failed-upload notification', error);
                }

                if (freshlyEnqueued) {
                        try {
                                const uploader = await getMemberByClerkId(db, updatedMedia.createdByMemberId);
                                if (uploader?.email) {
                                        await sendMediaUploadFailedEmail(runtimeEnv, {
                                                email: uploader.email,
                                                name: uploader.name || 'there',
                                                videoTitle: titleLabel,
                                                failureReason: reason
                                        });
                                }
                        } catch (error) {
                                console.error('Failed to send failed-upload email', error);
                        }
                }
        }

        return json({
                success: true,
                data: {
                        mediaAssetId: updatedMedia.id,
                        streamUid: payload.uid,
                        ingestStatus: updatedMedia.ingestStatus
                }
        });
};
</file>

