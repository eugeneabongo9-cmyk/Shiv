import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
        getMessageById,
        listChannels,
        listRecognitionsForMessage,
        recordRecognition
} from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import { awardPoints } from '$lib/server/gamification';
import { channelTopic, publish, userTopic } from '$lib/server/realtime';

export const POST: RequestHandler = async ({ params, locals, platform }) => {
        const user = requirePaidMember(locals, '/community');
        const db = getDBFromPlatform(platform);
        const message = await getMessageById(db, params.messageId);
        if (!message || message.deletedAt) error(404, 'Message not found');
        if (message.authorId === user.clerkUserId) {
                error(400, 'Cannot recognize your own post');
        }
        const channels = await listChannels(db);
        const channel = channels.find((c) => c.id === message.channelId);
        if (!channel) error(404, 'Channel not found');
        if (!permissionsFor(user, channel).canRead) error(403, 'Channel access denied');

        const record = await recordRecognition(db, {
                giverId: user.clerkUserId,
                recipientId: message.authorId,
                messageId: message.id
        });
        if (!record) {
                const existing = await listRecognitionsForMessage(db, message.id);
                return json({
                        applied: false,
                        reason: 'already_recognized',
                        recognitionCount: existing.length
                });
        }

        // Per-giver, per-day referenceId so each distinct giver's daily
        // recognition awards TP independently. (member_training_points
        // uniqueness is per (member_id, action_type, reference_type,
        // reference_id) — without the giver in the key, only the first
        // giver of the day would award TP.)
        const utcDay = new Date(record.createdAt).toISOString().slice(0, 10);
        const tp = await awardPoints(db, {
                memberId: message.authorId,
                action: 'recognition_received',
                referenceType: 'message',
                referenceId: `${message.id}:${utcDay}:${user.clerkUserId}`
        });

        const recognitions = await listRecognitionsForMessage(db, message.id);
        publish(channelTopic(channel.id), 'message.reaction.added', {
                messageId: message.id,
                channelId: channel.id,
                emojiKey: 'recognition',
                recognitionCount: recognitions.length
        });
        publish(userTopic(message.authorId), 'dm.created', {
                kind: 'recognition',
                messageId: message.id,
                giverId: user.clerkUserId
        });

        return json({
                applied: true,
                recognitionCount: recognitions.length,
                tp
        });
};
