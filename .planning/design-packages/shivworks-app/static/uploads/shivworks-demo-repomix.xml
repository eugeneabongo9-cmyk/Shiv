import { describe, it, expect } from 'vitest';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { resolve, dirname } from 'node:path';

const __dirname = dirname(fileURLToPath(import.meta.url));
const SCRIPT = resolve(__dirname, '../../../scripts/check-auth-mode.mjs');

const FULL_PROD_ENV = {
	PUBLIC_CLERK_PUBLISHABLE_KEY: 'pk_test_xxx',
	CLERK_SECRET_KEY: 'sk_test_xxx',
	STRIPE_SECRET_KEY: 'sk_test_xxx',
	STRIPE_WEBHOOK_SECRET: 'whsec_xxx',
	STRIPE_BRONZE_PRICE_ID: 'price_xxx',
	STRIPE_VIP_PRICE_ID: 'price_xxx',
	RESEND_API_KEY: 're_xxx'
};

function run(env: Record<string, string>) {
	// Start from a clean slate so the parent process's real env doesn't leak in
	// and accidentally satisfy the precheck.
	const baseEnv: Record<string, string> = {};
	for (const [k, v] of Object.entries(process.env)) {
		if (v === undefined) continue;
		// Drop any of the keys the precheck inspects so each test fully controls them.
		if (k === 'NODE_ENV' || k === 'AUTH_MODE') continue;
		if (k in FULL_PROD_ENV) continue;
		baseEnv[k] = v;
	}
	return spawnSync('node', [SCRIPT], {
		env: { ...baseEnv, ...env },
		encoding: 'utf8'
	});
}

describe('check-auth-mode precheck', () => {
	it('fails when AUTH_MODE=mock and NODE_ENV=production', () => {
		const result = run({ NODE_ENV: 'production', AUTH_MODE: 'mock' });
		expect(result.status).toBe(1);
		expect(result.stderr).toMatch(/AUTH_MODE=mock is not permitted/);
	});

	it('passes when AUTH_MODE=clerk and NODE_ENV=production with all required keys', () => {
		const result = run({ NODE_ENV: 'production', AUTH_MODE: 'clerk', ...FULL_PROD_ENV });
		expect(result.status).toBe(0);
	});

	it('passes when AUTH_MODE unset in production with all required keys', () => {
		const result = run({ NODE_ENV: 'production', AUTH_MODE: '', ...FULL_PROD_ENV });
		expect(result.status).toBe(0);
	});

	it('passes when AUTH_MODE=mock outside production', () => {
		const result = run({ NODE_ENV: 'development', AUTH_MODE: 'mock' });
		expect(result.status).toBe(0);
	});

	it('fails when NODE_ENV=production and PUBLIC_CLERK_PUBLISHABLE_KEY is missing', () => {
		const env = { ...FULL_PROD_ENV } as Record<string, string>;
		delete env.PUBLIC_CLERK_PUBLISHABLE_KEY;
		const result = run({ NODE_ENV: 'production', AUTH_MODE: 'clerk', ...env });
		expect(result.status).toBe(1);
		expect(result.stderr).toMatch(/Missing required Clerk environment variable/);
		expect(result.stderr).toMatch(/PUBLIC_CLERK_PUBLISHABLE_KEY/);
	});

	it('fails when NODE_ENV=production and CLERK_SECRET_KEY is missing', () => {
		const env = { ...FULL_PROD_ENV } as Record<string, string>;
		delete env.CLERK_SECRET_KEY;
		const result = run({ NODE_ENV: 'production', AUTH_MODE: '', ...env });
		expect(result.status).toBe(1);
		expect(result.stderr).toMatch(/CLERK_SECRET_KEY/);
	});

	it('fails when NODE_ENV=production and Stripe keys are missing', () => {
		const env = { ...FULL_PROD_ENV } as Record<string, string>;
		delete env.STRIPE_SECRET_KEY;
		delete env.STRIPE_WEBHOOK_SECRET;
		const result = run({ NODE_ENV: 'production', AUTH_MODE: 'clerk', ...env });
		expect(result.status).toBe(1);
		expect(result.stderr).toMatch(/STRIPE_SECRET_KEY \(Stripe\)/);
		expect(result.stderr).toMatch(/STRIPE_WEBHOOK_SECRET \(Stripe\)/);
	});

	it('fails when NODE_ENV=production and RESEND_API_KEY is missing', () => {
		const env = { ...FULL_PROD_ENV } as Record<string, string>;
		delete env.RESEND_API_KEY;
		const result = run({ NODE_ENV: 'production', AUTH_MODE: 'clerk', ...env });
		expect(result.status).toBe(1);
		expect(result.stderr).toMatch(/RESEND_API_KEY \(Resend\)/);
	});

	it('does not enforce Clerk/Stripe/Resend keys outside production', () => {
		const result = run({ NODE_ENV: 'development', AUTH_MODE: 'clerk' });
		expect(result.status).toBe(0);
	});
});
</file>

<file path="src/lib/server/realtime.ts">
/**
 * In-memory realtime broker shared by community channels and direct
 * messaging. Subscribers attach to one or more topics; publishers fan
 * out events to every subscriber on a topic.
 *
 * Topic naming convention:
 *   - `channel:<channelId>` — public/VIP community channels
 *   - `user:<clerkUserId>`  — per-user inbox (DMs, recognitions, etc.)
 *
 * Process-local. A single SvelteKit Node server is the deployment
 * target today; if we ever shard to multiple workers the broker can
 * be swapped for a Redis pub/sub or Cloudflare Durable Object behind
 * the same `subscribe`/`publish` surface.
 */

export type RealtimeEventKind =
        | 'message.created'
        | 'message.edited'
        | 'message.deleted'
        | 'message.pinned'
        | 'message.reaction.added'
        | 'message.reaction.removed'
        | 'thread.reply.created'
        | 'thread.reply.deleted'
        | 'dm.created';

export interface RealtimeEvent<TPayload = unknown> {
        kind: RealtimeEventKind;
        topic: string;
        payload: TPayload;
        publishedAt: number;
}

type Listener = (event: RealtimeEvent) => void;

const topics = new Map<string, Set<Listener>>();

export function publish<TPayload>(
        topic: string,
        kind: RealtimeEventKind,
        payload: TPayload
): void {
        const listeners = topics.get(topic);
        if (!listeners || listeners.size === 0) return;
        const event: RealtimeEvent<TPayload> = {
                kind,
                topic,
                payload,
                publishedAt: Date.now()
        };
        for (const listener of listeners) {
                try {
                        listener(event);
                } catch (err) {
                        console.error('[realtime] listener threw', err);
                }
        }
}

export function subscribe(topicList: string[], listener: Listener): () => void {
        const attached: string[] = [];
        for (const topic of topicList) {
                let set = topics.get(topic);
                if (!set) {
                        set = new Set();
                        topics.set(topic, set);
                }
                set.add(listener);
                attached.push(topic);
        }
        return () => {
                for (const topic of attached) {
                        const set = topics.get(topic);
                        if (!set) continue;
                        set.delete(listener);
                        if (set.size === 0) topics.delete(topic);
                }
        };
}

export function channelTopic(channelId: string): string {
        return `channel:${channelId}`;
}

export function userTopic(clerkUserId: string): string {
        return `user:${clerkUserId}`;
}

/** Test helper — wipe all subscriptions between cases. */
export function __resetRealtimeForTests(): void {
        topics.clear();
}
</file>

