}

.settings-embed-header {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 0.25rem 0.15rem 1rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--color-rule);
}

.settings-embed-header h2 {
        margin: 0;
        font-size: clamp(1.45rem, 3vw, 2rem);
}

.settings-embed-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        margin-bottom: 1rem;
}

.settings-clerk-shell {
        width: 100%;
        min-height: 40rem;
}

.settings-notification-panel {
        background: rgba(255, 255, 255, 0.02);
}

.settings-toggle {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0.85rem;
        align-items: start;
        padding: 1rem 1.05rem;
        border-radius: 1rem;
        border: 1px solid rgba(188, 19, 19, 0.12);
        background: rgba(255, 255, 255, 0.02);
}

.settings-toggle input {
        margin-top: 0.2rem;
        accent-color: var(--color-accent);
}

.settings-toggle strong {
        display: block;
        margin-bottom: 0.25rem;
}

.settings-toggle small {
        display: block;
        color: var(--color-fg-secondary);
        line-height: 1.55;
}

.settings-session-hero {
        margin-bottom: 1.2rem;
        background: var(--surface-strong);
}

.settings-session-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.8rem;
        margin-top: 1.25rem;
}

.settings-session-list-panel {
        display: flex;
        flex-direction: column;
        gap: 1rem;
}

.settings-session-list {
        margin-top: 0.2rem;
}

.profile-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin: 1.25rem 0 1rem;
}

.profile-summary span {
        display: block;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        margin-bottom: 0.4rem;
}

.hero-banner {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
        align-items: start;
        gap: 1.4rem;
}

.hero-banner h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2.2rem, 5vw, 4rem);
        max-width: 12ch;
}

.dashboard-metrics {
        margin-top: 1.25rem;
}

.event-meta {
        margin: 1rem 0;
        color: var(--color-fg-secondary);
}

.live-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
        gap: 1.35rem;
        align-items: start;
}

.live-primary {
        background: var(--surface-strong);
}

.live-primary-header h2,
.live-readiness-panel h2 {
