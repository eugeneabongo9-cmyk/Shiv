<file path="src/routes/api/community/feed/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { listChannelMessages, listChannels } from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import { presentMessages } from '$lib/server/community-presenter';

export const GET: RequestHandler = async ({ url, locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const channels = await listChannels(db);
	const visible = channels.filter((c) => permissionsFor(user, c).canRead);
	const limit = Math.min(Math.max(Number(url.searchParams.get('limit') || 60), 1), 200);
	const beforeRaw = url.searchParams.get('before');
	const before = beforeRaw ? Number(beforeRaw) : undefined;

	const perChannel = await Promise.all(
		visible.map((c) =>
			listChannelMessages(db, c.id, {
				limit,
				beforeCreatedAt: Number.isFinite(before) ? before : undefined
			}).then((msgs) => msgs.map((m) => ({ ...m, channel: c })))
		)
	);
	const merged = perChannel
		.flat()
		.sort((a, b) => b.createdAt - a.createdAt)
		.slice(0, limit);

	const presented = await presentMessages(db, merged, user);
	const channelMap = new Map(visible.map((c) => [c.id, c] as const));
	const items = presented.map((m) => {
		const ch = channelMap.get(m.channelId);
		return {
			...m,
			channel: ch ? { id: ch.id, slug: ch.slug, name: ch.name, category: ch.category } : null
		};
	});
	return json({ items });
};
</file>

