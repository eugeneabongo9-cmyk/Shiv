export interface DmConversationSummary {
        partnerId: string;
        lastMessage: DirectMessageRecord;
        unreadCount: number;
}

/**
 * Inbox listing: one row per conversation partner, with the most recent
 * message in that conversation and the unread count from that partner.
 * The "conversation" is implicit — the unique unordered pair (memberId,
 * partnerId).
 */
export async function listDmConversations(
        db: D1Compat,
        memberId: string
): Promise<DmConversationSummary[]> {
        const rows = await db
                .prepare(
                        `SELECT * FROM direct_messages
                         WHERE sender_id = ? OR recipient_id = ?
                         ORDER BY created_at DESC`
                )
                .bind(memberId, memberId)
                .all<Record<string, unknown>>();
        const seen = new Map<string, DmConversationSummary>();
        for (const row of rows.results) {
                const msg = mapDirectMessage(row);
                const partnerId = msg.senderId === memberId ? msg.recipientId : msg.senderId;
                if (!seen.has(partnerId)) {
                        seen.set(partnerId, { partnerId, lastMessage: msg, unreadCount: 0 });
                }
                const summary = seen.get(partnerId)!;
                if (msg.recipientId === memberId && msg.readAt === null) {
                        summary.unreadCount += 1;
                }
        }
        return Array.from(seen.values());
}

