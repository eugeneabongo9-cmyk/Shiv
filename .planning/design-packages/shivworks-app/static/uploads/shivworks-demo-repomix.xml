};

describe('runtime-key-guard', () => {
        it('reports no missing keys when all required values are present', () => {
                expect(findMissingProductionKeys(FULL_ENV)).toEqual([]);
        });

        it('flags missing Clerk publishable key', () => {
                const env = { ...FULL_ENV, PUBLIC_CLERK_PUBLISHABLE_KEY: '' };
                const missing = findMissingProductionKeys(env);
                expect(missing).toContainEqual({ label: 'Clerk', key: 'PUBLIC_CLERK_PUBLISHABLE_KEY' });
        });

        it('flags missing Clerk secret key', () => {
                const env = { ...FULL_ENV };
                delete (env as Record<string, string | undefined>).CLERK_SECRET_KEY;
                const missing = findMissingProductionKeys(env);
                expect(missing).toContainEqual({ label: 'Clerk', key: 'CLERK_SECRET_KEY' });
        });

        it('flags missing Stripe secret key', () => {
                const env = { ...FULL_ENV, STRIPE_SECRET_KEY: '   ' };
                const missing = findMissingProductionKeys(env);
                expect(missing).toContainEqual({ label: 'Stripe', key: 'STRIPE_SECRET_KEY' });
        });

        it('flags missing Resend key', () => {
                const env = { ...FULL_ENV, RESEND_API_KEY: '' };
                const missing = findMissingProductionKeys(env);
                expect(missing).toContainEqual({ label: 'Resend', key: 'RESEND_API_KEY' });
        });

        it('detects production from NODE_ENV', () => {
                expect(isProductionRuntime({ NODE_ENV: 'production' })).toBe(true);
                expect(isProductionRuntime({ NODE_ENV: 'PRODUCTION' })).toBe(true);
                expect(isProductionRuntime({ NODE_ENV: 'development' })).toBe(false);
