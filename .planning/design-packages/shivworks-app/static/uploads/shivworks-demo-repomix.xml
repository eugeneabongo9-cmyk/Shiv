<script lang="ts">
        import { Pin, MessageSquare, MoreHorizontal } from 'lucide-svelte';
        import type { PresentedMessage } from '$lib/server/community-presenter';
        import ReactionsBar from './ReactionsBar.svelte';
        import MessageMenu from './MessageMenu.svelte';

        interface Props {
                message: PresentedMessage;
                viewerId: string;
                viewerIsAdmin: boolean;
                onReact: (emojiKey: string, currentlyReacted: boolean) => void;
                onOpenThread: () => void;
                onEdit: (newBody: string) => void;
                onDelete: () => void;
                onPin?: () => void;
                onReport: () => void;
                onRecognize: () => void;
                canPostReply: boolean;
        }

        let {
                message,
                viewerId,
                viewerIsAdmin,
                onReact,
                onOpenThread,
                onEdit,
                onDelete,
                onPin,
                onReport,
                onRecognize,
                canPostReply
        }: Props = $props();

        let editing = $state(false);
        let draft = $state(message.body);
        let menuOpen = $state(false);

        function formatTime(ts: number): string {
                const d = new Date(ts);
                const now = new Date();
                if (d.toDateString() === now.toDateString()) {
                        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
                return d.toLocaleString([], {
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                });
        }

        function startEdit() {
                draft = message.body;
                editing = true;
                menuOpen = false;
        }

        function commitEdit() {
                const next = draft.trim();
                if (!next || next === message.body) {
                        editing = false;
                        return;
                }
                onEdit(next);
                editing = false;
        }

        const tierLabel = $derived(
                message.author.tier === 'vip'
                        ? 'VIP'
                        : message.author.tier === 'bronze'
                                ? 'Bronze'
                                : message.author.role === 'admin'
                                        ? 'Admin'
                                        : null
        );
        const isOwn = $derived(message.author.clerkUserId === viewerId);
</script>

