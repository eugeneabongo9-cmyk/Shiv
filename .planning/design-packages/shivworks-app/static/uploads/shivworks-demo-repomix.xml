}

.live-status-card,
.live-readiness-item {
        padding: 0.95rem 1rem;
        border-radius: 1rem;
        border: 1px solid rgba(188, 19, 19, 0.14);
        background: rgba(255, 255, 255, 0.025);
}

.live-status-card span,
.live-readiness-item span {
        display: block;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
}

.live-status-card strong,
.live-readiness-item strong {
        display: block;
        margin-top: 0.4rem;
