import { error } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { listChannels } from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import {
        channelTopic,
        subscribe,
        userTopic,
        type RealtimeEvent
} from '$lib/server/realtime';

const HEARTBEAT_MS = 25_000;

/**
 * Server-Sent Events transport. Subscribers pass a comma-separated
 * `?channels=` list of channel ids to subscribe to (filtered against
 * the caller's read permissions) and `?user=true` to also receive
 * their per-user inbox topic (DMs, recognitions). The same broker
 * powers direct messaging — DM endpoints publish to `user:<id>` and
 * any open stream for that user receives the event.
 */
export const GET: RequestHandler = async ({ url, locals, platform, request }) => {
        const user = requirePaidMember(locals, '/community');
        const db = getDBFromPlatform(platform);
        const channels = await listChannels(db);

        const requestedIds = (url.searchParams.get('channels') || '')
                .split(',')
                .map((id) => id.trim())
                .filter(Boolean);
        const includeUser = url.searchParams.get('user') !== 'false';

        const allowed: string[] = [];
        for (const id of requestedIds) {
                const channel = channels.find((c) => c.id === id);
                if (!channel) continue;
                if (permissionsFor(user, channel).canRead) allowed.push(channelTopic(id));
        }
        if (includeUser) allowed.push(userTopic(user.clerkUserId));

        if (allowed.length === 0) {
                error(400, 'No subscribable topics requested');
        }

        const encoder = new TextEncoder();
        let unsubscribe: (() => void) | null = null;
        let heartbeat: ReturnType<typeof setInterval> | null = null;

        let cleaned = false;
        const cleanup = () => {
                if (cleaned) return;
                cleaned = true;
                if (heartbeat) {
                        clearInterval(heartbeat);
                        heartbeat = null;
                }
                if (unsubscribe) {
                        unsubscribe();
                        unsubscribe = null;
                }
        };

        const stream = new ReadableStream<Uint8Array>({
                start(controller) {
                        const send = (event: RealtimeEvent) => {
                                try {
                                        const frame = `event: ${event.kind}\ndata: ${JSON.stringify(event)}\n\n`;
                                        controller.enqueue(encoder.encode(frame));
                                } catch (err) {
                                        console.error('[community/stream] enqueue failed', err);
                                }
                        };
                        unsubscribe = subscribe(allowed, send);
                        controller.enqueue(
                                encoder.encode(
                                        `event: ready\ndata: ${JSON.stringify({ topics: allowed })}\n\n`
                                )
                        );
                        heartbeat = setInterval(() => {
                                try {
                                        controller.enqueue(encoder.encode(`: ping ${Date.now()}\n\n`));
                                } catch {
                                        // closed; cleanup will fire via cancel/abort
                                }
                        }, HEARTBEAT_MS);
                        request.signal.addEventListener('abort', () => {
                                cleanup();
                                try {
                                        controller.close();
                                } catch {
                                        /* already closed */
                                }
                        });
                },
                cancel() {
                        cleanup();
                }
        });

        return new Response(stream, {
                headers: {
                        'content-type': 'text/event-stream; charset=utf-8',
                        'cache-control': 'no-cache, no-transform',
                        connection: 'keep-alive',
                        'x-accel-buffering': 'no'
                }
        });
};
