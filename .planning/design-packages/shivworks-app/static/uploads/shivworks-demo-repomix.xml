import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
	editMessage,
	getMessageById,
	listChannels,
	softDeleteMessage
} from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import {
	canDeleteMessage,
	canEditMessage,
	permissionsFor
} from '$lib/server/community-access';
import { channelTopic, publish } from '$lib/server/realtime';

const MAX_BODY_LENGTH = 4000;

async function loadMessageAndChannel(db: ReturnType<typeof getDBFromPlatform>, messageId: string) {
	const message = await getMessageById(db, messageId);
	if (!message || message.deletedAt) return null;
	const channels = await listChannels(db);
	const channel = channels.find((c) => c.id === message.channelId);
	if (!channel) return null;
	return { message, channel };
}

export const PATCH: RequestHandler = async ({ params, request, locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const ctx = await loadMessageAndChannel(db, params.messageId);
	if (!ctx) error(404, 'Message not found');
	if (!permissionsFor(user, ctx.channel).canRead) error(403, 'Channel access denied');
	if (!canEditMessage(user, ctx.message.authorId)) error(403, 'Cannot edit this message');

	const body = (await request.json().catch(() => ({}))) as { body?: unknown };
	const text = typeof body.body === 'string' ? body.body.trim() : '';
	if (!text) error(400, 'Message body is required');
	if (text.length > MAX_BODY_LENGTH) error(400, 'Message exceeds maximum length');

	await editMessage(db, ctx.message.id, text);
	const editedAt = Date.now();
	publish(channelTopic(ctx.channel.id), 'message.edited', {
		messageId: ctx.message.id,
		channelId: ctx.channel.id,
		body: text,
		editedAt
	});
	return json({ success: true, editedAt });
};

export const DELETE: RequestHandler = async ({ params, locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const ctx = await loadMessageAndChannel(db, params.messageId);
	if (!ctx) error(404, 'Message not found');
	if (!permissionsFor(user, ctx.channel).canRead) error(403, 'Channel access denied');
	if (!canDeleteMessage(user, ctx.message.authorId)) error(403, 'Cannot delete this message');

	await softDeleteMessage(db, ctx.message.id);
	publish(channelTopic(ctx.channel.id), 'message.deleted', {
		messageId: ctx.message.id,
		channelId: ctx.channel.id
	});
	return json({ success: true });
};
