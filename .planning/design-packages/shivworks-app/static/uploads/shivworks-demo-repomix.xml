		expect((event as { locals: App.Locals }).locals.authMode).toBe('mock');
		expect((event as { locals: App.Locals }).locals.auth.isAuthenticated).toBe(true);
		expect((event as { locals: App.Locals }).locals.user?.clerkUserId).toBe('mock-preview-user');
	});
});
