<file path="src/routes/api/admin/media/uploads/complete/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { getMediaAssetById, markMediaUploadCompleted } from '$lib/server/db/shivworks';

interface CompleteUploadRequest {
	mediaAssetId?: string;
}

function isAdmin(locals: App.Locals): boolean {
	return Boolean(locals.auth.isAuthenticated && locals.user?.role === 'admin');
}

export const POST: RequestHandler = async ({ request, locals, platform }) => {
	if (!locals.auth.isAuthenticated) {
		return json({ success: false, error: 'Authentication required' }, { status: 401 });
	}
	if (!isAdmin(locals)) {
		return json({ success: false, error: 'Admin access required' }, { status: 403 });
	}

	let payload: CompleteUploadRequest;
	try {
		payload = (await request.json()) as CompleteUploadRequest;
	} catch {
		return json({ success: false, error: 'Invalid JSON body' }, { status: 400 });
	}

	const mediaAssetId = payload.mediaAssetId?.trim();
	if (!mediaAssetId) {
		return json({ success: false, error: 'mediaAssetId is required' }, { status: 400 });
	}

	const db = getDBFromPlatform(platform);
	const existing = await getMediaAssetById(db, mediaAssetId);
	if (!existing) {
		return json({ success: false, error: 'Media asset not found' }, { status: 404 });
	}
	if (existing.provider !== 'cloudflare_stream' || !existing.providerAssetId) {
		return json(
			{ success: false, error: 'Media asset is missing a Cloudflare Stream UID' },
			{ status: 409 }
		);
	}
	if (existing.ingestStatus === 'failed') {
		return json(
			{ success: false, error: existing.failureReason || 'Video upload failed' },
			{ status: 409 }
		);
	}

	const mediaAsset =
		existing.ingestStatus === 'pending_upload'
			? await markMediaUploadCompleted(db, mediaAssetId)
			: existing;

	return json({
		success: true,
		data: {
			mediaAssetId,
			ingestStatus: mediaAsset?.ingestStatus ?? existing.ingestStatus,
			streamUid: existing.providerAssetId,
			updatedAt: mediaAsset?.updatedAt ?? existing.updatedAt
		}
	});
};
</file>

<file path="src/routes/api/admin/media/uploads/init/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { normalizeContentAudience } from '$lib/constants/tiers';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
	attachStreamUidToMediaAsset,
	createEpisodeUploadReservation,
	markMediaUploadFailed
} from '$lib/server/db/shivworks';
import { resolveRuntimeEnv } from '$lib/server/env';
import { createTusDirectUpload, getMaxDirectUploadBytes } from '$lib/server/stream';

const MAX_FILE_SIZE_BYTES = getMaxDirectUploadBytes();

interface InitUploadRequest {
	moduleId?: string;
	title?: string;
	description?: string;
	episodeNumber?: number;
	accessTier?: string;
	fileName?: string;
	fileSizeBytes?: number;
	maxDurationSeconds?: number;
	playbackPolicy?: 'private' | 'public';
}

function isAdmin(locals: App.Locals): boolean {
	return Boolean(locals.auth.isAuthenticated && locals.user?.role === 'admin');
}

function normalizePositiveInteger(value: unknown): number | null {
	if (value === undefined || value === null || value === '') {
		return null;
	}
	const parsed = Math.floor(Number(value));
	return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
}

export const POST: RequestHandler = async ({ request, locals, platform }) => {
	if (!locals.auth.isAuthenticated) {
		return json({ success: false, error: 'Authentication required' }, { status: 401 });
	}
	if (!isAdmin(locals)) {
		return json({ success: false, error: 'Admin access required' }, { status: 403 });
	}

	let payload: InitUploadRequest;
	try {
		payload = (await request.json()) as InitUploadRequest;
	} catch {
		return json({ success: false, error: 'Invalid JSON body' }, { status: 400 });
	}

	const moduleId = payload.moduleId?.trim();
	const title = payload.title?.trim();
	const fileSizeBytes = Number(payload.fileSizeBytes);
	const maxDurationSeconds = normalizePositiveInteger(payload.maxDurationSeconds);
	const episodeNumber = normalizePositiveInteger(payload.episodeNumber);

	if (!moduleId) {
		return json({ success: false, error: 'moduleId is required' }, { status: 400 });
	}
	if (!title) {
		return json({ success: false, error: 'Title is required' }, { status: 400 });
	}
	if (!Number.isFinite(fileSizeBytes) || fileSizeBytes <= 0) {
		return json({ success: false, error: 'fileSizeBytes must be a positive number' }, { status: 400 });
	}
	if (fileSizeBytes > MAX_FILE_SIZE_BYTES) {
		return json(
			{
				success: false,
				error: `File too large. Maximum supported size is ${MAX_FILE_SIZE_BYTES} bytes (30GB).`,
				maxFileSizeBytes: MAX_FILE_SIZE_BYTES
			},
			{ status: 400 }
		);
	}
	if (payload.playbackPolicy && payload.playbackPolicy !== 'private' && payload.playbackPolicy !== 'public') {
		return json({ success: false, error: 'Invalid playbackPolicy value' }, { status: 400 });
	}

	const db = getDBFromPlatform(platform);
	const runtimeEnv = resolveRuntimeEnv(
		(platform as { env?: Record<string, string | undefined> } | undefined)?.env
	);

	const reservation = await createEpisodeUploadReservation(db, {
		moduleId,
		title,
		description: payload.description?.trim() || null,
		episodeNumber,
		accessTier: payload.accessTier ? normalizeContentAudience(payload.accessTier) : null,
		fileName: payload.fileName?.trim() || `${title}.mp4`,
		sourceBytes: fileSizeBytes,
		durationSeconds: maxDurationSeconds,
		playbackPolicy: payload.playbackPolicy ?? 'private',
		createdByMemberId: locals.user!.clerkUserId
	});

	try {
		const directUpload = await createTusDirectUpload(runtimeEnv, {
			uploadLength: fileSizeBytes,
			fileName: payload.fileName?.trim() || `${title}.mp4`,
			creatorId: locals.user!.clerkUserId,
			maxDurationSeconds: maxDurationSeconds ?? undefined,
			playbackPolicy: payload.playbackPolicy ?? 'private',
			meta: {
				mediaAssetId: reservation.mediaAsset.id,
				episodeId: reservation.episode.id,
				moduleId,
				courseId: reservation.episode.courseId
			}
		});

		await attachStreamUidToMediaAsset(db, reservation.mediaAsset.id, directUpload.streamUid);

		return json({
			success: true,
			data: {
				mediaAssetId: reservation.mediaAsset.id,
				episodeId: reservation.episode.id,
				streamUid: directUpload.streamUid,
				uploadUrl: directUpload.uploadUrl,
				tusResumable: '1.0.0',
				maxFileSizeBytes: MAX_FILE_SIZE_BYTES,
				ingestStatus: 'pending_upload',
				expiresAt: directUpload.expiresAt
			}
		});
	} catch (error) {
		const reason = error instanceof Error ? error.message : 'Failed to initialize upload';
		await markMediaUploadFailed(db, reservation.mediaAsset.id, reason);
		return json({ success: false, error: reason }, { status: 500 });
	}
};
