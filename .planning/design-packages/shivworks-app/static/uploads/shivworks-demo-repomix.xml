<script lang="ts">
        import { onDestroy, onMount } from 'svelte';
        import { Hash, Lock, Pin } from 'lucide-svelte';
        import ChannelSidebar from '$lib/components/community/ChannelSidebar.svelte';
        import MessageItem from '$lib/components/community/MessageItem.svelte';
        import Composer from '$lib/components/community/Composer.svelte';
        import ThreadPanel from '$lib/components/community/ThreadPanel.svelte';
        import type { PresentedMessage } from '$lib/server/community-presenter';
        import type { PageData } from './$types';

        interface Props {
                data: PageData;
        }
        let { data }: Props = $props();

        type Channel = (typeof data.channelGroups)[number]['channels'][number];

        let activeChannel = $state<Channel>(data.initialChannel as Channel);
        let messages = $state<PresentedMessage[]>(data.initialMessages);
        let loadingMessages = $state(false);
        let activeThread = $state<PresentedMessage | null>(null);
        let scroller: HTMLDivElement | null = $state(null);
        let eventSource: EventSource | null = null;

        const viewer = data.viewer;
        const viewerIsAdmin = viewer.role === 'admin';

        function scrollToBottom() {
                queueMicrotask(() => {
                        if (scroller) scroller.scrollTop = scroller.scrollHeight;
                });
        }

        async function selectChannel(ch: Channel) {
                if (ch.id === activeChannel.id) return;
                activeChannel = ch;
                activeThread = null;
                await loadMessages();
        }

        async function loadMessages() {
                loadingMessages = true;
                try {
                        const res = await fetch(
                                `/api/community/channels/${activeChannel.id}/messages/presented?limit=50`
                        );
                        if (!res.ok) {
                                messages = [];
                                return;
                        }
                        const data = (await res.json()) as { messages: PresentedMessage[] };
                        messages = data.messages;
                        scrollToBottom();
                } finally {
                        loadingMessages = false;
                }
        }

        async function postTopLevel(body: string) {
                const res = await fetch(`/api/community/channels/${activeChannel.id}/messages`, {
                        method: 'POST',
                        headers: { 'content-type': 'application/json' },
                        body: JSON.stringify({ body })
                });
                if (res.ok) {
                        await loadMessages();
                }
        }

        async function toggleReaction(messageId: string, emojiKey: string) {
                await fetch(`/api/community/messages/${messageId}/reactions`, {
                        method: 'POST',
                        headers: { 'content-type': 'application/json' },
                        body: JSON.stringify({ emojiKey })
                });
                // Optimistic patch
                messages = messages.map((m) => {
                        if (m.id !== messageId) return m;
                        return {
                                ...m,
                                reactions: m.reactions.map((r) =>
                                        r.emojiKey === emojiKey
                                                ? {
                                                                ...r,
                                                                viewerHasReacted: !r.viewerHasReacted,
                                                                count: r.count + (r.viewerHasReacted ? -1 : 1)
                                                        }
                                                : r
                                )
                        };
                });
        }

        async function editMessage(messageId: string, body: string) {
                const res = await fetch(`/api/community/messages/${messageId}`, {
                        method: 'PATCH',
                        headers: { 'content-type': 'application/json' },
                        body: JSON.stringify({ body })
                });
                if (res.ok) {
                        messages = messages.map((m) =>
                                m.id === messageId ? { ...m, body, editedAt: Date.now() } : m
                        );
                }
        }

        async function deleteMessage(messageId: string) {
                if (!confirm('Delete this message?')) return;
                const res = await fetch(`/api/community/messages/${messageId}`, { method: 'DELETE' });
                if (res.ok) {
                        messages = messages.filter((m) => m.id !== messageId);
                }
        }

        async function recognizeMessage(messageId: string) {
                const res = await fetch(`/api/community/messages/${messageId}/recognize`, {
                        method: 'POST'
                });
                if (!res.ok) return;
                const data = (await res.json()) as {
                        applied: boolean;
                        recognitionCount: number;
                };
                messages = messages.map((m) =>
                        m.id === messageId
                                ? {
                                                ...m,
                                                recognitionCount: data.recognitionCount,
                                                viewerRecognized: true
                                        }
                                : m
                );
        }

        function reportMessage(_id: string) {
                alert('Thanks — reports route to admin moderation.');
        }

        async function pinMessage(messageId: string) {
                const target = messages.find((m) => m.id === messageId);
                if (!target) return;
                const nextPinned = !target.pinned;
                const res = await fetch(`/api/community/messages/${messageId}/pin`, {
                        method: nextPinned ? 'POST' : 'DELETE'
                });
                if (!res.ok) return;
                messages = messages.map((m) => (m.id === messageId ? { ...m, pinned: nextPinned } : m));
                // Re-sort so pinned messages float to the top.
                const pinned = messages.filter((m) => m.pinned);
                const rest = messages.filter((m) => !m.pinned);
                messages = [...pinned, ...rest];
        }

        function openThread(message: PresentedMessage) {
                activeThread = message;
        }

        // Realtime subscription via SSE.
        function connectStream() {
                if (eventSource) eventSource.close();
                const url = `/api/community/stream?channels=${encodeURIComponent(activeChannel.id)}&user=true`;
                eventSource = new EventSource(url);
                // SSE frames are full RealtimeEvent envelopes:
                // { kind, topic, payload: {...}, publishedAt }. Always read
                // through `.payload`.
                const readPayload = <T = Record<string, unknown>>(e: Event): T | null => {
                        try {
                                const evt = JSON.parse((e as MessageEvent).data);
                                return (evt?.payload ?? null) as T | null;
                        } catch {
                                return null;
                        }
                };
                eventSource.addEventListener('message.created', () => {
                        loadMessages();
                });
                eventSource.addEventListener('message.deleted', (e) => {
                        const payload = readPayload<{ messageId: string }>(e);
                        if (!payload) return;
                        messages = messages.filter((m) => m.id !== payload.messageId);
                });
                eventSource.addEventListener('message.edited', (e) => {
                        const payload = readPayload<{
                                messageId: string;
                                body?: unknown;
                                editedAt?: unknown;
                        }>(e);
                        if (!payload) return;
                        messages = messages.map((m) => {
                                if (m.id !== payload.messageId) return m;
                                const next = { ...m };
                                if (typeof payload.body === 'string') next.body = payload.body;
                                if (typeof payload.editedAt === 'number') next.editedAt = payload.editedAt;
                                return next;
                        });
                });
                eventSource.addEventListener('message.pinned', (e) => {
                        const payload = readPayload<{ messageId: string; pinned: boolean }>(e);
                        if (!payload) return;
                        messages = messages.map((m) =>
                                m.id === payload.messageId ? { ...m, pinned: !!payload.pinned } : m
                        );
                        const pinned = messages.filter((m) => m.pinned);
                        const rest = messages.filter((m) => !m.pinned);
                        messages = [...pinned, ...rest];
                });
                eventSource.addEventListener('message.reaction.added', () => loadMessages());
                eventSource.addEventListener('message.reaction.removed', () => loadMessages());
                eventSource.addEventListener('thread.reply.created', (e) => {
                        const payload = readPayload<{ parentId: string }>(e);
                        if (!payload) return;
                        messages = messages.map((m) =>
                                m.id === payload.parentId
                                        ? { ...m, threadReplyCount: m.threadReplyCount + 1 }
                                        : m
                        );
                        if (activeThread && activeThread.id === payload.parentId) {
                                // Trigger ThreadPanel to refetch by re-assigning the prop reference.
                                activeThread = { ...activeThread };
                        }
                });
        }

        $effect(() => {
                if (activeChannel) connectStream();
        });

        function focusMessage(id: string) {
                queueMicrotask(() => {
                        const el = scroller?.querySelector<HTMLElement>(`[data-message-id="${id}"]`);
                        if (el) {
                                el.scrollIntoView({ behavior: 'auto', block: 'center' });
                                el.classList.add('flash-focus');
                                setTimeout(() => el.classList.remove('flash-focus'), 1600);
                                const target = messages.find((m) => m.id === id);
                                if (target) activeThread = target;
                        }
                });
        }

        onMount(() => {
                if (data.focusMessageId) {
                        focusMessage(data.focusMessageId);
                } else {
                        scrollToBottom();
                }
        });
        onDestroy(() => {
                if (eventSource) eventSource.close();
        });

        const composerDisabled = $derived(!activeChannel.canPostTopLevel);
        const composerLockedMessage = $derived(
                activeChannel.slug === 'announcements'
                        ? 'Announcements are read-only.'
                        : activeChannel.slug === 'weekly-question'
                                ? 'Only Craig posts the weekly question. Reply in the thread.'
                                : 'You cannot post in this channel.'
        );
</script>

<svelte:head>
        <title>Community | ShivWorks Network</title>
</svelte:head>

<section class="community-shell">
        <header class="community-toolbar">
                <div>
                        <p class="card-eyebrow">Community</p>
                        <h1>Inside the network</h1>
                </div>
                <nav class="view-toggle" aria-label="Community view">
                        <a class="active" href="/community">Channels</a>
                        <a href="/community/feed">Feed</a>
                </nav>
        </header>

        <div class="community-grid" class:thread-open={activeThread != null}>
                <ChannelSidebar
                        groups={data.channelGroups}
                        activeChannelId={activeChannel.id}
                        onSelect={selectChannel}
                />

                <section class="message-pane">
                        <header class="pane-head">
                                <div class="pane-channel">
                                        <span class="channel-glyph">
                                                {#if activeChannel.vipOnly}
                                                        <Lock size={14} />
                                                {:else}
                                                        <Hash size={14} />
                                                {/if}
                                        </span>
                                        <h2>{activeChannel.name}</h2>
                                        {#if activeChannel.readOnly}
                                                <span class="lock-tag">
                                                        <Pin size={10} /> Read-only
                                                </span>
                                        {/if}
                                </div>
                        </header>

                        <div class="messages" bind:this={scroller}>
                                {#if loadingMessages}
                                        <p class="empty">Loading…</p>
                                {:else if messages.length === 0}
                                        <p class="empty">
                                                {activeChannel.slug === 'weekly-question'
                                                        ? 'Craig has not posted this week’s question yet.'
                                                        : 'No messages yet. Start the conversation.'}
                                        </p>
                                {:else}
                                        {#each messages as m (m.id)}
                                                <MessageItem
                                                        message={m}
                                                        viewerId={viewer.clerkUserId}
                                                        {viewerIsAdmin}
                                                        canPostReply={activeChannel.canPostReply}
                                                        onReact={(key) => toggleReaction(m.id, key)}
                                                        onOpenThread={() => openThread(m)}
                                                        onEdit={(body) => editMessage(m.id, body)}
                                                        onDelete={() => deleteMessage(m.id)}
                                                        onPin={() => pinMessage(m.id)}
                                                        onReport={() => reportMessage(m.id)}
                                                        onRecognize={() => recognizeMessage(m.id)}
                                                />
                                        {/each}
                                {/if}
                        </div>

                        <div class="pane-composer">
                                <Composer
                                        placeholder={`Message #${activeChannel.name}`}
                                        disabled={composerDisabled}
                                        disabledMessage={composerLockedMessage}
                                        onSend={postTopLevel}
                                />
                        </div>
                </section>

                {#if activeThread}
                        <ThreadPanel
                                parent={activeThread}
                                canPostReply={activeChannel.canPostReply}
                                onClose={() => (activeThread = null)}
                        />
                {/if}
        </div>
