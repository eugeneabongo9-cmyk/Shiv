import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
        addMessageReaction,
        getMessageById,
        listChannels,
        listMessageReactions,
        removeMessageReaction
} from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { isReactionKey, permissionsFor } from '$lib/server/community-access';
import { channelTopic, publish } from '$lib/server/realtime';

export const POST: RequestHandler = async ({ params, request, locals, platform }) => {
        const user = requirePaidMember(locals, '/community');
        const db = getDBFromPlatform(platform);
        const message = await getMessageById(db, params.messageId);
        if (!message || message.deletedAt) error(404, 'Message not found');
        const channels = await listChannels(db);
        const channel = channels.find((c) => c.id === message.channelId);
        if (!channel) error(404, 'Channel not found');
        const permissions = permissionsFor(user, channel);
        if (!permissions.canRead) error(403, 'Channel access denied');
        if (!permissions.canReact) error(403, 'Cannot react in this channel');

        const body = (await request.json().catch(() => ({}))) as {
                emojiKey?: unknown;
        };
        if (!isReactionKey(body.emojiKey)) error(400, 'Unsupported reaction');
        const emojiKey = body.emojiKey;

        // True toggle: a single call flips the caller's own reaction state for
        // this (message, emoji). Read current state, then add or remove.
        const existing = await listMessageReactions(db, message.id);
        const already = existing.some(
                (r) => r.memberId === user.clerkUserId && r.emojiKey === emojiKey
        );

        if (already) {
                await removeMessageReaction(db, {
                        messageId: message.id,
                        memberId: user.clerkUserId,
                        emojiKey
                });
                publish(channelTopic(channel.id), 'message.reaction.removed', {
                        messageId: message.id,
                        channelId: channel.id,
                        memberId: user.clerkUserId,
                        emojiKey
                });
        } else {
                await addMessageReaction(db, {
                        messageId: message.id,
                        memberId: user.clerkUserId,
                        emojiKey
                });
                publish(channelTopic(channel.id), 'message.reaction.added', {
                        messageId: message.id,
                        channelId: channel.id,
                        memberId: user.clerkUserId,
                        emojiKey
                });
        }

        const reactions = await listMessageReactions(db, message.id);
        return json({ success: true, reactions, applied: already ? 'removed' : 'added' });
};
