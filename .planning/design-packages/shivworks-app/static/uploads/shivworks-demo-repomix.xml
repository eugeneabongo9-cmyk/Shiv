import { beforeEach, describe, expect, it, vi } from 'vitest';

const {
	getDBFromPlatformMock,
	getMemberByClerkIdMock,
	listDirectMessageThreadMock,
	markDirectMessagesReadMock,
	countUnreadDirectMessagesMock
} = vi.hoisted(() => ({
	getDBFromPlatformMock: vi.fn(() => ({ kind: 'db' })),
	getMemberByClerkIdMock: vi.fn(),
	listDirectMessageThreadMock: vi.fn(),
	markDirectMessagesReadMock: vi.fn(),
	countUnreadDirectMessagesMock: vi.fn()
}));

vi.mock('$lib/server/d1-compat', () => ({
	getDBFromPlatform: getDBFromPlatformMock
}));

vi.mock('$lib/server/db/shivworks', () => ({
	getMemberByClerkId: getMemberByClerkIdMock,
	listDirectMessageThread: listDirectMessageThreadMock,
	markDirectMessagesRead: markDirectMessagesReadMock,
	countUnreadDirectMessages: countUnreadDirectMessagesMock
}));

import { load } from './+page.server';
import {
	__resetRealtimeForTests,
	subscribe,
	userTopic,
	type RealtimeEvent
} from '$lib/server/realtime';

type User = NonNullable<App.Locals['user']>;

function user(overrides: Partial<User> = {}): User {
	return {
		clerkUserId: 'user_alpha',
		email: 'a@example.com',
		name: 'Alpha',
		tier: 'bronze',
		role: 'member',
		accessStatus: 'active',
		createdAt: new Date().toISOString(),
		updatedAt: new Date().toISOString(),
		...overrides
	};
}

function locals(u: User | null) {
	return {
		auth: u
			? { userId: u.clerkUserId, sessionId: 'sess', isAuthenticated: true }
			: { userId: null, sessionId: null, isAuthenticated: false },
		user: u
	} as App.Locals;
}

beforeEach(() => {
	vi.clearAllMocks();
	__resetRealtimeForTests();
	getDBFromPlatformMock.mockReturnValue({ kind: 'db' });
});

describe('thread page server load', () => {
	it('marks messages read AND publishes a read receipt so the badge clears immediately', async () => {
		getMemberByClerkIdMock.mockResolvedValue({
			clerkUserId: 'user_beta',
			email: '',
			name: 'Beta',
			tier: 'vip',
			role: 'member',
			accessStatus: 'active',
			createdAt: '',
			updatedAt: ''
		});
		listDirectMessageThreadMock.mockResolvedValue([
			{ id: 'm1', senderId: 'user_beta', recipientId: 'user_alpha', body: 'hi', readAt: null, createdAt: 1 }
		]);
		countUnreadDirectMessagesMock.mockResolvedValue(0);

		const events: RealtimeEvent[] = [];
		subscribe([userTopic('user_alpha')], (e) => events.push(e));

		const result = await load({
			locals: locals(user()),
			platform: { env: {} },
			params: { partnerId: 'user_beta' }
		} as never);

		expect(markDirectMessagesReadMock).toHaveBeenCalledWith({ kind: 'db' }, 'user_alpha', 'user_beta');
		expect(events).toHaveLength(1);
		expect(events[0].kind).toBe('dm.created');
		const payload = events[0].payload as { readReceipt: { partnerId: string; unreadTotal: number } };
		expect(payload.readReceipt).toEqual({ partnerId: 'user_beta', unreadTotal: 0 });
		expect(result.partner.clerkUserId).toBe('user_beta');
		expect(result.messages).toHaveLength(1);
	});
});
