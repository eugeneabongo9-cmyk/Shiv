import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { requirePaidMember } from '$lib/server/guards';
import {
	listDmConversations,
	listMembersByClerkUserIds
} from '$lib/server/db/shivworks';

export const load: PageServerLoad = async ({ locals, platform }) => {
	const user = requirePaidMember(locals, '/messages');
	const db = getDBFromPlatform(platform);
	const conversations = await listDmConversations(db, user.clerkUserId);
	const partners = await listMembersByClerkUserIds(
		db,
		conversations.map((c) => c.partnerId)
	);
	const partnerMap = new Map(partners.map((p) => [p.clerkUserId, p]));

	return {
		viewer: {
			clerkUserId: user.clerkUserId,
			name: user.name,
			tier: user.tier
		},
		conversations: conversations.map((c) => ({
			partnerId: c.partnerId,
			partner: {
				clerkUserId: c.partnerId,
				name: partnerMap.get(c.partnerId)?.name ?? 'Member',
				tier: partnerMap.get(c.partnerId)?.tier ?? null
			},
			lastMessage: c.lastMessage,
			unreadCount: c.unreadCount
		}))
	};
};
