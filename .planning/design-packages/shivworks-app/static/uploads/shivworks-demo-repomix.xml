<file path="src/lib/server/in-app-notifications.ts">
import type { D1Compat } from '$lib/server/d1-compat';

export type InAppNotificationKind = 'reengagement_14d' | string;

export interface InAppNotificationRecord {
        id: string;
        memberId: string;
        kind: InAppNotificationKind;
        title: string;
        body: string | null;
        ctaLabel: string | null;
        ctaHref: string | null;
        sourceRef: string | null;
        createdAt: number;
        readAt: number | null;
        dismissedAt: number | null;
}

function mapRow(row: Record<string, unknown>): InAppNotificationRecord {
        return {
                id: String(row.id),
                memberId: String(row.member_id),
                kind: String(row.kind),
                title: String(row.title),
                body: row.body == null ? null : String(row.body),
                ctaLabel: row.cta_label == null ? null : String(row.cta_label),
                ctaHref: row.cta_href == null ? null : String(row.cta_href),
                sourceRef: row.source_ref == null ? null : String(row.source_ref),
                createdAt: Number(row.created_at || 0),
                readAt: row.read_at == null ? null : Number(row.read_at),
                dismissedAt: row.dismissed_at == null ? null : Number(row.dismissed_at)
        };
}

export interface EnqueueInAppNotificationInput {
        memberId: string;
        kind: InAppNotificationKind;
        title: string;
        body?: string | null;
        ctaLabel?: string | null;
        ctaHref?: string | null;
        sourceRef?: string | null;
}

/**
 * Insert a notification, deduplicated by (member_id, kind, source_ref).
 * Returns true if a row was inserted, false if a duplicate was suppressed.
 */
export async function enqueueInAppNotification(
        db: D1Compat,
        input: EnqueueInAppNotificationInput
): Promise<boolean> {
        const id = crypto.randomUUID();
        const now = Date.now();
        // Atomic dedupe: rely on the unique index over
        // (member_id, kind, COALESCE(source_ref, '')). INSERT OR IGNORE returns
        // changes()=0 when a duplicate is suppressed, regardless of concurrency.
        const result = await db
                .prepare(
                        `INSERT OR IGNORE INTO in_app_notifications
                         (id, member_id, kind, title, body, cta_label, cta_href, source_ref, created_at)
                         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
                )
                .bind(
                        id,
                        input.memberId,
                        input.kind,
                        input.title,
                        input.body ?? null,
                        input.ctaLabel ?? null,
                        input.ctaHref ?? null,
                        input.sourceRef ?? null,
                        now
                )
                .run();
        const changes =
                (result?.meta as { changes?: number } | undefined)?.changes ??
                (result as { changes?: number } | undefined)?.changes ??
                0;
        return Number(changes) > 0;
}

export async function listUnreadInAppNotifications(
        db: D1Compat,
        memberId: string,
        limit = 5
): Promise<InAppNotificationRecord[]> {
        const rows = await db
                .prepare(
                        `SELECT * FROM in_app_notifications
                         WHERE member_id = ? AND dismissed_at IS NULL
                         ORDER BY created_at DESC
                         LIMIT ?`
                )
                .bind(memberId, limit)
                .all<Record<string, unknown>>();
        return rows.results.map(mapRow);
}

export async function dismissInAppNotification(
        db: D1Compat,
        memberId: string,
        notificationId: string
): Promise<void> {
        await db
                .prepare(
                        `UPDATE in_app_notifications
                         SET dismissed_at = ?, read_at = COALESCE(read_at, ?)
                         WHERE id = ? AND member_id = ?`
                )
                .bind(Date.now(), Date.now(), notificationId, memberId)
                .run();
}
</file>

<file path="src/lib/server/realtime.test.ts">
import { afterEach, describe, expect, it } from 'vitest';
import {
	__resetRealtimeForTests,
	channelTopic,
	publish,
	subscribe,
	userTopic,
	type RealtimeEvent
} from './realtime';

afterEach(() => __resetRealtimeForTests());

describe('realtime broker', () => {
	it('delivers a published event to a subscriber on the same topic', () => {
		const received: RealtimeEvent[] = [];
		const unsub = subscribe([channelTopic('chan_x')], (event) => received.push(event));

		publish(channelTopic('chan_x'), 'message.created', { id: 'm1' });

		expect(received).toHaveLength(1);
		expect(received[0].kind).toBe('message.created');
		expect(received[0].topic).toBe('channel:chan_x');
		expect(received[0].payload).toEqual({ id: 'm1' });
		unsub();
	});

	it('does not deliver events on unrelated topics', () => {
		const received: RealtimeEvent[] = [];
		subscribe([channelTopic('chan_a')], (event) => received.push(event));
		publish(channelTopic('chan_b'), 'message.created', { id: 'm1' });
		expect(received).toHaveLength(0);
	});

	it('lets a subscriber attach to per-user inbox topics (DM use case)', () => {
		const received: RealtimeEvent[] = [];
		subscribe([userTopic('user_42')], (event) => received.push(event));
		publish(userTopic('user_42'), 'dm.created', { from: 'user_99', body: 'hi' });
		expect(received).toHaveLength(1);
		expect(received[0].kind).toBe('dm.created');
	});

	it('removes listeners on unsubscribe', () => {
		const received: RealtimeEvent[] = [];
		const unsub = subscribe([channelTopic('chan_y')], (event) => received.push(event));
		unsub();
		publish(channelTopic('chan_y'), 'message.created', { id: 'm1' });
		expect(received).toHaveLength(0);
	});

	it('fans out to multiple subscribers on the same topic', () => {
		const a: RealtimeEvent[] = [];
		const b: RealtimeEvent[] = [];
		subscribe([channelTopic('chan_z')], (e) => a.push(e));
		subscribe([channelTopic('chan_z')], (e) => b.push(e));
		publish(channelTopic('chan_z'), 'message.created', { id: 'm1' });
		expect(a).toHaveLength(1);
		expect(b).toHaveLength(1);
	});
});
</file>

