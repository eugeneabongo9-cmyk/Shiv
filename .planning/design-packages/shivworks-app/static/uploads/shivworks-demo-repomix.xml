export async function listFailedMediaUploads(
        db: D1Compat
): Promise<FailedMediaUploadRecord[]> {
        const results = await db
                .prepare(
                        `SELECT
                                media_assets.id AS media_id,
                                media_assets.title AS media_title,
                                media_assets.file_name AS media_file_name,
                                media_assets.provider_asset_id AS media_provider_asset_id,
                                media_assets.failure_reason AS media_failure_reason,
                                media_assets.created_by_member_id AS media_created_by_member_id,
                                media_assets.updated_at AS media_updated_at,
                                members.name AS uploader_name,
                                members.email AS uploader_email,
                                course_module_episodes.id AS episode_id,
                                course_module_episodes.episode_number AS episode_number,
                                course_module_episodes.title AS episode_title,
                                course_modules.id AS module_id,
                                course_modules.title AS module_title,
                                courses.id AS course_id,
                                courses.title AS course_title,
                                courses.slug AS course_slug
                         FROM media_assets
                         LEFT JOIN members ON members.clerk_user_id = media_assets.created_by_member_id
                         LEFT JOIN course_module_episodes ON course_module_episodes.media_asset_id = media_assets.id
                         LEFT JOIN course_modules ON course_modules.id = course_module_episodes.module_id
                         LEFT JOIN courses ON courses.id = course_module_episodes.course_id
                         WHERE media_assets.ingest_status = 'failed'
                         ORDER BY media_assets.updated_at DESC`
                )
                .all<Record<string, unknown>>();
        return results.results.map((row) => ({
                mediaAssetId: String(row.media_id),
                title: String(row.media_title || ''),
                fileName: row.media_file_name ? String(row.media_file_name) : null,
                providerAssetId: row.media_provider_asset_id ? String(row.media_provider_asset_id) : null,
                failureReason: row.media_failure_reason ? String(row.media_failure_reason) : null,
                createdByMemberId: row.media_created_by_member_id
                        ? String(row.media_created_by_member_id)
                        : null,
                createdByName: row.uploader_name ? String(row.uploader_name) : null,
                createdByEmail: row.uploader_email ? String(row.uploader_email) : null,
                updatedAt: Number(row.media_updated_at || 0),
                episodeId: row.episode_id ? String(row.episode_id) : null,
                episodeNumber: hasValueMedia(row.episode_number) ? Number(row.episode_number) : null,
                episodeTitle: row.episode_title ? String(row.episode_title) : null,
                moduleId: row.module_id ? String(row.module_id) : null,
                moduleTitle: row.module_title ? String(row.module_title) : null,
                courseId: row.course_id ? String(row.course_id) : null,
                courseTitle: row.course_title ? String(row.course_title) : null,
                courseSlug: row.course_slug ? String(row.course_slug) : null
        }));
}

