<file path="src/routes/api/admin/media/uploads/sync/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { applyStreamMediaWebhookUpdate, getMediaAssetById } from '$lib/server/db/shivworks';
import { resolveRuntimeEnv } from '$lib/server/env';
import { getStreamVideoDetails, type StreamVideoDetails } from '$lib/server/stream';

interface SyncUploadRequest {
	mediaAssetId?: string;
}

function isAdmin(locals: App.Locals): boolean {
	return Boolean(locals.auth.isAuthenticated && locals.user?.role === 'admin');
}

function normalizeStreamState(video: StreamVideoDetails): 'processing' | 'ready' | 'failed' {
	const state = video.status?.state?.toLowerCase();
	if (video.readyToStream || state === 'ready') {
		return 'ready';
	}
	if (state === 'error' || state === 'failed') {
		return 'failed';
	}
	return 'processing';
}

function normalizePositiveNumber(value: unknown): number | null {
	const parsed = Number(value);
	return Number.isFinite(parsed) && parsed > 0 ? Math.round(parsed) : null;
}

export const POST: RequestHandler = async ({ request, locals, platform }) => {
	if (!locals.auth.isAuthenticated) {
		return json({ success: false, error: 'Authentication required' }, { status: 401 });
	}
	if (!isAdmin(locals)) {
		return json({ success: false, error: 'Admin access required' }, { status: 403 });
	}

	let payload: SyncUploadRequest;
	try {
		payload = (await request.json()) as SyncUploadRequest;
	} catch {
		return json({ success: false, error: 'Invalid JSON body' }, { status: 400 });
	}

	const mediaAssetId = payload.mediaAssetId?.trim();
	if (!mediaAssetId) {
		return json({ success: false, error: 'mediaAssetId is required' }, { status: 400 });
	}

	const db = getDBFromPlatform(platform);
	const existing = await getMediaAssetById(db, mediaAssetId);
	if (!existing) {
		return json({ success: false, error: 'Media asset not found' }, { status: 404 });
	}
	if (existing.provider !== 'cloudflare_stream' || !existing.providerAssetId) {
		return json(
			{ success: false, error: 'Media asset is missing a Cloudflare Stream UID' },
			{ status: 409 }
		);
	}

	const runtimeEnv = resolveRuntimeEnv(
		(platform as { env?: Record<string, string | undefined> } | undefined)?.env
	);
	let streamVideo: StreamVideoDetails;
	try {
		streamVideo = await getStreamVideoDetails(runtimeEnv, existing.providerAssetId);
	} catch (error) {
		return json(
			{
				success: false,
				error: error instanceof Error ? error.message : 'Could not read Stream video status'
			},
			{ status: 502 }
		);
	}

	const state = normalizeStreamState(streamVideo);
	const failureReason = streamVideo.status?.errorReasonText || streamVideo.status?.errorReasonCode || null;
	const updatedMedia = await applyStreamMediaWebhookUpdate(db, {
		streamUid: existing.providerAssetId,
		state,
		durationSeconds: normalizePositiveNumber(streamVideo.duration),
		sourceBytes: normalizePositiveNumber(streamVideo.size),
		failureReason
	});

	if (!updatedMedia) {
		return json({ success: false, error: 'Stream asset was not linked to a media record' }, { status: 409 });
	}

	return json({
		success: true,
		data: {
			mediaAssetId: updatedMedia.id,
			streamUid: existing.providerAssetId,
			ingestStatus: updatedMedia.ingestStatus,
			streamState: streamVideo.status?.state ?? null,
			readyToStream: Boolean(streamVideo.readyToStream),
			durationSeconds: updatedMedia.durationSeconds,
			sourceBytes: updatedMedia.sourceBytes,
			failureReason: updatedMedia.failureReason
		}
	});
};
</file>

<file path="src/routes/api/clerk/webhook/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { deleteMemberByClerkId, upsertMemberFromWebhook } from '$lib/server/db/shivworks';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { resolveRuntimeEnv } from '$lib/server/env';
import { verifyClerkWebhook } from '$lib/server/clerk';
import { resolveAuthMode } from '$lib/server/auth-mode';

type ClerkUserEvent = {
        id: string;
        first_name?: string | null;
        last_name?: string | null;
        email_addresses?: Array<{
                email_address?: string | null;
                verification?: {
                        status?: string | null;
                } | null;
        }>;
};

function getWebhookEmail(user: ClerkUserEvent): string {
        return user.email_addresses?.[0]?.email_address || '';
}

function getWebhookName(user: ClerkUserEvent): string {
        return [user.first_name, user.last_name].filter(Boolean).join(' ').trim() || getWebhookEmail(user) || 'Member';
}

function isWebhookVerified(user: ClerkUserEvent): boolean {
        return user.email_addresses?.[0]?.verification?.status === 'verified';
}

export const POST: RequestHandler = async ({ request, platform }) => {
        const runtimeEnv = resolveRuntimeEnv(
                (platform as { env?: Record<string, string | undefined> } | undefined)?.env
        );

        if (resolveAuthMode(runtimeEnv) === 'mock') {
                return json(
                        {
                                success: false,
                                error: 'Clerk webhooks are disabled in preview mode. Switch to AUTH_MODE=clerk to receive real events.'
                        },
                        { status: 501 }
                );
        }

        try {
                const event = await verifyClerkWebhook(request, runtimeEnv);
                const db = getDBFromPlatform(platform);

                switch (event.type) {
                        case 'user.created':
                        case 'user.updated': {
                                const data = event.data as ClerkUserEvent;
                                await upsertMemberFromWebhook(db, {
                                        clerkUserId: data.id,
                                        email: getWebhookEmail(data),
                                        name: getWebhookName(data),
                                        emailVerified: isWebhookVerified(data)
                                });
                                break;
                        }
                        case 'user.deleted': {
                                const data = event.data as { id?: string | null };
                                if (data.id) {
                                        await deleteMemberByClerkId(db, data.id);
                                }
                                break;
                        }
                        default:
                                break;
                }

                return json({ success: true });
        } catch (error) {
                console.error('Clerk webhook failed', error);
                return json({ success: false, error: 'Clerk webhook failed' }, { status: 400 });
        }
};
</file>

