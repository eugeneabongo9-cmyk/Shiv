import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { requirePaidMember } from '$lib/server/guards';
import { getLeaderboardOptIn } from '$lib/server/db/shivworks';
import { getLeaderboard } from '$lib/server/gamification';

function shorten(name: string): string {
        const parts = name.trim().split(/\s+/);
        if (parts.length <= 1) return parts[0] ?? name;
        const first = parts[0];
        const lastInitial = parts[parts.length - 1]?.[0] ?? '';
        return lastInitial ? `${first} ${lastInitial.toUpperCase()}.` : first;
}

export const load: PageServerLoad = async ({ locals, platform, url }) => {
        const user = requirePaidMember(locals, '/leaderboard');
        const db = getDBFromPlatform(platform);
        const scope: 'monthly' | 'all_time' =
                url.searchParams.get('scope') === 'all_time' ? 'all_time' : 'monthly';

        const [board, viewerOptedIn] = await Promise.all([
                getLeaderboard(db, { scope, viewerId: user.clerkUserId, limit: 25 }),
                getLeaderboardOptIn(db, user.clerkUserId)
        ]);

        return {
                scope,
                viewer: { clerkUserId: user.clerkUserId, optedIn: viewerOptedIn },
                entries: board.entries.map((e) => ({ ...e, displayName: shorten(e.name) })),
                viewerEntry: board.viewer ? { ...board.viewer, displayName: shorten(board.viewer.name) } : null
        };
};
