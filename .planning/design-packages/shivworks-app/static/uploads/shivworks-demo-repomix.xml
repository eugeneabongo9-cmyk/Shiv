import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { requirePaidMember } from '$lib/server/guards';
import {
	getMemberByClerkId,
	listDirectMessageThread,
	sendDirectMessage
} from '$lib/server/db/shivworks';
import { publish, userTopic } from '$lib/server/realtime';

export const GET: RequestHandler = async ({ locals, platform, params, url }) => {
	const user = requirePaidMember(locals, '/messages');
	const partnerId = params.partnerId;
	if (!partnerId || partnerId === user.clerkUserId) {
		error(400, 'Invalid conversation partner');
	}
	const db = getDBFromPlatform(platform);
	const partner = await getMemberByClerkId(db, partnerId);
	if (!partner) error(404, 'Member not found');

	const limit = Number(url.searchParams.get('limit') || 100);
	const messages = await listDirectMessageThread(db, user.clerkUserId, partnerId, limit);
	// Return ascending so the UI renders oldest -> newest naturally.
	messages.reverse();
	return json({
		partner: {
			clerkUserId: partner.clerkUserId,
			name: partner.name,
			tier: partner.tier
		},
		messages
	});
};

export const POST: RequestHandler = async ({ locals, platform, params, request }) => {
	const user = requirePaidMember(locals, '/messages');
	const partnerId = params.partnerId;
	if (!partnerId || partnerId === user.clerkUserId) {
		error(400, 'Invalid conversation partner');
	}
	const db = getDBFromPlatform(platform);
	const partner = await getMemberByClerkId(db, partnerId);
	if (!partner) error(404, 'Member not found');

	const data = await request.json().catch(() => ({}));
	const body = String(data?.body || '').trim();
	if (!body) error(400, 'Message body is required');
	if (body.length > 4000) error(400, 'Message exceeds 4000 character limit');

	const record = await sendDirectMessage(db, {
		senderId: user.clerkUserId,
		recipientId: partnerId,
		body
	});

	const senderSummary = {
		clerkUserId: user.clerkUserId,
		name: user.name,
		tier: user.tier
	};
	const eventPayload = {
		message: record,
		sender: senderSummary,
		recipient: {
			clerkUserId: partner.clerkUserId,
			name: partner.name,
			tier: partner.tier
		}
	};
	publish(userTopic(partnerId), 'dm.created', eventPayload);
	publish(userTopic(user.clerkUserId), 'dm.created', eventPayload);

	return json({ message: record });
};
</file>

