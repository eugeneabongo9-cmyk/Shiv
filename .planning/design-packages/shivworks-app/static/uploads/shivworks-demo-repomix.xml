<script lang="ts">
        import { onDestroy, onMount } from 'svelte';
        import { Hash } from 'lucide-svelte';
        import type { PageData } from './$types';

        interface Props {
                data: PageData;
        }
        let { data }: Props = $props();

        let feed = $state(data.feed);
        let eventSource: EventSource | null = null;
        let refreshing = false;

        async function refreshFeed() {
                if (refreshing) return;
                refreshing = true;
                try {
                        const res = await fetch('/api/community/feed?limit=60');
                        if (!res.ok) return;
                        const payload = (await res.json()) as { items: typeof data.feed };
                        feed = payload.items;
                } finally {
                        refreshing = false;
                }
        }

        onMount(() => {
                const channelIds = data.channelGroups
                        .flatMap((g) => g.channels)
                        .map((c) => c.id)
                        .join(',');
                if (!channelIds) return;
                const url = `/api/community/stream?channels=${encodeURIComponent(channelIds)}`;
                eventSource = new EventSource(url);
                const onAny = () => refreshFeed();
                eventSource.addEventListener('message.created', onAny);
                eventSource.addEventListener('message.edited', onAny);
                eventSource.addEventListener('message.deleted', onAny);
                eventSource.addEventListener('message.reaction.added', onAny);
                eventSource.addEventListener('message.reaction.removed', onAny);
                eventSource.addEventListener('thread.reply.created', onAny);
        });
        onDestroy(() => {
                if (eventSource) eventSource.close();
        });

        function formatTime(ts: number): string {
                const d = new Date(ts);
                const now = new Date();
                if (d.toDateString() === now.toDateString()) {
                        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
                return d.toLocaleString([], {
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                });
        }

        function previewLines(body: string): string {
                const lines = body.split('\n').slice(0, 3);
                return lines.join('\n');
        }

        function reactionTotal(reactions: { count: number }[]): number {
                return reactions.reduce((acc, r) => acc + r.count, 0);
        }
</script>

