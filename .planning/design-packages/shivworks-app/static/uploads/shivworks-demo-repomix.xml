import type { Handle } from '@sveltejs/kit';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { resolveRuntimeEnv } from '$lib/server/env';
import { authenticateClerkRequest, getClerkClient } from '$lib/server/clerk';
import { ensureMemberIdentity } from '$lib/server/db/shivworks';
import { syncAndEnforceSessionLimit } from '$lib/server/session-security';
import { applyEntitlementMilestones, rolloverStreakIfStale } from '$lib/server/gamification';
import {
        resolveAuthMode,
        MOCK_AUTH,
        buildMockMember,
        parsePreviewIdentityCookie,
        PREVIEW_IDENTITY_COOKIE
} from '$lib/server/auth-mode';
import {
        findMissingProductionKeys,
        isProductionRuntime,
        logMissingKeysOnce,
        renderMissingKeysPage,
        shouldBypassKeyGuard
} from '$lib/server/runtime-key-guard';
import {
        logDbUnavailableOnce,
        probeDatabase,
        renderDbUnavailablePage,
        shouldBypassDbGuard
} from '$lib/server/db-availability-guard';

export const handle: Handle = async ({ event, resolve }) => {
        const runtimeEnv = resolveRuntimeEnv(
                (event.platform as { env?: Record<string, string | undefined> } | undefined)?.env
        );

        if (isProductionRuntime(runtimeEnv) && !shouldBypassKeyGuard(event.url.pathname)) {
                const missing = findMissingProductionKeys(runtimeEnv);
                if (missing.length > 0) {
                        logMissingKeysOnce(missing);
                        return renderMissingKeysPage(missing);
                }
        }

        if (isProductionRuntime(runtimeEnv) && !shouldBypassDbGuard(event.url.pathname)) {
                const probe = await probeDatabase(event.platform, runtimeEnv);
                if (!probe.ok) {
                        logDbUnavailableOnce(probe.failure);
                        return renderDbUnavailablePage(probe.failure);
                }
        }

        event.locals.auth = {
                userId: null,
                sessionId: null,
                isAuthenticated: false
        };
        event.locals.user = null;

        const authMode = resolveAuthMode(runtimeEnv);
        event.locals.authMode = authMode;

        if (authMode === 'mock') {
                const override = parsePreviewIdentityCookie(
                        event.cookies.get(PREVIEW_IDENTITY_COOKIE)
                );
                event.locals.auth = { ...MOCK_AUTH };
                event.locals.user = buildMockMember(runtimeEnv, override);
                return resolve(event);
        }

        const auth = await authenticateClerkRequest(event.request, runtimeEnv);
        event.locals.auth = auth;

        if (auth.userId) {
                try {
                        const db = getDBFromPlatform(event.platform);
                        const clerkClient = getClerkClient(runtimeEnv);

                        const member = await ensureMemberIdentity(db, clerkClient, auth.userId);
                        event.locals.user = member;

                        if (member?.clerkUserId) {
                                try {
                                        await rolloverStreakIfStale(db, member.clerkUserId);
                                } catch (err) {
                                        console.error('[hooks] rolloverStreakIfStale failed:', err);
                                }
                        }

                        if (member?.tier === 'bronze' || member?.tier === 'vip') {
                                try {
                                        await applyEntitlementMilestones(db, member.clerkUserId, member.tier);
                                } catch (err) {
                                        console.error('[hooks] applyEntitlementMilestones failed:', err);
                                }
                        }

                        if (auth.sessionId) {
                                await syncAndEnforceSessionLimit({
                                        db,
                                        clerkClient,
                                        member,
                                        sessionId: auth.sessionId,
                                        request: event.request,
                                        runtimeEnv
                                });
                        }
                } catch (error) {
                        console.error('Failed to hydrate authenticated ShivWorks member', error);
                }
        }

        return resolve(event);
};
