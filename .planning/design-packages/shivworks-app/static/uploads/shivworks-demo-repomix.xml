<script lang="ts">
	import { Send } from 'lucide-svelte';

	interface Props {
		placeholder: string;
		disabled?: boolean;
		disabledMessage?: string;
		onSend: (body: string) => Promise<void> | void;
	}

	let { placeholder, disabled = false, disabledMessage, onSend }: Props = $props();
	let value = $state('');
	let sending = $state(false);

	async function submit() {
		const text = value.trim();
		if (!text || sending || disabled) return;
		sending = true;
		try {
			await onSend(text);
			value = '';
		} finally {
			sending = false;
		}
	}

	function handleKey(e: KeyboardEvent) {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			submit();
		}
	}
</script>

<div class="composer" class:disabled>
	{#if disabled}
		<p class="locked">{disabledMessage ?? 'You cannot post in this channel.'}</p>
	{:else}
		<textarea
			class="composer-input"
			bind:value
			rows="2"
			{placeholder}
			onkeydown={handleKey}
			disabled={sending}
		></textarea>
		<button class="send" onclick={submit} disabled={sending || !value.trim()} aria-label="Send">
			<Send size={16} />
		</button>
	{/if}
</div>

