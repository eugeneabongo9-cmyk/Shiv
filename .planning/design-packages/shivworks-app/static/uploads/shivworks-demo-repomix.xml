<script lang="ts">
        import { getAudienceLabel } from '$lib/constants/tiers';
        import type { ActionData, PageData } from './$types';

        interface Props {
                data: PageData;
                form: ActionData;
        }

        let { data, form }: Props = $props();
        let uploadModuleId = $state('');
        let uploadTitle = $state('');
        let uploadDescription = $state('');
        let uploadEpisodeNumber = $state('');
        let uploadAccessTier = $state<'free' | 'member' | 'vip'>('member');
        let uploadPlaybackPolicy = $state<'private' | 'public'>('private');
        let uploadMaxDurationMinutes = $state('');
        let selectedUploadFile = $state<File | null>(null);
        let uploadStatus = $state<string | null>(null);
        let uploadError = $state<string | null>(null);
        let uploadPercent = $state<number | null>(null);
        let isUploading = $state(false);
        let syncingMediaAssetId = $state<string | null>(null);
        let mediaSyncStatus = $state<Record<string, string>>({});
        let mediaSyncError = $state<Record<string, string>>({});

        const TUS_CHUNK_SIZE_BYTES = 5 * 1024 * 1024;
        const TUS_RETRY_DELAYS_MS = [0, 1_000, 3_000, 5_000, 10_000, 20_000, 30_000];

        const selectedUploadModule = $derived(
                data.modules.find((module) => module.id === uploadModuleId) || data.modules[0] || null
        );

        $effect(() => {
                if (!uploadModuleId && data.modules[0]) {
                        uploadModuleId = data.modules[0].id;
                }
        });

        function toDateTimeLocal(value: number | null): string {
                if (!value) {
                        return '';
                }

                const date = new Date(value);
                return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
        }

        function episodesForModule(moduleId: string) {
                return data.episodes.filter((episode) => episode.moduleId === moduleId);
        }

        function formatBytes(value: number | null | undefined): string {
                if (!value) {
                        return 'No file size';
                }

                if (value >= 1024 * 1024 * 1024) {
                        return `${(value / (1024 * 1024 * 1024)).toFixed(1)} GB`;
                }

                return `${(value / (1024 * 1024)).toFixed(1)} MB`;
        }

        function formatMediaStatus(status: string): string {
                return status.replaceAll('_', ' ');
        }

        function handleUploadFileChange(event: Event) {
                const input = event.currentTarget as HTMLInputElement;
                selectedUploadFile = input.files?.[0] || null;
                uploadError = null;

                if (selectedUploadFile && !uploadTitle.trim()) {
                        uploadTitle = selectedUploadFile.name.replace(/\.[^.]+$/, '').replaceAll('-', ' ');
                }
        }

        async function syncStreamMedia(mediaAssetId: string) {
                syncingMediaAssetId = mediaAssetId;
                mediaSyncStatus = { ...mediaSyncStatus, [mediaAssetId]: 'Checking Cloudflare Stream...' };
                mediaSyncError = { ...mediaSyncError, [mediaAssetId]: '' };

                try {
                        const response = await fetch('/api/admin/media/uploads/sync', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ mediaAssetId })
                        });
                        const result = await response.json().catch(() => null);

                        if (!response.ok || !result?.success) {
                                throw new Error(result?.error || 'Could not sync Stream status.');
                        }

                        mediaSyncStatus = {
                                ...mediaSyncStatus,
                                [mediaAssetId]: `Cloudflare reports ${formatMediaStatus(result.data.ingestStatus)}. Refreshing...`
                        };
                        window.location.reload();
                } catch (error) {
                        mediaSyncError = {
                                ...mediaSyncError,
                                [mediaAssetId]: error instanceof Error ? error.message : 'Could not sync Stream status.'
                        };
                        mediaSyncStatus = { ...mediaSyncStatus, [mediaAssetId]: '' };
                } finally {
                        syncingMediaAssetId = null;
                }
        }

        interface TusPreviousUpload {
                uploadUrl?: string | null;
                metadata?: Record<string, string>;
        }
        interface TusUploadInstance {
                start: () => void;
                findPreviousUploads: () => Promise<TusPreviousUpload[]>;
                resumeFromPreviousUpload: (prev: TusPreviousUpload) => void;
                url: string | null;
                options: { metadata?: Record<string, string> };
        }
        type TusUploadCtor = new (file: File, options: Record<string, unknown>) => TusUploadInstance;

        async function loadTusUploadCtor(): Promise<TusUploadCtor> {
                const mod = (await import('tus-js-client')) as unknown as {
                        Upload?: TusUploadCtor;
                        default?: { Upload?: TusUploadCtor };
                };
                const Upload = mod.Upload || mod.default?.Upload;
                if (!Upload) {
                        throw new Error('Could not load the resumable upload client.');
                }
                return Upload;
        }

        function buildTusOptions(
                file: File,
                fingerprintKey: string,
                metadata: Record<string, string>
        ): Record<string, unknown> {
                return {
                        endpoint: 'https://upload.videodelivery.net/',
                        chunkSize: TUS_CHUNK_SIZE_BYTES,
                        retryDelays: TUS_RETRY_DELAYS_MS,
                        removeFingerprintOnSuccess: true,
                        fingerprint: () => Promise.resolve(fingerprintKey),
                        metadata,
                        onShouldRetry: (_error: Error, retryAttempt: number) => {
                                const retryDelay = TUS_RETRY_DELAYS_MS[retryAttempt] ?? null;
                                if (retryDelay !== null) {
                                        uploadStatus = `Upload interrupted. Retrying in ${Math.round(retryDelay / 1000)} seconds...`;
                                        return true;
                                }
                                return false;
                        },
                        onProgress: (bytesUploaded: number, bytesTotal: number) => {
                                uploadStatus = uploadStatus?.startsWith('Resuming')
                                        ? 'Resuming upload to Cloudflare Stream...'
                                        : 'Uploading to Cloudflare Stream...';
                                uploadPercent =
                                        bytesTotal > 0 ? Math.min(99, Math.round((bytesUploaded / bytesTotal) * 100)) : 0;
                                void file;
                        }
                };
        }

        function runTusUpload(
                Upload: TusUploadCtor,
                file: File,
                baseOptions: Record<string, unknown>,
                previous: TusPreviousUpload | null
        ): Promise<void> {
                return new Promise<void>((resolve, reject) => {
                        const upload = new Upload(file, {
                                ...baseOptions,
                                onError: (error: Error) => {
                                        reject(new Error(error.message || 'Network error while uploading video chunk.'));
                                },
                                onSuccess: () => {
                                        uploadPercent = 100;
                                        resolve();
                                }
                        });
                        if (previous) {
                                upload.resumeFromPreviousUpload(previous);
                        }
                        upload.start();
                });
        }

        async function handleDirectUpload(event: SubmitEvent) {
                event.preventDefault();

                if (!selectedUploadModule) {
                        uploadError = 'Choose a course module first.';
                        return;
                }
                if (!selectedUploadFile) {
                        uploadError = 'Choose a video file first.';
                        return;
                }
                if (!uploadTitle.trim()) {
                        uploadError = 'Add an episode title.';
                        return;
                }

                isUploading = true;
                uploadError = null;
                uploadStatus = 'Looking for a previous upload to resume...';
                uploadPercent = 0;

                const file = selectedUploadFile;
                const moduleId = selectedUploadModule.id;

                try {
                        const Upload = await loadTusUploadCtor();

                        // Fingerprint scopes resume to (module + filename + size) so the same file
                        // in two different modules doesn't collide and a different file with the
                        // same name doesn't accidentally match.
                        const fingerprintKey = `shivworks/${moduleId}/${file.name}/${file.size}`;
                        const baseMetadata: Record<string, string> = {
                                shivworksModule: moduleId,
                                shivworksFile: file.name
                        };

                        // First, probe for a previous upload using a throwaway instance with the
                        // same fingerprint. tus-js-client's findPreviousUploads is an instance
                        // method that reads its urlStorage; we don't start this one.
                        const probe = new Upload(file, buildTusOptions(file, fingerprintKey, baseMetadata));
                        const previousUploads = await probe.findPreviousUploads();
                        const resumable = previousUploads.find(
                                (prev) => prev?.metadata?.shivworksMediaAssetId && prev?.uploadUrl
                        );

                        let mediaAssetId: string;
                        let freshUploadUrl: string | null = null;
                        let useResume = false;

                        if (resumable?.metadata?.shivworksMediaAssetId && resumable.uploadUrl) {
                                mediaAssetId = resumable.metadata.shivworksMediaAssetId;
                                useResume = true;
                                uploadStatus = 'Resuming previous upload from where Cloudflare left off...';
                        } else {
                                uploadStatus = 'Creating upload...';
                                const maxDurationMinutes = Number(uploadMaxDurationMinutes);
                                const episodeNumber = Number(uploadEpisodeNumber);
                                const initResponse = await fetch('/api/admin/media/uploads/init', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                                moduleId,
                                                title: uploadTitle.trim(),
                                                description: uploadDescription.trim() || undefined,
                                                episodeNumber:
                                                        Number.isFinite(episodeNumber) && episodeNumber > 0 ? episodeNumber : undefined,
                                                accessTier: uploadAccessTier,
                                                fileName: file.name,
                                                fileSizeBytes: file.size,
                                                maxDurationSeconds:
                                                        Number.isFinite(maxDurationMinutes) && maxDurationMinutes > 0
                                                                ? Math.round(maxDurationMinutes * 60)
                                                                : undefined,
                                                playbackPolicy: uploadPlaybackPolicy
                                        })
                                });
                                const initResult = await initResponse.json().catch(() => null);

                                if (!initResponse.ok || !initResult?.success) {
                                        throw new Error(initResult?.error || 'Could not create the upload.');
                                }

                                mediaAssetId = initResult.data.mediaAssetId;
                                freshUploadUrl = initResult.data.uploadUrl;
                        }

                        const uploadOptions = buildTusOptions(file, fingerprintKey, {
                                ...baseMetadata,
                                shivworksMediaAssetId: mediaAssetId
                        });
                        if (!useResume && freshUploadUrl) {
                                (uploadOptions as Record<string, unknown>).uploadUrl = freshUploadUrl;
                        }

                        uploadStatus = useResume
                                ? 'Resuming upload to Cloudflare Stream...'
                                : 'Uploading to Cloudflare Stream...';
                        await runTusUpload(Upload, file, uploadOptions, useResume ? resumable ?? null : null);

                        uploadStatus = 'Finalizing upload...';
                        const completeResponse = await fetch('/api/admin/media/uploads/complete', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ mediaAssetId })
                        });
                        const completeResult = await completeResponse.json().catch(() => null);

                        if (!completeResponse.ok || !completeResult?.success) {
                                throw new Error(completeResult?.error || 'Could not finalize the upload.');
                        }

                        uploadPercent = 100;
                        uploadStatus = 'Upload complete. Refresh to see the new episode status.';
                        uploadTitle = '';
                        uploadDescription = '';
                        uploadEpisodeNumber = '';
                        uploadMaxDurationMinutes = '';
                        selectedUploadFile = null;
                } catch (error) {
                        uploadError = error instanceof Error ? error.message : 'Upload failed.';
                        uploadStatus = null;
                } finally {
                        isUploading = false;
                }
        }
</script>

