import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { canAccessAudience } from '$lib/constants/tiers';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { getCourseModuleEpisodeById } from '$lib/server/db/shivworks';
import { resolveRuntimeEnv } from '$lib/server/env';
import {
        buildPublicHlsUrl,
        buildSignedHlsUrl,
        createStreamPlaybackToken,
        getPlaybackTokenTtlSeconds
} from '$lib/server/stream';

export const GET: RequestHandler = async ({ locals, params, platform }) => {
        if (!locals.auth.isAuthenticated || !locals.user) {
                return json({ success: false, error: 'Authentication required' }, { status: 401 });
        }

        const db = getDBFromPlatform(platform);
        const episode = await getCourseModuleEpisodeById(db, params.episodeId);
        if (!episode) {
                return json({ success: false, error: 'Episode not found' }, { status: 404 });
        }
        if (episode.status !== 'available') {
                return json({ success: false, error: 'Episode is not available yet' }, { status: 409 });
        }
        if (!canAccessAudience(locals.user, episode.courseAccessTier) || !canAccessAudience(locals.user, episode.accessTier)) {
                return json({ success: false, error: 'Upgrade required for this episode' }, { status: 403 });
        }
        if (!episode.media) {
                return json({ success: false, error: 'Episode has no media asset yet' }, { status: 409 });
        }
        if (episode.media.ingestStatus !== 'ready') {
                const failed = episode.media.ingestStatus === 'failed';
                return json(
                        {
                                success: false,
                                error: failed
                                        ? 'Episode media failed to process'
                                        : 'Episode media is still processing',
                                ingestStatus: episode.media.ingestStatus,
                                failureReason: failed ? episode.media.failureReason ?? null : null
                        },
                        { status: 409 }
                );
        }

        if (episode.media.provider === 'external') {
                return json({
                        success: true,
                        data: {
                                episodeId: episode.id,
                                provider: episode.media.provider,
                                playbackType: episode.media.sourceUrl?.startsWith('http') ? 'external' : 'mp4',
                                url: episode.media.sourceUrl,
                                durationSeconds: episode.media.durationSeconds
                        }
                });
        }

        if (!episode.media.providerAssetId) {
                return json({ success: false, error: 'Stream media is missing provider asset id' }, { status: 409 });
        }

        const runtimeEnv = resolveRuntimeEnv(
                (platform as { env?: Record<string, string | undefined> } | undefined)?.env
        );
        if (episode.media.playbackPolicy === 'public') {
                return json({
                        success: true,
                        data: {
                                episodeId: episode.id,
                                provider: episode.media.provider,
                                playbackType: 'hls',
                                url: buildPublicHlsUrl(episode.media.providerAssetId),
                                durationSeconds: episode.media.durationSeconds
                        }
                });
        }

        const expiresAt = Math.floor(Date.now() / 1000) + getPlaybackTokenTtlSeconds(runtimeEnv);
        const token = await createStreamPlaybackToken(runtimeEnv, episode.media.providerAssetId, expiresAt);

        return json({
                success: true,
                data: {
                        episodeId: episode.id,
                        provider: episode.media.provider,
                        playbackType: 'hls',
                        url: buildSignedHlsUrl(token.token),
                        expiresAt: token.expiresAt,
                        durationSeconds: episode.media.durationSeconds
                }
        });
};
