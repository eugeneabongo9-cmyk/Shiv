import { redirect } from '@sveltejs/kit';
import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { countActivePaidMembers, listCourses } from '$lib/server/db/shivworks';
import {
        getActiveBronzeTier,
        VIP_TIER,
        LAUNCH_MEMBER_COUNT_FLOOR,
        LAUNCH_VIP_COUNT_FLOOR
} from '$lib/constants/pricing';

export const load: PageServerLoad = async ({ locals, platform }) => {
        // Marketing landing must always render in mock/preview mode so reviewers
        // can see the same page production visitors see. Real authenticated
        // visitors are still bounced into /dashboard.
        if (locals.authMode !== 'mock' && locals.user?.accessStatus === 'active') {
                redirect(302, '/dashboard');
        }

        const db = getDBFromPlatform(platform);
        const [memberCounts, courses] = await Promise.all([
                countActivePaidMembers(db),
                listCourses(db)
        ]);

        // Live WordPress/WooCommerce sync is paused — counts are sourced from
        // the manual floors in pricing.ts until the WP side is accurate. To
        // re-enable, restore the call to getWoocommerceProductSoldCount() and
        // fold its value into combinedBronzeCount.
        const effectiveBronzeCount = Math.max(memberCounts.bronze, LAUNCH_MEMBER_COUNT_FLOOR);
        const effectiveVipCount = Math.max(memberCounts.vip, LAUNCH_VIP_COUNT_FLOOR);
        const activeTierInfo = getActiveBronzeTier(effectiveBronzeCount);
        const effectiveMemberCounts = {
                ...memberCounts,
                bronze: effectiveBronzeCount,
                vip: effectiveVipCount
        };
        const vipSpotsRemaining = Math.max(0, VIP_TIER.totalSpots - effectiveVipCount);

        return {
                user: locals.user,
                courses,
                activeTierInfo,
                memberCounts: effectiveMemberCounts,
                vipSpotsRemaining
        };
};
