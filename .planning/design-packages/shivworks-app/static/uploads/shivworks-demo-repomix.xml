<file path="src/lib/server/community-presenter.ts">
import type { D1Compat } from '$lib/server/d1-compat';
import {
        listMembersByClerkUserIds,
        listMessageReactionsForMessages,
        listMessageAttachmentsForMessages,
        listRecognitionsForMessages,
        countThreadRepliesForMessages,
        type ChannelRecord,
        type MemberRecord,
        type MessageRecord,
        type MessageAttachmentRecord,
        type MessageReactionRecord,
        type RecognitionRecord
} from '$lib/server/db/shivworks';
import { getMemberTotalTpMap, resolveRank, type RankCode } from '$lib/server/gamification';
import { REACTION_KEYS, type ReactionKey } from '$lib/server/community-access';

export interface AuthorDisplay {
        clerkUserId: string;
        name: string;
        tier: MemberRecord['tier'];
        role: MemberRecord['role'];
        rank: { code: RankCode; label: string };
        initials: string;
}

export interface PresentedReactionGroup {
        emojiKey: ReactionKey;
        count: number;
        viewerHasReacted: boolean;
}

export interface PresentedMessage {
        id: string;
        channelId: string;
        body: string;
        pinned: boolean;
        createdAt: number;
        editedAt: number | null;
        author: AuthorDisplay;
        reactions: PresentedReactionGroup[];
        attachments: MessageAttachmentRecord[];
        threadReplyCount: number;
        recognitionCount: number;
        viewerRecognized: boolean;
        canEdit: boolean;
        canDelete: boolean;
}

function initialsFor(name: string): string {
        const parts = name.trim().split(/\s+/).filter(Boolean);
        if (parts.length === 0) return 'M';
        if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

export async function buildAuthorDirectory(
        db: D1Compat,
        clerkUserIds: string[]
): Promise<Map<string, AuthorDisplay>> {
        const members = await listMembersByClerkUserIds(db, clerkUserIds);
        const tpMap = await getMemberTotalTpMap(
                db,
                members.map((m) => m.clerkUserId)
        );
        const out = new Map<string, AuthorDisplay>();
        for (const m of members) {
                const rank = resolveRank(tpMap.get(m.clerkUserId) ?? 0);
                out.set(m.clerkUserId, {
                        clerkUserId: m.clerkUserId,
                        name: m.name,
                        tier: m.tier,
                        role: m.role,
                        rank: { code: rank.code, label: rank.label },
                        initials: initialsFor(m.name)
                });
        }
        // Fill in placeholders for any IDs without member rows (deleted users etc).
        for (const id of new Set(clerkUserIds)) {
                if (!out.has(id)) {
                        out.set(id, {
                                clerkUserId: id,
                                name: 'Former member',
                                tier: null,
                                role: 'member',
                                rank: { code: 'unknown_contact', label: 'Unknown Contact' },
                                initials: 'FM'
                        });
                }
        }
        return out;
}

/**
 * Stable reorder so pinned messages float above unpinned ones, preserving
 * the input order within each bucket. Used to surface the weekly question
 * (and any other admin-pinned post) at the top of its channel.
 */
export function sortPinnedFirst<T extends { pinned: boolean }>(messages: T[]): T[] {
        const pinned = messages.filter((m) => m.pinned);
        const rest = messages.filter((m) => !m.pinned);
        return [...pinned, ...rest];
}

export function groupReactions(
        rows: Array<{ memberId: string; emojiKey: string }>,
        viewerId: string
): PresentedReactionGroup[] {
        return REACTION_KEYS.map((key) => {
                const matches = rows.filter((r) => r.emojiKey === key);
                return {
                        emojiKey: key,
                        count: matches.length,
                        viewerHasReacted: matches.some((r) => r.memberId === viewerId)
                };
        });
}

export async function presentMessages(
        db: D1Compat,
        messages: MessageRecord[],
        viewer: MemberRecord
): Promise<PresentedMessage[]> {
        if (messages.length === 0) return [];
        const messageIds = messages.map((m) => m.id);
        const [directory, allReactions, allAttachments, allRecognitions, replyCounts] =
                await Promise.all([
                        buildAuthorDirectory(
                                db,
                                messages.map((m) => m.authorId)
                        ),
                        listMessageReactionsForMessages(db, messageIds),
                        listMessageAttachmentsForMessages(db, messageIds),
                        listRecognitionsForMessages(db, messageIds),
                        countThreadRepliesForMessages(db, messageIds)
                ]);

        const reactionsByMsg = new Map<string, MessageReactionRecord[]>();
        for (const r of allReactions) {
                const list = reactionsByMsg.get(r.messageId) ?? [];
                list.push(r);
                reactionsByMsg.set(r.messageId, list);
        }
        const attachmentsByMsg = new Map<string, MessageAttachmentRecord[]>();
        for (const a of allAttachments) {
                const list = attachmentsByMsg.get(a.messageId) ?? [];
                list.push(a);
                attachmentsByMsg.set(a.messageId, list);
        }
        const recognitionsByMsg = new Map<string, RecognitionRecord[]>();
        for (const rec of allRecognitions) {
                const list = recognitionsByMsg.get(rec.messageId) ?? [];
                list.push(rec);
                recognitionsByMsg.set(rec.messageId, list);
        }

        const isAdmin = viewer.role === 'admin';
        // Day-scoped check: brief allows one recognition per giver per post per
        // UTC day, so we only treat the viewer as "already recognized" if their
        // recognition row was created today (UTC).
        const todayUtc = new Date().toISOString().slice(0, 10);
        return messages.map((msg) => {
                const reactions = reactionsByMsg.get(msg.id) ?? [];
                const attachments = attachmentsByMsg.get(msg.id) ?? [];
                const recognitions = recognitionsByMsg.get(msg.id) ?? [];
                const author =
                        directory.get(msg.authorId) ?? {
                                clerkUserId: msg.authorId,
                                name: 'Former member',
                                tier: null,
                                role: 'member' as const,
                                rank: { code: 'unknown_contact' as const, label: 'Unknown Contact' },
                                initials: 'FM'
                        };
                return {
                        id: msg.id,
                        channelId: msg.channelId,
                        body: msg.body,
                        pinned: msg.pinned,
                        createdAt: msg.createdAt,
                        editedAt: msg.editedAt,
                        author,
                        reactions: groupReactions(reactions, viewer.clerkUserId),
                        attachments,
                        threadReplyCount: replyCounts.get(msg.id) ?? 0,
                        recognitionCount: recognitions.length,
                        viewerRecognized: recognitions.some(
                                (r) =>
                                        r.giverId === viewer.clerkUserId &&
                                        new Date(r.createdAt).toISOString().slice(0, 10) === todayUtc
                        ),
                        canEdit: msg.authorId === viewer.clerkUserId,
                        canDelete: isAdmin || msg.authorId === viewer.clerkUserId
                } satisfies PresentedMessage;
        });
}

export interface OrderedChannelGroup {
        category: ChannelRecord['category'];
        label: string;
        channels: Array<ChannelRecord & { canPostTopLevel: boolean; canPostReply: boolean }>;
}

const CATEGORY_LABELS: Record<ChannelRecord['category'], string> = {
        general: 'GENERAL',
        training: 'TRAINING',
        gear: 'GEAR',
        training_partners: 'TRAINING PARTNERS',
        vip: 'VIP'
};

const CATEGORY_ORDER: ChannelRecord['category'][] = [
        'general',
        'training',
        'gear',
        'training_partners',
        'vip'
];

/**
 * Re-sort channels per the v2.2 brief override: in TRAINING category,
 * weekly-question must appear second (right after #ecqc).
 */
export function reorderChannelsForBrief(
        channels: Array<ChannelRecord & { canPostTopLevel?: boolean; canPostReply?: boolean }>
): OrderedChannelGroup[] {
        const byCat = new Map<ChannelRecord['category'], typeof channels>();
        for (const cat of CATEGORY_ORDER) byCat.set(cat, []);
        for (const ch of channels) {
                byCat.get(ch.category)?.push(ch);
        }
        const groups: OrderedChannelGroup[] = [];
        for (const cat of CATEGORY_ORDER) {
                const list = (byCat.get(cat) ?? []).slice().sort((a, b) => a.channelSort - b.channelSort);
                if (cat === 'training') {
                        const wq = list.find((c) => c.slug === 'weekly-question');
                        if (wq) {
                                const rest = list.filter((c) => c.slug !== 'weekly-question');
                                rest.splice(1, 0, wq);
                                list.length = 0;
                                list.push(...rest);
                        }
                }
                if (list.length === 0) continue;
                groups.push({
                        category: cat,
                        label: CATEGORY_LABELS[cat],
                        channels: list.map((c) => ({
                                ...c,
                                canPostTopLevel: c.canPostTopLevel ?? true,
                                canPostReply: c.canPostReply ?? true
                        }))
                });
        }
        return groups;
}
