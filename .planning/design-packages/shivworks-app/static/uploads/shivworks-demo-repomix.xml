import type { D1Compat } from '$lib/server/d1-compat';
import type { MembershipTier } from '$lib/constants/tiers';

// ---------------------------------------------------------------------------
// Types & canonical tables
// ---------------------------------------------------------------------------

export type TrainingAction =
        | 'module_complete'
        | 'course_complete'
        | 'roadshow_episode_watch'
        | 'live_session_rsvp'
        | 'live_session_attend'
        | 'intro_post'
        | 'community_post'
        | 'community_reply'
        | 'aar_post'
        | 'profile_complete'
        | 'streak_7day_bonus'
        | 'streak_30day_bonus'
        | 'recognition_received'
        | 'onboarding_checklist_complete';

/** Canonical TP table from the brief Section A. */
export const TP_VALUES: Record<TrainingAction, number> = {
        module_complete: 10,
        course_complete: 75,
        roadshow_episode_watch: 15,
        live_session_rsvp: 5,
        live_session_attend: 50,
        intro_post: 25,
        community_post: 5,
        community_reply: 5,
        aar_post: 30,
        profile_complete: 20,
        streak_7day_bonus: 25,
        streak_30day_bonus: 100,
        recognition_received: 10,
        onboarding_checklist_complete: 50
};

/** Per-day TP cap for actions that have one (Section A). */
export const DAILY_CAPS: Partial<Record<TrainingAction, number>> = {
        community_post: 20,
        community_reply: 15
};

/** Actions that should only ever award once per (member, action). */
export const ONE_TIME_ACTIONS: ReadonlySet<TrainingAction> = new Set([
        'intro_post',
        'profile_complete',
        'streak_7day_bonus',
        'streak_30day_bonus',
        'onboarding_checklist_complete'
]);

/** Rank thresholds from the brief Section B. */
export type RankCode =
        | 'unknown_contact'
        | 'practitioner'
        | 'trained_practitioner'
        | 'pressure_tested'
        | 'collective';

export interface RankDef {
        code: RankCode;
        label: string;
        minTp: number;
        maxTp: number | null;
}

export const RANKS: readonly RankDef[] = [
        { code: 'unknown_contact', label: 'Unknown Contact', minTp: 0, maxTp: 99 },
        { code: 'practitioner', label: 'Practitioner', minTp: 100, maxTp: 499 },
        { code: 'trained_practitioner', label: 'Trained Practitioner', minTp: 500, maxTp: 1499 },
        { code: 'pressure_tested', label: 'Pressure Tested', minTp: 1500, maxTp: 3999 },
        { code: 'collective', label: 'Collective', minTp: 4000, maxTp: null }
];

/** Milestone catalog from the brief Section D. */
export type MilestoneKey =
        | 'first_module_completed'
        | 'first_course_completed'
        | 'five_courses_completed'
        | 'full_library'
        | 'first_live_session'
        | 'introduced'
        | 'first_aar'
        | 'ten_community_posts'
        | 'streak_7_day'
        | 'streak_30_day'
        | 'founding_member'
        | 'vip_founding_member'
        | 'ready';

export interface MilestoneDef {
        key: MilestoneKey;
        label: string;
        category: 'training' | 'live' | 'community' | 'consistency' | 'membership';
}

export const MILESTONES: readonly MilestoneDef[] = [
        { key: 'first_module_completed', label: 'First Module Completed', category: 'training' },
        { key: 'first_course_completed', label: 'First Course Completed', category: 'training' },
        { key: 'five_courses_completed', label: 'Five Courses Completed', category: 'training' },
        { key: 'full_library', label: 'Full Library', category: 'training' },
        { key: 'first_live_session', label: 'First Live Session', category: 'live' },
        { key: 'introduced', label: 'Introduced', category: 'community' },
        { key: 'first_aar', label: 'First After-Action Report', category: 'community' },
        { key: 'ten_community_posts', label: 'Ten Community Posts', category: 'community' },
        { key: 'streak_7_day', label: '7-Day Streak', category: 'consistency' },
        { key: 'streak_30_day', label: '30-Day Streak', category: 'consistency' },
        { key: 'founding_member', label: 'Founding Member', category: 'membership' },
        { key: 'vip_founding_member', label: 'VIP Founding Member', category: 'membership' },
        { key: 'ready', label: 'Ready', category: 'membership' }
];

// ---------------------------------------------------------------------------
// Rank helpers
// ---------------------------------------------------------------------------

export function resolveRank(totalTp: number): RankDef {
        const tp = Math.max(0, Math.floor(totalTp));
        for (let i = RANKS.length - 1; i >= 0; i--) {
                if (tp >= RANKS[i].minTp) return RANKS[i];
        }
        return RANKS[0];
}

export interface RankProgress {
        rank: RankDef;
        nextRank: RankDef | null;
        totalTp: number;
        tpIntoRank: number;
        tpToNextRank: number | null;
        progressPct: number;
}

export function getRankProgress(totalTp: number): RankProgress {
        const tp = Math.max(0, Math.floor(totalTp));
        const rank = resolveRank(tp);
        const idx = RANKS.findIndex((r) => r.code === rank.code);
        const next = idx >= 0 && idx < RANKS.length - 1 ? RANKS[idx + 1] : null;
        const tpIntoRank = tp - rank.minTp;
        const tpToNext = next ? next.minTp - tp : null;
        const span = next ? next.minTp - rank.minTp : 1;
        const progressPct = next ? Math.max(0, Math.min(100, Math.round((tpIntoRank / span) * 100))) : 100;
        return {
                rank,
                nextRank: next,
                totalTp: tp,
                tpIntoRank,
                tpToNextRank: tpToNext,
                progressPct
        };
}

// ---------------------------------------------------------------------------
// Date helpers (UTC)
// ---------------------------------------------------------------------------

export function utcDateKey(date: Date | number): string {
        const d = typeof date === 'number' ? new Date(date) : date;
        return d.toISOString().slice(0, 10); // YYYY-MM-DD
}

function startOfUtcDay(dateKey: string): number {
        return Date.parse(`${dateKey}T00:00:00.000Z`);
}

function endOfUtcDay(dateKey: string): number {
        return startOfUtcDay(dateKey) + 24 * 60 * 60 * 1000 - 1;
}

function startOfUtcMonth(now: Date): number {
        return Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1);
}

function previousDateKey(dateKey: string): string {
        const t = startOfUtcDay(dateKey) - 24 * 60 * 60 * 1000;
        return new Date(t).toISOString().slice(0, 10);
}

// ---------------------------------------------------------------------------
// Award pipeline
// ---------------------------------------------------------------------------

export interface AwardInput {
        memberId: string;
        action: TrainingAction;
        referenceType?: string | null;
        referenceId?: string | null;
        /** Override timestamp for testing or backfill. Defaults to Date.now(). */
        occurredAt?: number;
}

export interface AwardResult {
        awarded: number;
        reason: 'awarded' | 'duplicate' | 'capped';
        totalTp: number;
        rank: RankDef;
        rankChanged: boolean;
        previousRank: RankDef;
        newMilestones: MilestoneKey[];
        streak: {
                current: number;
                longest: number;
                hitMilestone: 7 | 30 | null;
        };
}

interface StreakRow {
        current_streak: number;
        longest_streak: number;
        last_active_date: string | null;
}

async function getStreakRow(db: D1Compat, memberId: string): Promise<StreakRow> {
        const row = await db
                .prepare(
                        'SELECT current_streak, longest_streak, last_active_date FROM member_streaks WHERE member_id = ?'
                )
                .bind(memberId)
                .first<Record<string, unknown>>();
        if (!row) {
                return { current_streak: 0, longest_streak: 0, last_active_date: null };
        }
        return {
                current_streak: Number(row.current_streak || 0),
                longest_streak: Number(row.longest_streak || 0),
                last_active_date: row.last_active_date ? String(row.last_active_date) : null
        };
}

async function upsertStreak(
        db: D1Compat,
        memberId: string,
        next: StreakRow,
        nowMs: number
): Promise<void> {
        await db
                .prepare(
                        `INSERT INTO member_streaks (member_id, current_streak, longest_streak, last_active_date, updated_at)
                         VALUES (?, ?, ?, ?, ?)
                         ON CONFLICT(member_id) DO UPDATE SET
                                current_streak = excluded.current_streak,
                                longest_streak = excluded.longest_streak,
                                last_active_date = excluded.last_active_date,
                                updated_at = excluded.updated_at`
                )
                .bind(
                        memberId,
                        next.current_streak,
                        next.longest_streak,
                        next.last_active_date,
                        nowMs
                )
                .run();
}

async function getTotalTp(db: D1Compat, memberId: string): Promise<number> {
        const row = await db
                .prepare(
                        'SELECT COALESCE(SUM(points_awarded), 0) AS total FROM member_training_points WHERE member_id = ?'
                )
                .bind(memberId)
                .first<{ total: number | string }>();
        return Number(row?.total || 0);
}

export async function getMemberTotalTp(db: D1Compat, memberId: string): Promise<number> {
        return getTotalTp(db, memberId);
}

export async function getMemberTotalTpMap(
        db: D1Compat,
        memberIds: string[]
): Promise<Map<string, number>> {
        const out = new Map<string, number>();
        if (memberIds.length === 0) return out;
        const unique = Array.from(new Set(memberIds));
        const placeholders = unique.map(() => '?').join(',');
        const rows = await db
                .prepare(
                        `SELECT member_id, COALESCE(SUM(points_awarded), 0) AS total
                         FROM member_training_points
                         WHERE member_id IN (${placeholders})
                         GROUP BY member_id`
                )
                .bind(...unique)
                .all<{ member_id: string; total: number | string }>();
        for (const id of unique) out.set(id, 0);
        for (const r of rows.results) out.set(String(r.member_id), Number(r.total || 0));
        return out;
}

async function getDailyAwarded(
        db: D1Compat,
        memberId: string,
        action: TrainingAction,
        dateKey: string
): Promise<number> {
        const row = await db
                .prepare(
                        `SELECT COALESCE(SUM(points_awarded), 0) AS total
                         FROM member_training_points
                         WHERE member_id = ? AND action_type = ? AND created_at BETWEEN ? AND ?`
                )
                .bind(memberId, action, startOfUtcDay(dateKey), endOfUtcDay(dateKey))
                .first<{ total: number | string }>();
        return Number(row?.total || 0);
}

async function existsRefAward(
        db: D1Compat,
        memberId: string,
        action: TrainingAction,
        referenceType: string | null,
        referenceId: string | null
): Promise<boolean> {
        const row = await db
                .prepare(
                        `SELECT 1 AS one
                         FROM member_training_points
                         WHERE member_id = ?
                                AND action_type = ?
                                AND COALESCE(reference_type, '') = COALESCE(?, '')
                                AND COALESCE(reference_id, '') = COALESCE(?, '')
                         LIMIT 1`
                )
                .bind(memberId, action, referenceType, referenceId)
                .first<{ one: number }>();
        return !!row;
}

async function existsAnyAwardForAction(
        db: D1Compat,
        memberId: string,
        action: TrainingAction
): Promise<boolean> {
        const row = await db
                .prepare(
                        `SELECT 1 AS one
                         FROM member_training_points
                         WHERE member_id = ? AND action_type = ?
                         LIMIT 1`
                )
                .bind(memberId, action)
                .first<{ one: number }>();
        return !!row;
}

async function insertTpRow(
        db: D1Compat,
        memberId: string,
        action: TrainingAction,
        points: number,
        referenceType: string | null,
        referenceId: string | null,
        nowMs: number
): Promise<boolean> {
        try {
                await db
                        .prepare(
                                `INSERT INTO member_training_points (id, member_id, action_type, points_awarded, reference_type, reference_id, created_at)
                                 VALUES (?, ?, ?, ?, ?, ?, ?)`
                        )
                        .bind(
                                crypto.randomUUID(),
                                memberId,
                                action,
                                points,
                                referenceType,
                                referenceId,
                                nowMs
                        )
                        .run();
                return true;
        } catch (err) {
                // Hit the uq_training_points_one_time index → idempotent dedupe.
                const message = err instanceof Error ? err.message : String(err);
                if (/UNIQUE|duplicate key/i.test(message)) {
                        return false;
                }
                throw err;
        }
}

/**
 * Award Training Points to a member. Idempotent: re-awarding the same
 * (member, action, referenceType, referenceId) tuple is a no-op.
 *
 * Other surfaces (community posting, module completion, RSVP, attendance,
 * peer recognition) call this — they never write to the TP tables directly.
 */
export async function awardPoints(db: D1Compat, input: AwardInput): Promise<AwardResult> {
        const memberId = input.memberId;
        const action = input.action;
        const isOneTime = ONE_TIME_ACTIONS.has(action);
        // Per-member one-time actions (intro_post, profile_complete, streak
        // bonuses) ignore caller-supplied references and always store NULL refs
        // so the schema's COALESCE-based unique index enforces single-award
        // semantics regardless of what callsites pass.
        const referenceType = isOneTime ? null : input.referenceType ?? null;
        const referenceId = isOneTime ? null : input.referenceId ?? null;
        const nowMs = input.occurredAt ?? Date.now();
        const todayKey = utcDateKey(nowMs);
        const baseValue = TP_VALUES[action];

        const previousTotal = await getTotalTp(db, memberId);
        const previousRank = resolveRank(previousTotal);

        // 1) One-time event dedupe — true one-time per (member, action),
        //    independent of any reference fields.
        if (isOneTime) {
                const exists = await existsAnyAwardForAction(db, memberId, action);
                if (exists) {
                        return {
                                awarded: 0,
                                reason: 'duplicate',
                                totalTp: previousTotal,
                                rank: previousRank,
                                rankChanged: false,
                                previousRank,
                                newMilestones: [],
                                streak: await readStreakSummary(db, memberId)
                        };
                }
        }

        // 2) Reference-bound dedupe — any (action + referenceId) pair only counts once.
        if (referenceId) {
                const exists = await existsRefAward(db, memberId, action, referenceType, referenceId);
                if (exists) {
                        return {
                                awarded: 0,
                                reason: 'duplicate',
                                totalTp: previousTotal,
                                rank: previousRank,
                                rankChanged: false,
                                previousRank,
                                newMilestones: [],
                                streak: await readStreakSummary(db, memberId)
                        };
                }
        }

        // 3) Daily caps.
        let pointsToAward = baseValue;
        const cap = DAILY_CAPS[action];
        if (typeof cap === 'number') {
                const awardedToday = await getDailyAwarded(db, memberId, action, todayKey);
                const remaining = Math.max(0, cap - awardedToday);
                pointsToAward = Math.min(baseValue, remaining);
                if (pointsToAward <= 0) {
                        return {
                                awarded: 0,
                                reason: 'capped',
                                totalTp: previousTotal,
                                rank: previousRank,
                                rankChanged: false,
                                previousRank,
                                newMilestones: [],
                                streak: await readStreakSummary(db, memberId)
                        };
                }
        }

        // 4) Insert TP row (idempotent at the DB layer).
        const inserted = await insertTpRow(
                db,
                memberId,
                action,
                pointsToAward,
                referenceType,
                referenceId,
                nowMs
        );
        if (!inserted) {
                return {
                        awarded: 0,
                        reason: 'duplicate',
                        totalTp: previousTotal,
                        rank: previousRank,
                        rankChanged: false,
                        previousRank,
                        newMilestones: [],
                        streak: await readStreakSummary(db, memberId)
                };
        }

        // 5) Streak update (skip for streak bonuses themselves to avoid recursion).
        const isStreakBonus =
                action === 'streak_7day_bonus' || action === 'streak_30day_bonus';
        let streakSummary = await readStreakSummary(db, memberId);
        let bonusEarnedMilestones: MilestoneKey[] = [];
        if (!isStreakBonus) {
                const updated = await tickStreak(db, memberId, todayKey, nowMs);
                streakSummary = { current: updated.current_streak, longest: updated.longest_streak, hitMilestone: null };
                const bonus = await applyStreakBonuses(db, memberId, updated.current_streak, nowMs);
                if (bonus.hitMilestone) streakSummary.hitMilestone = bonus.hitMilestone;
                bonusEarnedMilestones = bonus.newMilestones;
        }

        // 6) Recompute totals and milestones.
        const totalTp = await getTotalTp(db, memberId);
        const rank = resolveRank(totalTp);
        const evaluated = await evaluateMilestones(db, memberId, nowMs);
        const newMilestones = Array.from(new Set([...bonusEarnedMilestones, ...evaluated]));

        return {
                awarded: pointsToAward,
                reason: 'awarded',
                totalTp,
                rank,
                rankChanged: rank.code !== previousRank.code,
                previousRank,
                newMilestones,
                streak: streakSummary
        };
}

async function readStreakSummary(
        db: D1Compat,
        memberId: string
): Promise<AwardResult['streak']> {
        const row = await getStreakRow(db, memberId);
        return {
                current: row.current_streak,
                longest: row.longest_streak,
                hitMilestone: null
        };
}

/**
 * Compute the streak as the member should *see* it right now. The persisted
 * `current_streak` only resets on the next award event — but the brief
 * (Section C) requires that missing a day visibly resets the streak to 0.
 * For any read surface (dossier, dashboard) we collapse stale streaks here.
 */
export function effectiveCurrentStreak(
        lastActiveDate: string | null,
        persistedStreak: number,
        now: Date | number = Date.now()
): number {
        if (!lastActiveDate || persistedStreak <= 0) return 0;
        const todayKey = utcDateKey(now);
        if (lastActiveDate === todayKey) return persistedStreak;
        if (lastActiveDate === previousDateKey(todayKey)) return persistedStreak;
        return 0;
}

async function tickStreak(
        db: D1Compat,
        memberId: string,
        todayKey: string,
        nowMs: number
): Promise<StreakRow> {
        const current = await getStreakRow(db, memberId);

        let next: StreakRow;
        if (current.last_active_date === todayKey) {
                next = current;
        } else if (current.last_active_date === previousDateKey(todayKey)) {
                next = {
                        current_streak: current.current_streak + 1,
                        longest_streak: Math.max(current.longest_streak, current.current_streak + 1),
                        last_active_date: todayKey
                };
        } else {
                next = {
                        current_streak: 1,
                        longest_streak: Math.max(current.longest_streak, 1),
                        last_active_date: todayKey
                };
        }

        if (next !== current) {
                await upsertStreak(db, memberId, next, nowMs);
        }
        return next;
}

async function applyStreakBonuses(
        db: D1Compat,
        memberId: string,
        currentStreak: number,
        nowMs: number
): Promise<{ hitMilestone: 7 | 30 | null; newMilestones: MilestoneKey[] }> {
        const newMilestones: MilestoneKey[] = [];
        let hit: 7 | 30 | null = null;
        if (currentStreak === 30) {
                const res = await awardPoints(db, {
                        memberId,
                        action: 'streak_30day_bonus',
                        occurredAt: nowMs
                });
                if (res.reason === 'awarded') hit = 30;
                newMilestones.push(...res.newMilestones);
        }
        if (currentStreak === 7) {
                const res = await awardPoints(db, {
                        memberId,
                        action: 'streak_7day_bonus',
                        occurredAt: nowMs
                });
                if (res.reason === 'awarded') hit = 7;
                newMilestones.push(...res.newMilestones);
        }
        return { hitMilestone: hit, newMilestones };
}

// ---------------------------------------------------------------------------
// Milestone evaluation
// ---------------------------------------------------------------------------

interface MilestoneCounts {
        moduleCompletes: number;
        courseCompletes: number;
        liveAttends: number;
        introPosts: number;
        aarPosts: number;
        communityPosts: number;
        currentStreak: number;
        longestStreak: number;
        bronzeEntitled: boolean;
        vipEntitled: boolean;
        onboardingChecklistComplete: boolean;
}

async function loadMilestoneCounts(db: D1Compat, memberId: string): Promise<MilestoneCounts> {
        const tpCounts = await db
                .prepare(
                        `SELECT action_type, COUNT(*) AS n
                         FROM member_training_points
                         WHERE member_id = ?
                         GROUP BY action_type`
                )
                .bind(memberId)
                .all<{ action_type: string; n: number | string }>();

        const byAction: Record<string, number> = {};
        for (const row of tpCounts.results) {
                byAction[row.action_type] = Number(row.n || 0);
        }

        const streak = await getStreakRow(db, memberId);

        const entitlementRows = await db
                .prepare(
                        `SELECT tier FROM member_entitlements WHERE member_id = ? AND status = 'active'`
                )
                .bind(memberId)
                .all<{ tier: string }>();

        const tiers = new Set(entitlementRows.results.map((r) => String(r.tier)));

        return {
                moduleCompletes: byAction.module_complete || 0,
                courseCompletes: byAction.course_complete || 0,
                liveAttends: byAction.live_session_attend || 0,
                introPosts: byAction.intro_post || 0,
                aarPosts: byAction.aar_post || 0,
                communityPosts: byAction.community_post || 0,
                currentStreak: streak.current_streak,
                longestStreak: streak.longest_streak,
                bronzeEntitled: tiers.has('bronze'),
                vipEntitled: tiers.has('vip'),
                onboardingChecklistComplete: (byAction.onboarding_checklist_complete || 0) >= 1
        };
}

function shouldEarn(key: MilestoneKey, c: MilestoneCounts): boolean {
        switch (key) {
                case 'first_module_completed':
                        return c.moduleCompletes >= 1;
                case 'first_course_completed':
                        return c.courseCompletes >= 1;
                case 'five_courses_completed':
                        return c.courseCompletes >= 5;
                case 'full_library':
                        return c.courseCompletes >= 11;
                case 'first_live_session':
                        return c.liveAttends >= 1;
                case 'introduced':
                        return c.introPosts >= 1;
                case 'first_aar':
                        return c.aarPosts >= 1;
                case 'ten_community_posts':
                        // "Post 10 times total" across all post-style channels —
                        // includes #introductions and #after-action-reports, not
                        // just generic community_post events.
                        return c.communityPosts + c.introPosts + c.aarPosts >= 10;
                case 'streak_7_day':
                        return c.longestStreak >= 7;
                case 'streak_30_day':
                        return c.longestStreak >= 30;
                case 'founding_member':
                        return c.bronzeEntitled || c.vipEntitled;
                case 'vip_founding_member':
                        return c.vipEntitled;
                case 'ready':
                        return c.onboardingChecklistComplete;
        }
}

async function getEarnedMilestoneKeys(
        db: D1Compat,
        memberId: string
): Promise<Set<MilestoneKey>> {
        const rows = await db
                .prepare('SELECT milestone_key FROM member_milestones WHERE member_id = ?')
                .bind(memberId)
                .all<{ milestone_key: string }>();
        return new Set(rows.results.map((r) => r.milestone_key as MilestoneKey));
}

/**
 * Evaluate every milestone for the member, inserting any newly-earned ones.
 * Returns the keys that were newly inserted by this call.
 */
export async function evaluateMilestones(
        db: D1Compat,
        memberId: string,
        nowMs: number = Date.now()
): Promise<MilestoneKey[]> {
        const earned = await getEarnedMilestoneKeys(db, memberId);
        const counts = await loadMilestoneCounts(db, memberId);
        const newlyEarned: MilestoneKey[] = [];

        for (const def of MILESTONES) {
                if (earned.has(def.key)) continue;
                if (!shouldEarn(def.key, counts)) continue;

                try {
                        await db
                                .prepare(
                                        `INSERT INTO member_milestones (id, member_id, milestone_key, earned_at)
                                         VALUES (?, ?, ?, ?)`
                                )
                                .bind(crypto.randomUUID(), memberId, def.key, nowMs)
                                .run();
                        newlyEarned.push(def.key);
                } catch (err) {
                        const message = err instanceof Error ? err.message : String(err);
                        if (!/UNIQUE|duplicate key/i.test(message)) throw err;
                }
        }
        return newlyEarned;
}

/**
 * End-of-day streak rollover. Called on each authenticated request: if the
 * member missed a day, the persisted `current_streak` is reset to 0 so the
 * value on disk matches what the dossier displays. Safe to call repeatedly —
 * no-ops when the streak is already up to date or already zero.
 */
export async function rolloverStreakIfStale(
        db: D1Compat,
        memberId: string,
        now: Date | number = Date.now()
): Promise<{ reset: boolean; current: number }> {
        const row = await getStreakRow(db, memberId);
        if (row.current_streak <= 0 || !row.last_active_date) {
                return { reset: false, current: 0 };
        }
        const todayKey = utcDateKey(now);
        if (row.last_active_date === todayKey || row.last_active_date === previousDateKey(todayKey)) {
                return { reset: false, current: row.current_streak };
        }
        await upsertStreak(
                db,
                memberId,
                {
                        current_streak: 0,
                        longest_streak: row.longest_streak,
                        last_active_date: row.last_active_date
                },
                typeof now === 'number' ? now : now.getTime()
        );
        return { reset: true, current: 0 };
}

/**
 * Auto-apply Founding Member / VIP Founding Member milestones for any member
 * whose entitlement matches. Safe to call on every authenticated load — it
 * is idempotent.
 */
export async function applyEntitlementMilestones(
        db: D1Compat,
        memberId: string,
        tier: MembershipTier | null
): Promise<MilestoneKey[]> {
        if (tier !== 'bronze' && tier !== 'vip') return [];
        return evaluateMilestones(db, memberId);
}

// ---------------------------------------------------------------------------
// Read APIs
// ---------------------------------------------------------------------------

export interface DossierMilestone {
        key: MilestoneKey;
        label: string;
        category: MilestoneDef['category'];
        earnedAt: number | null;
}

export interface DossierActivityEntry {
        id: string;
        action: TrainingAction;
        points: number;
        referenceType: string | null;
        referenceId: string | null;
        createdAt: number;
}

export interface MemberDossier {
        memberId: string;
        totalTp: number;
        rank: RankProgress;
        streak: {
                current: number;
                longest: number;
                lastActiveDate: string | null;
        };
        milestones: DossierMilestone[];
        recentActivity: DossierActivityEntry[];
        recognitionCount: number;
}

export async function getMemberDossier(
        db: D1Compat,
        memberId: string,
        options: {
                activityLimit?: number;
                /** Default 30 days. Pass null to disable date windowing. */
                activityWindowDays?: number | null;
                now?: Date | number;
        } = {}
): Promise<MemberDossier> {
        const nowMs = typeof options.now === 'number'
                ? options.now
                : options.now instanceof Date
                        ? options.now.getTime()
                        : Date.now();
        const totalTp = await getTotalTp(db, memberId);
        const rank = getRankProgress(totalTp);
        const streakRow = await getStreakRow(db, memberId);
        const effectiveCurrent = effectiveCurrentStreak(
                streakRow.last_active_date,
                streakRow.current_streak,
                nowMs
        );

        const earnedRows = await db
                .prepare(
                        'SELECT milestone_key, earned_at FROM member_milestones WHERE member_id = ?'
                )
                .bind(memberId)
                .all<{ milestone_key: string; earned_at: number | string }>();

        const earnedMap = new Map<string, number>();
        for (const row of earnedRows.results) {
                earnedMap.set(row.milestone_key, Number(row.earned_at));
        }

        const milestones: DossierMilestone[] = MILESTONES.map((def) => ({
                key: def.key,
                label: def.label,
                category: def.category,
                earnedAt: earnedMap.has(def.key) ? earnedMap.get(def.key) ?? null : null
        }));

        const limit = Math.max(1, Math.min(200, options.activityLimit ?? 50));
        const windowDays = options.activityWindowDays === undefined ? 30 : options.activityWindowDays;
        let activityRows;
        if (windowDays === null) {
                activityRows = await db
                        .prepare(
                                `SELECT id, action_type, points_awarded, reference_type, reference_id, created_at
                                 FROM member_training_points
                                 WHERE member_id = ?
                                 ORDER BY created_at DESC
                                 LIMIT ?`
                        )
                        .bind(memberId, limit)
                        .all<Record<string, unknown>>();
        } else {
                const sinceMs = nowMs - Math.max(1, windowDays) * 86400000;
                activityRows = await db
                        .prepare(
                                `SELECT id, action_type, points_awarded, reference_type, reference_id, created_at
                                 FROM member_training_points
                                 WHERE member_id = ? AND created_at >= ?
                                 ORDER BY created_at DESC
                                 LIMIT ?`
                        )
                        .bind(memberId, sinceMs, limit)
                        .all<Record<string, unknown>>();
        }

        const recentActivity: DossierActivityEntry[] = activityRows.results.map((row) => ({
                id: String(row.id),
                action: String(row.action_type) as TrainingAction,
                points: Number(row.points_awarded || 0),
                referenceType: row.reference_type ? String(row.reference_type) : null,
                referenceId: row.reference_id ? String(row.reference_id) : null,
                createdAt: Number(row.created_at || 0)
        }));

        const recognitionRow = await db
                .prepare('SELECT COUNT(*) AS n FROM recognitions WHERE recipient_id = ?')
                .bind(memberId)
                .first<{ n: number | string }>();
        const recognitionCount = Number(recognitionRow?.n || 0);

        return {
                memberId,
                totalTp,
                rank,
                streak: {
                        current: effectiveCurrent,
                        longest: streakRow.longest_streak,
                        lastActiveDate: streakRow.last_active_date
                },
                milestones,
                recentActivity,
                recognitionCount
        };
}

export interface LeaderboardEntry {
        memberId: string;
        name: string;
        rank: RankDef;
        totalTp: number;
        position: number;
        isViewer: boolean;
}

export interface LeaderboardOptions {
        scope: 'all_time' | 'monthly';
        limit?: number;
        viewerId?: string | null;
        now?: Date;
}

export interface LeaderboardResult {
        entries: LeaderboardEntry[];
        viewer: LeaderboardEntry | null;
}

/**
 * Leaderboard read. Only returns members who have explicitly opted in via
 * leaderboard_opt_in.show_on_leaderboard = 1. The viewer entry is returned
 * separately so the UI can highlight them even when they fall outside the
 * top N.
 */
export async function getLeaderboard(
        db: D1Compat,
        options: LeaderboardOptions
): Promise<LeaderboardResult> {
        const limit = Math.max(1, Math.min(100, options.limit ?? 25));
        const now = options.now ?? new Date();

        const sumExpression =
                options.scope === 'monthly'
                        ? `COALESCE(SUM(CASE WHEN tp.created_at >= ? THEN tp.points_awarded ELSE 0 END), 0)`
                        : `COALESCE(SUM(tp.points_awarded), 0)`;

        const params: unknown[] = [];
        if (options.scope === 'monthly') params.push(startOfUtcMonth(now));

        const sql = `
                SELECT m.clerk_user_id AS member_id,
                       COALESCE(m.name, 'Member') AS name,
                       ${sumExpression} AS total_tp
                FROM members m
                INNER JOIN leaderboard_opt_in lo ON lo.member_id = m.clerk_user_id AND lo.show_on_leaderboard = 1
                LEFT JOIN member_training_points tp ON tp.member_id = m.clerk_user_id
                GROUP BY m.clerk_user_id, m.name
                ORDER BY total_tp DESC, m.name ASC
        `;

        const all = await db
                .prepare(sql)
                .bind(...params)
                .all<{ member_id: string; name: string; total_tp: number | string }>();

        const ranked: LeaderboardEntry[] = all.results.map((row, index) => {
                const total = Number(row.total_tp || 0);
                return {
                        memberId: String(row.member_id),
                        name: String(row.name),
                        rank: resolveRank(total),
                        totalTp: total,
                        position: index + 1,
                        isViewer: !!options.viewerId && row.member_id === options.viewerId
                };
        });

        const entries = ranked.slice(0, limit);
        const viewer = options.viewerId
                ? ranked.find((r) => r.memberId === options.viewerId) ?? null
                : null;

        return { entries, viewer };
}

export async function setLeaderboardOptIn(
        db: D1Compat,
        memberId: string,
        showOnLeaderboard: boolean
): Promise<void> {
        const now = Date.now();
        await db
                .prepare(
                        `INSERT INTO leaderboard_opt_in (member_id, show_on_leaderboard, updated_at)
                         VALUES (?, ?, ?)
                         ON CONFLICT(member_id) DO UPDATE SET
                                show_on_leaderboard = excluded.show_on_leaderboard,
                                updated_at = excluded.updated_at`
                )
                .bind(memberId, showOnLeaderboard ? 1 : 0, now)
                .run();
}
