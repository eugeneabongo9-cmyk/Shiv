        grid-template-columns: minmax(320px, 0.92fr) minmax(0, 1.08fr);
        gap: 1.35rem;
        align-items: start;
}

.settings-overview {
        background: var(--surface-strong);
}

.settings-command-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.8rem;
        margin-top: 1.25rem;
}

.settings-command-grid > div,
.settings-embed-summary > div,
.settings-session-stat {
        padding: 0.95rem 1rem;
        border-radius: 1rem;
        border: 1px solid rgba(188, 19, 19, 0.12);
        background: rgba(255, 255, 255, 0.025);
}

.settings-command-grid span,
.settings-embed-summary span,
.settings-session-stat span,
.session-card-meta span {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
}

.settings-command-grid strong,
.settings-embed-summary strong,
.settings-session-stat strong {
        display: block;
        font-size: 1.1rem;
}

.settings-command-grid p,
.settings-embed-summary p,
.settings-session-stat p {
        margin: 0.35rem 0 0;
        color: var(--color-fg-secondary);
}

.settings-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-top: 1.25rem;
}

.settings-note-grid {
        margin-top: 0;
}

.settings-note {
        min-height: 100%;
}

.settings-note h2 {
        margin: 0 0 0.55rem;
        font-size: 1.18rem;
}

.settings-embed-panel {
        padding: 1.2rem;
