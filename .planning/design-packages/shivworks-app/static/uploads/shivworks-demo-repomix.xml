                expect(shouldBypassKeyGuard('/api/clerk/webhook')).toBe(true);
                expect(shouldBypassKeyGuard('/api/webhooks/stream')).toBe(true);
                expect(shouldBypassKeyGuard('/dashboard')).toBe(false);
                expect(shouldBypassKeyGuard('/')).toBe(false);
        });

