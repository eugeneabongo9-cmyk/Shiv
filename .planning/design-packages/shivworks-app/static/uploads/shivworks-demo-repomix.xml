<file path="src/lib/server/auth-mode.ts">
import type { MemberRecord } from '$lib/server/db/shivworks';
import type { MembershipTier } from '$lib/constants/tiers';

export type AuthMode = 'clerk' | 'mock';
export type MockRole = 'member' | 'admin';
export type MockTier = MembershipTier;

export interface PreviewIdentityOverride {
        role?: MockRole;
        tier?: MockTier;
}

export const PREVIEW_IDENTITY_COOKIE = 'sw_preview_identity';
export const MOCK_ROLES: readonly MockRole[] = ['member', 'admin'];
export const MOCK_TIERS: readonly MockTier[] = ['free', 'bronze', 'vip'];

export function resolveAuthMode(env: Record<string, string | undefined>): AuthMode {
        const isProd = (env.NODE_ENV || '').toLowerCase() === 'production';

        // Hard fail-closed: production NEVER honors AUTH_MODE=mock, regardless of
        // configuration. Mock auth grants admin to every request and must never
        // reach a deployed environment.
        if (isProd) {
                const explicit = env.AUTH_MODE?.toLowerCase().trim();
                if (explicit === 'mock') {
                        throw new Error(
                                'AUTH_MODE=mock is not permitted in production. Set AUTH_MODE=clerk and configure Clerk keys.'
                        );
                }
                return 'clerk';
        }

        const explicit = env.AUTH_MODE?.toLowerCase().trim();
        if (explicit === 'mock') return 'mock';
        if (explicit === 'clerk') return 'clerk';

        // Non-production with AUTH_MODE unset -> mock by default (preview-friendly).
        return 'mock';
}

export const MOCK_AUTH = {
        userId: 'mock-preview-user',
        sessionId: 'mock-preview-session',
        isAuthenticated: true
} as const;

export function isMockAdminEnabled(env: Record<string, string | undefined>): boolean {
        const raw = (env.MOCK_ADMIN || '').toLowerCase().trim();
        return raw === '1' || raw === 'true' || raw === 'yes';
}

function isMockRole(value: unknown): value is MockRole {
        return value === 'member' || value === 'admin';
}

function isMockTier(value: unknown): value is MockTier {
        return value === 'free' || value === 'bronze' || value === 'vip';
}

export function parsePreviewIdentityCookie(
        raw: string | null | undefined
): PreviewIdentityOverride {
        if (!raw) return {};
        const [rolePart, tierPart] = raw.split(':');
        const override: PreviewIdentityOverride = {};
        if (isMockRole(rolePart)) override.role = rolePart;
        if (isMockTier(tierPart)) override.tier = tierPart;
        return override;
}

export function serializePreviewIdentity(override: PreviewIdentityOverride): string {
        const role: MockRole = isMockRole(override.role) ? override.role : 'member';
        const tier: MockTier = isMockTier(override.tier) ? override.tier : 'bronze';
        return `${role}:${tier}`;
}

export function buildMockMember(
        env: Record<string, string | undefined> = {},
        override: PreviewIdentityOverride = {}
): MemberRecord {
        const now = new Date().toISOString();
        const role: MockRole = isMockRole(override.role)
                ? override.role
                : isMockAdminEnabled(env)
                        ? 'admin'
                        : 'member';
        const tier: MockTier = isMockTier(override.tier) ? override.tier : 'bronze';
        return {
                clerkUserId: 'mock-preview-user',
                email: 'preview@shivworks.local',
                name: 'Preview Member',
                tier,
                accessStatus: 'active',
                role,
                createdAt: now,
                updatedAt: now
        };
}
</file>

