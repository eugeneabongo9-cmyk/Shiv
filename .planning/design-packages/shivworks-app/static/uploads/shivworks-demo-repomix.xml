import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { listChannelMessages, listChannels } from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import { presentMessages, sortPinnedFirst } from '$lib/server/community-presenter';

export const GET: RequestHandler = async ({ params, url, locals, platform }) => {
        const user = requirePaidMember(locals, '/community');
        const db = getDBFromPlatform(platform);
        const channels = await listChannels(db);
        const channel = channels.find((c) => c.id === params.channelId);
        if (!channel) error(404, 'Channel not found');
        const permissions = permissionsFor(user, channel);
        if (!permissions.canRead) error(403, 'Channel access denied');

        const limit = Number(url.searchParams.get('limit') || 50);
        const beforeRaw = url.searchParams.get('before');
        const before = beforeRaw ? Number(beforeRaw) : undefined;
        const messages = await listChannelMessages(db, channel.id, {
                limit: Number.isFinite(limit) ? limit : 50,
                beforeCreatedAt: Number.isFinite(before) ? before : undefined
        });
        const presented = sortPinnedFirst(await presentMessages(db, messages, user));
        return json({ messages: presented, permissions });
};
