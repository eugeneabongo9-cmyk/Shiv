import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
	createChannelMessage,
	listChannelMessages,
	listChannels,
	listMessageReactions,
	listMessageAttachments
} from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import { awardTopLevelPostTp } from '$lib/server/community-tp';
import { channelTopic, publish } from '$lib/server/realtime';

const MAX_BODY_LENGTH = 4000;

async function findChannel(db: ReturnType<typeof getDBFromPlatform>, channelId: string) {
	const channels = await listChannels(db);
	return channels.find((channel) => channel.id === channelId) || null;
}

export const GET: RequestHandler = async ({ params, url, locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const channel = await findChannel(db, params.channelId);
	if (!channel) error(404, 'Channel not found');
	const permissions = permissionsFor(user, channel);
	if (!permissions.canRead) error(403, 'Channel access denied');

	const limit = Number(url.searchParams.get('limit') || 50);
	const beforeRaw = url.searchParams.get('before');
	const before = beforeRaw ? Number(beforeRaw) : undefined;
	const messages = await listChannelMessages(db, channel.id, {
		limit: Number.isFinite(limit) ? limit : 50,
		beforeCreatedAt: Number.isFinite(before) ? before : undefined
	});

	const enriched = await Promise.all(
		messages.map(async (message) => {
			const [reactions, attachments] = await Promise.all([
				listMessageReactions(db, message.id),
				listMessageAttachments(db, message.id)
			]);
			return { ...message, reactions, attachments };
		})
	);

	return json({ messages: enriched, permissions });
};

export const POST: RequestHandler = async ({ params, request, locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const channel = await findChannel(db, params.channelId);
	if (!channel) error(404, 'Channel not found');

	const permissions = permissionsFor(user, channel);
	if (!permissions.canRead) error(403, 'Channel access denied');
	if (!permissions.canPostTopLevel) {
		error(403, 'Only admins can post in this channel');
	}

	const body = (await request.json().catch(() => ({}))) as { body?: unknown };
	const text = typeof body.body === 'string' ? body.body.trim() : '';
	if (!text) error(400, 'Message body is required');
	if (text.length > MAX_BODY_LENGTH) error(400, 'Message exceeds maximum length');

	const message = await createChannelMessage(db, {
		channelId: channel.id,
		authorId: user.clerkUserId,
		body: text
	});

	const tpResult = await awardTopLevelPostTp(db, user.clerkUserId, channel, message.id);
	publish(channelTopic(channel.id), 'message.created', {
		message: { ...message, reactions: [], attachments: [] }
	});

	return json({ message, tp: tpResult }, { status: 201 });
};
</file>

