<file path="src/routes/api/library/episodes/[episodeId]/progress/+server.ts">
import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { canAccessAudience } from '$lib/constants/tiers';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { getCourseModuleEpisodeById, upsertMemberEpisodeProgress } from '$lib/server/db/shivworks';

interface ProgressRequest {
	currentSeconds?: number;
	durationSeconds?: number | null;
	completed?: boolean;
}

export const POST: RequestHandler = async ({ request, locals, params, platform }) => {
	if (!locals.auth.isAuthenticated || !locals.user) {
		return json({ success: false, error: 'Authentication required' }, { status: 401 });
	}

	const db = getDBFromPlatform(platform);
	const episode = await getCourseModuleEpisodeById(db, params.episodeId);
	if (!episode) {
		return json({ success: false, error: 'Episode not found' }, { status: 404 });
	}
	if (!canAccessAudience(locals.user, episode.courseAccessTier) || !canAccessAudience(locals.user, episode.accessTier)) {
		return json({ success: false, error: 'Upgrade required for this episode' }, { status: 403 });
	}

	let payload: ProgressRequest;
	try {
		payload = (await request.json()) as ProgressRequest;
	} catch {
		return json({ success: false, error: 'Invalid JSON body' }, { status: 400 });
	}

	const currentSeconds = Math.max(0, Math.round(Number(payload.currentSeconds || 0)));
	const rawDurationSeconds = payload.durationSeconds;
	const durationSeconds =
		rawDurationSeconds === null || rawDurationSeconds === undefined
			? null
			: Math.max(0, Math.round(Number(rawDurationSeconds)));

	await upsertMemberEpisodeProgress(db, {
		memberId: locals.user.clerkUserId,
		episodeId: episode.id,
		currentSeconds,
		durationSeconds: Number.isFinite(durationSeconds ?? 0) ? durationSeconds : null,
		completed: Boolean(payload.completed)
	});

	return json({ success: true });
};
