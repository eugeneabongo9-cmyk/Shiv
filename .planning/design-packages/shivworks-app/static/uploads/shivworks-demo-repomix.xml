import type { LayoutServerLoad } from './$types';
import { redirect } from '@sveltejs/kit';
import { resolveRuntimeEnv } from '$lib/server/env';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
        countUnreadDirectMessages,
        getMemberProfile,
        listMemberTags
} from '$lib/server/db/shivworks';
import { _ACCOUNT_SEEN_COOKIE } from './account/+page.server';
import { isPaidMemberTier } from '$lib/constants/tiers';

const PROFILE_PROMPT_ALLOW_PREFIXES = [
        '/account',
        '/api',
        '/checkout',
        '/login',
        '/signup',
        '/welcome',
        '/settings'
];

export const load: LayoutServerLoad = async ({ locals, platform, url, cookies }) => {
        const runtimeEnv = resolveRuntimeEnv(
                (platform as { env?: Record<string, string | undefined> } | undefined)?.env
        );

        let profileSetupRequired = false;
        let dmUnreadCount = 0;
        let isInstructor = false;
        if (
                locals.user &&
                locals.user.accessStatus === 'active' &&
                (isPaidMemberTier(locals.user.tier) || locals.user.role === 'admin')
        ) {
                const db = getDBFromPlatform(platform);
                const profile = await getMemberProfile(db, locals.user.clerkUserId);
                profileSetupRequired = !profile?.profileCompletedAt;
                dmUnreadCount = await countUnreadDirectMessages(db, locals.user.clerkUserId);
                if (locals.user.role !== 'admin') {
                        const tags = await listMemberTags(db, locals.user.clerkUserId);
                        isInstructor = tags.some((t) => t.tagKey === 'instructor');
                }

                if (
                        profileSetupRequired &&
                        !cookies.get(_ACCOUNT_SEEN_COOKIE) &&
                        !PROFILE_PROMPT_ALLOW_PREFIXES.some((prefix) => url.pathname.startsWith(prefix)) &&
                        url.pathname !== '/'
                ) {
                        redirect(303, '/account?welcome=1');
                }
        }

        return {
                auth: locals.auth,
                user: locals.user,
                authMode: locals.authMode,
                profileSetupRequired,
                dmUnreadCount,
                isInstructor,
                previewIdentity:
                        locals.authMode === 'mock' && locals.user
                                ? { role: locals.user.role, tier: locals.user.tier ?? 'bronze' }
                                : null,
                publicConfig: {
                        clerkPublishableKey: runtimeEnv.PUBLIC_CLERK_PUBLISHABLE_KEY || null
                }
        };
};
