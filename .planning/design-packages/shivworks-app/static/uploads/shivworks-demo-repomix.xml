/**
 * Bulk-load tags for a set of member ids. Returns a map keyed by member id.
 */
export async function bulkListMemberTags(
        db: D1Compat,
        memberIds: string[]
): Promise<Map<string, MemberTagRecord[]>> {
        const result = new Map<string, MemberTagRecord[]>();
        if (memberIds.length === 0) return result;
        const unique = Array.from(new Set(memberIds));
        const placeholders = unique.map(() => '?').join(',');
        const rows = await db
                .prepare(
                        `SELECT * FROM member_tags WHERE member_id IN (${placeholders})
                         ORDER BY tag_key, tag_value`
                )
                .bind(...unique)
                .all<Record<string, unknown>>();
        for (const row of rows.results) {
                const tag = mapMemberTag(row);
                const list = result.get(tag.memberId) ?? [];
                list.push(tag);
                result.set(tag.memberId, list);
        }
        return result;
}

/**
 * Post the weekly question into the chan_weekly_question channel and pin it.
 */
export async function postWeeklyQuestion(
        db: D1Compat,
        input: { authorId: string; body: string; pinned?: boolean }
): Promise<MessageRecord> {
        const channel = await db
                .prepare(`SELECT id FROM channels WHERE slug = 'weekly-question' LIMIT 1`)
                .first<{ id: string }>();
        if (!channel) {
                throw new Error('weekly-question channel is missing.');
        }
        const message = await createChannelMessage(db, {
                channelId: String(channel.id),
                authorId: input.authorId,
                body: input.body
        });
        if (input.pinned !== false) {
                await setMessagePinned(db, message.id, true);
        }
        return { ...message, pinned: input.pinned !== false };
}

