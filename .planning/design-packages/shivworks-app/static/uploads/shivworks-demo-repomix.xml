<file path="src/lib/components/community/ThreadPanel.svelte">
<script lang="ts">
	import { onMount } from 'svelte';
	import { X } from 'lucide-svelte';
	import Composer from './Composer.svelte';
	import type { PresentedMessage } from '$lib/server/community-presenter';

	interface Reply {
		id: string;
		parentId: string;
		authorId: string;
		body: string;
		createdAt: number;
		editedAt: number | null;
		deletedAt: number | null;
	}

	interface AuthorMap {
		[id: string]: { name: string; initials: string; rank: { label: string }; tier: string | null };
	}

	interface Props {
		parent: PresentedMessage;
		canPostReply: boolean;
		onClose: () => void;
	}

	let { parent, canPostReply, onClose }: Props = $props();

	let replies = $state<Reply[]>([]);
	let authors = $state<AuthorMap>({});
	let loading = $state(true);

	function formatTime(ts: number): string {
		return new Date(ts).toLocaleString([], {
			month: 'short',
			day: 'numeric',
			hour: '2-digit',
			minute: '2-digit'
		});
	}

	function initialsFor(name: string) {
		const p = name.trim().split(/\s+/);
		if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
		return (p[0][0] + p[p.length - 1][0]).toUpperCase();
	}

	async function load() {
		loading = true;
		try {
			const res = await fetch(`/api/community/messages/${parent.id}/replies`);
			if (!res.ok) return;
			const data = (await res.json()) as { replies: Reply[] };
			replies = data.replies.filter((r) => !r.deletedAt);
			// Hydrate display from parent author for matches; fallback to id otherwise.
			const map: AuthorMap = {};
			map[parent.author.clerkUserId] = {
				name: parent.author.name,
				initials: parent.author.initials,
				rank: { label: parent.author.rank.label },
				tier: parent.author.tier
			};
			for (const r of replies) {
				if (!map[r.authorId]) {
					map[r.authorId] = {
						name: 'Member',
						initials: initialsFor(r.authorId.slice(0, 2)),
						rank: { label: '' },
						tier: null
					};
				}
			}
			authors = map;
		} finally {
			loading = false;
		}
	}

	async function postReply(body: string) {
		const res = await fetch(`/api/community/messages/${parent.id}/replies`, {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({ body })
		});
		if (!res.ok) return;
		const data = (await res.json()) as { reply: Reply };
		replies = [...replies, data.reply];
	}

	onMount(load);
</script>

<aside class="thread-panel">
	<header class="thread-head">
		<div>
			<p class="card-eyebrow">Thread</p>
			<h3>{parent.author.name}</h3>
		</div>
		<button class="close-btn" onclick={onClose} aria-label="Close thread">
			<X size={16} />
		</button>
	</header>

	<div class="thread-parent">
		<div class="avatar">{parent.author.initials}</div>
		<div>
			<p class="thread-author">{parent.author.name}<span class="thread-rank"> · {parent.author.rank.label}</span></p>
			<p class="thread-body">{parent.body}</p>
		</div>
	</div>

	<div class="thread-divider"></div>

	<div class="thread-replies">
		{#if loading}
			<p class="thread-empty">Loading replies…</p>
		{:else if replies.length === 0}
			<p class="thread-empty">No replies yet. Be the first.</p>
		{:else}
			{#each replies as r (r.id)}
				<article class="reply">
					<div class="avatar small">{authors[r.authorId]?.initials ?? '?'}</div>
					<div>
						<p class="reply-head">
							<span class="reply-author">{authors[r.authorId]?.name ?? 'Member'}</span>
							<span class="reply-time">{formatTime(r.createdAt)}</span>
						</p>
						<p class="reply-body">{r.body}</p>
					</div>
				</article>
			{/each}
		{/if}
	</div>

	<div class="thread-composer">
		<Composer
			placeholder="Reply in thread"
			disabled={!canPostReply}
			disabledMessage="Replies in this channel are admin-only."
			onSend={postReply}
		/>
	</div>
</aside>

