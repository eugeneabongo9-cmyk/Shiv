		expect(response).toBeInstanceOf(Response);
		expect(getClerkClientMock).not.toHaveBeenCalled();
		expect(authenticateClerkRequestMock).not.toHaveBeenCalled();
		expect(ensureMemberIdentityMock).not.toHaveBeenCalled();
		expect(syncAndEnforceSessionLimitMock).not.toHaveBeenCalled();
