<script lang="ts">
        import { onMount, onDestroy } from 'svelte';
        import { page } from '$app/stores';
        import { invalidate } from '$app/navigation';
        import { dmUnreadStore } from '$lib/stores/dm-unread';

        interface Props {
                viewerClerkUserId: string;
                initialUnread: number;
        }

        let { viewerClerkUserId, initialUnread }: Props = $props();
        let eventSource: EventSource | null = null;
        let toastMessage = $state<string | null>(null);
        let toastTimer: ReturnType<typeof setTimeout> | null = null;
        let mounted = $state(false);

        const currentPath = $derived($page.url.pathname);

        // Sync the badge whenever a fresh layout load arrives (e.g. after
        // navigating into a thread that marked messages read on the server).
        $effect(() => {
                if (!mounted) return;
                dmUnreadStore.set(initialUnread);
        });

        onMount(() => {
                dmUnreadStore.set(initialUnread);
                mounted = true;
                eventSource = new EventSource('/api/messages/stream');
                eventSource.addEventListener('dm.created', (e) => {
                        try {
                                const evt = JSON.parse((e as MessageEvent).data);
                                const payload = evt?.payload;
                                if (!payload) return;
                                if (payload.readReceipt && typeof payload.readReceipt.unreadTotal === 'number') {
                                        dmUnreadStore.set(payload.readReceipt.unreadTotal);
                                        return;
                                }
                                if (!payload.message || !payload.sender) return;
                                const m = payload.message;
                                if (m.recipientId !== viewerClerkUserId) return;
                                // Don't increment or toast if the user is already in that thread.
                                const inThisThread = currentPath === `/messages/${m.senderId}`;
                                if (inThisThread) return;
                                dmUnreadStore.update((n) => n + 1);
                                toastMessage = `${payload.sender.name}: ${String(m.body).slice(0, 80)}`;
                                if (toastTimer) clearTimeout(toastTimer);
                                toastTimer = setTimeout(() => (toastMessage = null), 5000);
                                // Refresh inbox if open.
                                if (currentPath === '/messages') invalidate('/messages');
                        } catch {
                                // ignore
                        }
                });
        });

        onDestroy(() => {
                eventSource?.close();
                eventSource = null;
                if (toastTimer) clearTimeout(toastTimer);
        });
</script>

{#if toastMessage}
        <a class="dm-toast" href="/messages" role="status" aria-live="polite">
                <span class="dm-toast-label">New message</span>
                <span class="dm-toast-body">{toastMessage}</span>
        </a>
{/if}

