<file path="src/lib/server/db-availability-guard.ts">
/**
 * Runtime guard for D1 database availability.
 *
 * Mirrors `runtime-key-guard.ts`: required keys can pass the deploy precheck and
 * still be removed or rotated on Cloudflare after deploy, and the same is true
 * for the D1 binding itself. If the `DB` binding is unbound, renamed, or the
 * underlying database is unreachable, the first authenticated request will
 * otherwise surface as a generic 500. This guard probes the database on every
 * non-bypassed request, logs the underlying failure for operators, and serves a
 * friendly 503 maintenance page to end users.
 *
 * Successful probes are cached briefly to keep the per-request overhead to a
 * single trivial query; failures re-probe immediately so recovery is fast.
 */
import { getDBFromPlatform } from './d1-compat';

const D1_BINDING_NAME = 'DB';
const PROBE_SUCCESS_TTL_MS = 30_000;

let lastSuccessAt = 0;
let lastLoggedSignature: string | null = null;

export interface DbUnavailable {
        binding: string;
        reason: string;
}

export type DbProbeResult = { ok: true } | { ok: false; failure: DbUnavailable };

interface PlatformLike {
        env?: { DB?: unknown } & Record<string, unknown>;
}

function hasPlatformBindings(platform: PlatformLike | undefined): boolean {
        return Boolean(platform && typeof platform === 'object' && 'env' in platform && platform.env);
}

export async function probeDatabase(
        platform: PlatformLike | undefined,
        env: Record<string, string | undefined>
): Promise<DbProbeResult> {
        if (Date.now() - lastSuccessAt < PROBE_SUCCESS_TTL_MS) {
                return { ok: true };
        }

        if (hasPlatformBindings(platform) && !platform?.env?.DB && !env.DATABASE_URL) {
                return {
                        ok: false,
                        failure: {
                                binding: D1_BINDING_NAME,
                                reason: `Cloudflare D1 binding "${D1_BINDING_NAME}" is not bound to this deployment`
                        }
                };
        }

        try {
                const db = getDBFromPlatform(platform as { env?: { DB?: any } } | undefined);
                await db.prepare('SELECT 1 AS ok').first();
                lastSuccessAt = Date.now();
                return { ok: true };
        } catch (err) {
                return {
                        ok: false,
                        failure: {
                                binding: D1_BINDING_NAME,
                                reason: (err as Error)?.message || String(err)
                        }
                };
        }
}

const SAFE_PATH_PREFIXES = ['/api/webhooks/', '/api/stripe/webhook', '/api/clerk/webhook'];

export function shouldBypassDbGuard(pathname: string): boolean {
        return SAFE_PATH_PREFIXES.some((prefix) => pathname.startsWith(prefix));
}

export function logDbUnavailableOnce(failure: DbUnavailable): void {
        const signature = `${failure.binding}:${failure.reason}`;
        if (signature === lastLoggedSignature) return;
        lastLoggedSignature = signature;

        console.error(
                '\n[runtime] Database is unreachable from this deployment:\n' +
                        `  - binding: ${failure.binding}\n` +
                        `  - error:   ${failure.reason}\n\n` +
                        'The app is returning a 503 maintenance page for end users until the D1\n' +
                        'binding is restored in the Cloudflare Pages / wrangler environment. No\n' +
                        'code change is required — re-bind the database and the next request will\n' +
                        'recover automatically.\n'
        );
}

export function resetDbGuardStateForTests(): void {
        lastSuccessAt = 0;
        lastLoggedSignature = null;
}

export function renderDbUnavailablePage(failure: DbUnavailable): Response {
        const body = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>ShivWorks Network — Temporarily Unavailable</title>
<style>
        :root { color-scheme: dark; }
        html, body { margin: 0; padding: 0; min-height: 100%; background: #0b0b0d; color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        main { max-width: 560px; margin: 0 auto; padding: 96px 24px; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; background: rgba(224, 49, 38, 0.12); color: #e03126; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
        h1 { font-size: 28px; line-height: 1.2; margin: 16px 0 12px; }
        p { color: #c8c8cc; line-height: 1.6; margin: 0 0 12px; }
        a { color: #e03126; }
        .meta { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 13px; color: #8a8a90; }
</style>
</head>
<body>
<main>
        <span class="badge">Service unavailable</span>
        <h1>We're temporarily offline.</h1>
        <p>The ShivWorks Network is briefly unavailable while we finish a configuration update. No action is needed on your end — please try again in a few minutes.</p>
        <p>If you continue to see this page, email <a href="mailto:support@shivworks.com">support@shivworks.com</a> and we'll get back to you right away.</p>
        <p class="meta">Status: database binding "${failure.binding}" unavailable.</p>
</main>
</body>
</html>`;

        return new Response(body, {
                status: 503,
                headers: {
                        'content-type': 'text/html; charset=utf-8',
                        'cache-control': 'no-store',
                        'retry-after': '120'
                }
        });
}
</file>

<file path="src/lib/server/env.ts">
/**
 * Environment Variable Access
 *
 * - env(key) reads direct process.env (useful for scripts/tests).
 * - resolveRuntimeEnv merges local process.env with Worker/Pages runtime env so
 *   routes can call one helper in both environments.
 */

export function env(key: string): string | undefined {
        return process.env[key];
}

const RUNTIME_ENV_KEYS = [
        'PUBLIC_SITE_URL',
        'PUBLIC_SHIVWORKS_MAIN_SITE',
        'PUBLIC_SHIVWORKS_STORE_URL',
        'PUBLIC_SHIVWORKS_MEMBERSHIP_URL',
        'PUBLIC_CIRCLE_COMMUNITY_URL',
        'PUBLIC_SUPPORT_EMAIL',
        'PUBLIC_CLERK_PUBLISHABLE_KEY',
        'CLERK_SECRET_KEY',
        'CLERK_JWT_KEY',
        'CLERK_WEBHOOK_SIGNING_SECRET',
        'CLERK_AUTHORIZED_PARTIES',
        'AUTH_MODE',
        'MOCK_ADMIN',
        'NODE_ENV',
        'REPLIT_DEV_DOMAIN',
        'STRIPE_SECRET_KEY',
        'STRIPE_WEBHOOK_SECRET',
        'STRIPE_BRONZE_PRICE_ID',
        'STRIPE_VIP_PRICE_ID',
        'RESEND_API_KEY',
        'EMAIL_FROM',
        'SUPPORT_EMAIL',
        'SHIVWORKS_ADMIN_EMAILS',
        'CLOUDFLARE_ACCOUNT_ID',
        'CF_ACCOUNT_ID',
        'CLOUDFLARE_STREAM_ACCOUNT_ID',
        'CLOUDFLARE_STREAM_API_TOKEN',
        'STREAM_API_TOKEN',
        'CLOUDFLARE_STREAM_WEBHOOK_SECRET',
        'CLOUDFLARE_STREAM_ALLOWED_ORIGINS',
        'STREAM_ALLOWED_ORIGINS',
        'VIDEO_STREAM_TOKEN_TTL_SECONDS'
] as const;

export function resolveRuntimeEnv(
        platformEnv?: Record<string, string | undefined> | null
): Record<string, string | undefined> {
        const resolved: Record<string, string | undefined> = {};

        for (const [key, value] of Object.entries(process.env)) {
                resolved[key] = value;
        }

        if (platformEnv) {
                for (const [key, value] of Object.entries(platformEnv)) {
                        if (typeof value === 'string') {
                                resolved[key] = value;
                        }
                }

                for (const key of RUNTIME_ENV_KEYS) {
                        const value = (platformEnv as Record<string, unknown>)[key];
                        if (typeof value === 'string') {
                                resolved[key] = value;
                        }
                }
        }

        return resolved;
}
</file>

