function utcDayBucket(ms: number): string {
        // YYYY-MM-DD in UTC; matches migration 0014 backfill.
        return new Date(ms).toISOString().slice(0, 10);
}

export async function recordRecognition(
        db: D1Compat,
        input: { giverId: string; recipientId: string; messageId: string }
): Promise<RecognitionRecord | null> {
        const id = crypto.randomUUID();
        const now = Date.now();
        const dayBucket = utcDayBucket(now);
        const result = await db
                .prepare(
                        `INSERT OR IGNORE INTO recognitions
                         (id, giver_id, recipient_id, message_id, day_bucket, created_at)
                         VALUES (?, ?, ?, ?, ?, ?)`
                )
                .bind(id, input.giverId, input.recipientId, input.messageId, dayBucket, now)
                .run();
        if (!result.meta.changes) {
                return null;
        }
        return {
                id,
                giverId: input.giverId,
                recipientId: input.recipientId,
                messageId: input.messageId,
                createdAt: now
        };
}

