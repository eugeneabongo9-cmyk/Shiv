<script lang="ts">
        import { Check, X, ArrowRight } from 'lucide-svelte';
        import type { OnboardingChecklistState } from '$lib/server/onboarding';

        interface Props {
                state: OnboardingChecklistState;
        }

        const props: Props = $props();
        let current: OnboardingChecklistState = $state(props.state);
        let busy = $state(false);
        let error: string | null = $state(null);

        const completedCount = $derived(current.items.filter((i) => i.complete).length);
        const totalCount = $derived(current.items.length);
        const allComplete = $derived(completedCount === totalCount);
        const pct = $derived(Math.round((completedCount / Math.max(1, totalCount)) * 100));

        async function dismiss() {
                if (busy) return;
                busy = true;
                error = null;
                try {
                        const res = await fetch('/api/onboarding/checklist/dismiss', { method: 'POST' });
                        const data = (await res.json().catch(() => ({}))) as { state?: OnboardingChecklistState };
                        // Always sync any returned state so the UI never lags behind
                        // server truth (e.g. on a 403 not_eligible response).
                        if (data.state) current = data.state;
                        if (!res.ok) error = 'Could not dismiss. Please try again.';
                } catch {
                        error = 'Could not dismiss. Please try again.';
                } finally {
                        busy = false;
                }
        }

        async function finalize() {
                if (busy) return;
                busy = true;
                error = null;
                try {
                        const res = await fetch('/api/onboarding/checklist/complete', { method: 'POST' });
                        const data = (await res.json().catch(() => ({}))) as { state?: OnboardingChecklistState };
                        if (data.state) current = data.state;
                        if (!res.ok) error = 'Could not complete. Please try again.';
                } catch {
                        error = 'Could not complete. Please try again.';
                } finally {
                        busy = false;
                }
        }
</script>

{#if current.visible}
        <section class="checklist" aria-label="Get started checklist">
                <header class="checklist-head">
                        <div>
                                <p class="checklist-eyebrow">Get started</p>
