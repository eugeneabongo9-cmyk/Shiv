import { error } from '@sveltejs/kit';
import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { listChannelMessages, listChannels } from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import {
        presentMessages,
        reorderChannelsForBrief,
        sortPinnedFirst
} from '$lib/server/community-presenter';

export const load: PageServerLoad = async ({ locals, platform, url }) => {
        const user = requirePaidMember(locals, '/community');
        const db = getDBFromPlatform(platform);
        const all = await listChannels(db);
        const visible = all
                .map((c) => ({ channel: c, permissions: permissionsFor(user, c) }))
                .filter((e) => e.permissions.canRead)
                .map(({ channel, permissions }) => ({
                        ...channel,
                        canPostTopLevel: permissions.canPostTopLevel,
                        canPostReply: permissions.canPostReply
                }));

        if (visible.length === 0) error(403, 'No channels available for this membership');

        const groups = reorderChannelsForBrief(visible);
        const requestedSlug = url.searchParams.get('channel');
        const initial =
                (requestedSlug && visible.find((c) => c.slug === requestedSlug)) ||
                visible.find((c) => c.slug === 'welcome') ||
                visible[0];

        const rawMessages = await listChannelMessages(db, initial.id, { limit: 50 });
        const presented = sortPinnedFirst(await presentMessages(db, rawMessages, user));
        const focusMessageId = url.searchParams.get('message');

        return {
                viewer: {
                        clerkUserId: user.clerkUserId,
                        name: user.name,
                        tier: user.tier,
                        role: user.role
                },
                channelGroups: groups,
                initialChannel: initial,
                initialMessages: presented,
                focusMessageId
        };
};
</file>

<file path="src/routes/library/[slug]/+page.server.ts">
import { error, redirect } from '@sveltejs/kit';
import type { PageServerLoad } from './$types';
import { canAccessAudience } from '$lib/constants/tiers';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
	getCourseBySlug,
	listCourseModules,
	listCourseModuleEpisodes,
	listMemberEpisodeProgress,
	listMemberModuleProgress
} from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';

export const load: PageServerLoad = async ({ locals, params, platform, url }) => {
	const redirectTarget = `/library/${params.slug}`;
	const user = requirePaidMember(locals, redirectTarget);
	const db = getDBFromPlatform(platform);
	const course = await getCourseBySlug(db, params.slug);

	if (!course) {
		error(404, 'Course not found');
	}

	if (!canAccessAudience(user, course.accessTier)) {
		redirect(302, `/checkout?redirect=${encodeURIComponent(redirectTarget)}`);
	}

	const modules = await listCourseModules(db, course.id);
	const progressEntries = await listMemberModuleProgress(db, user.clerkUserId);
	const progressByModule = Object.fromEntries(
		progressEntries
			.filter((entry) => modules.some((module) => module.id === entry.moduleId))
			.map((entry) => [entry.moduleId, entry])
	);
	const requestedModuleId = url.searchParams.get('module');
	const selectedModule =
		modules.find((module) => module.id === requestedModuleId) ||
		modules.find((module) => module.status === 'available' && module.videoUrl) ||
		modules[0] ||
		null;

	const allEpisodes = await listCourseModuleEpisodes(db, { courseId: course.id });
	const episodes = allEpisodes
		.filter((episode) => episode.status === 'available')
		.map((episode) => ({
			id: episode.id,
			moduleId: episode.moduleId,
			episodeNumber: episode.episodeNumber,
			title: episode.title,
			description: episode.description,
			accessTier: episode.accessTier,
			sortOrder: episode.sortOrder,
			durationLabel: episode.durationLabel,
			provider: episode.media?.provider ?? null,
			ingestStatus: episode.media?.ingestStatus ?? null,
			durationSeconds: episode.media?.durationSeconds ?? null,
			playable:
				canAccessAudience(user, episode.courseAccessTier) &&
				canAccessAudience(user, episode.accessTier) &&
				Boolean(episode.media) &&
				episode.media?.ingestStatus === 'ready'
		}));

	const episodeProgressEntries = await listMemberEpisodeProgress(db, user.clerkUserId);
	const episodeIds = new Set(episodes.map((episode) => episode.id));
	const progressByEpisode = Object.fromEntries(
		episodeProgressEntries
			.filter((entry) => episodeIds.has(entry.episodeId))
			.map((entry) => [entry.episodeId, entry])
	);

	const requestedEpisodeId = url.searchParams.get('episode');
	const selectedEpisodeId =
		(requestedEpisodeId && episodes.find((episode) => episode.id === requestedEpisodeId)?.id) ||
		null;

	return {
		user,
		course,
		modules,
		progressByModule,
		selectedModuleId: selectedModule?.id || null,
		episodes,
		progressByEpisode,
		selectedEpisodeId
	};
};
</file>

