import type { ChannelRecord } from '$lib/server/db/shivworks';
import type { MemberRecord } from '$lib/server/db/shivworks';
import { isPaidMemberTier } from '$lib/constants/tiers';

/** The 5 fixed reaction emoji keys per Brief Section 4. */
export const REACTION_KEYS = ['recognize', 'agree', 'fire', 'eyes', 'pressure'] as const;
export type ReactionKey = (typeof REACTION_KEYS)[number];

export function isReactionKey(value: unknown): value is ReactionKey {
	return typeof value === 'string' && (REACTION_KEYS as readonly string[]).includes(value);
}

/** Slugs that only admins may post top-level messages in. */
const ADMIN_TOP_LEVEL_SLUGS = new Set(['announcements', 'weekly-question']);
/** Slugs where non-admins may not post replies either. */
const ADMIN_ONLY_REPLIES_SLUGS = new Set(['announcements']);

export interface ChannelPermissions {
	canRead: boolean;
	canPostTopLevel: boolean;
	canPostReply: boolean;
	canReact: boolean;
}

export function permissionsFor(
	user: MemberRecord | null | undefined,
	channel: ChannelRecord
): ChannelPermissions {
	if (!user || user.accessStatus !== 'active') {
		return { canRead: false, canPostTopLevel: false, canPostReply: false, canReact: false };
	}
	const isAdmin = user.role === 'admin';
	const isPaid = isPaidMemberTier(user.tier);
	if (!isPaid && !isAdmin) {
		return { canRead: false, canPostTopLevel: false, canPostReply: false, canReact: false };
	}
	if (channel.vipOnly && user.tier !== 'vip' && !isAdmin) {
		return { canRead: false, canPostTopLevel: false, canPostReply: false, canReact: false };
	}
	const adminOnlyTopLevel = ADMIN_TOP_LEVEL_SLUGS.has(channel.slug) || channel.readOnly;
	const adminOnlyReplies = ADMIN_ONLY_REPLIES_SLUGS.has(channel.slug);
	return {
		canRead: true,
		canPostTopLevel: isAdmin || !adminOnlyTopLevel,
		canPostReply: isAdmin || !adminOnlyReplies,
		canReact: true
	};
}

export function canDeleteMessage(
	user: MemberRecord,
	authorId: string
): boolean {
	return user.role === 'admin' || user.clerkUserId === authorId;
}

export function canEditMessage(user: MemberRecord, authorId: string): boolean {
	return user.clerkUserId === authorId;
}
</file>

