<file path="src/lib/server/admin-analytics.test.ts">
import { mkdtempSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { beforeEach, describe, expect, it } from 'vitest';

const tmpDir = mkdtempSync(join(tmpdir(), 'admin-analytics-'));
process.env.DATABASE_PATH = join(tmpDir, 'test.db');
process.env.SHIVWORKS_DB_MODE = 'sqlite';
delete process.env.DATABASE_URL;

import { getDB } from './d1-compat';
import {
        flagInactiveMembersAndNotify,
        getCommunityMetrics,
        listInactiveMembers,
        maybeRunReengagementScan,
        REENGAGEMENT_INACTIVITY_DAYS,
        REENGAGEMENT_THROTTLE_MS,
        shouldRunReengagementScan
} from './admin-analytics';
import {
        addMemberTag,
        bulkListMemberTags,
        listMemberTags,
        postWeeklyQuestion,
        removeMemberTag
} from './db/shivworks';
import {
        dismissInAppNotification,
        enqueueInAppNotification,
        listUnreadInAppNotifications
} from './in-app-notifications';

const db = getDB();
const DAY = 24 * 60 * 60 * 1000;

let counter = 0;
function nextId(prefix = 'm'): string {
        counter += 1;
        return `${prefix}-${Date.now()}-${counter}`;
}

async function seedMember(id: string, createdAt: number = Date.now()) {
        await db
                .prepare(
                        `INSERT OR REPLACE INTO members
                         (clerk_user_id, email, name, tier, access_status, role, created_at, updated_at)
                         VALUES (?, ?, ?, 'bronze', 'active', 'member', ?, ?)`
                )
                .bind(id, `${id}@test.local`, id, createdAt, createdAt)
                .run();
}

async function setLastActive(memberId: string, ts: number) {
        await db
                .prepare(
                        `INSERT INTO member_training_points
                         (id, member_id, action_type, points_awarded, reference_id, created_at)
                         VALUES (?, ?, 'login_daily', 1, NULL, ?)`
                )
                .bind(`tp-${nextId()}`, memberId, ts)
                .run();
}

async function seedWeeklyQuestionChannel(): Promise<string> {
        const id = `ch-${nextId()}`;
        const now = Date.now();
        await db
                .prepare(
                        `INSERT OR REPLACE INTO channels
                                (id, slug, name, description, category, category_sort, channel_sort, vip_only, read_only, created_at, updated_at)
                         VALUES (?, 'weekly-question', 'Weekly Question', '', 'general', 0, 0, 0, 0, ?, ?)`
                )
                .bind(id, now, now)
                .run();
        return id;
}

describe('admin analytics + segmentation', () => {
        beforeEach(async () => {
                await db.prepare('DELETE FROM in_app_notifications').run();
                await db.prepare('DELETE FROM member_training_points').run();
                await db.prepare('DELETE FROM member_tags').run();
                await db.prepare('DELETE FROM messages').run();
                await db.prepare('DELETE FROM channels').run();
                await db.prepare('DELETE FROM member_sessions').run();
                await db.prepare('DELETE FROM recognitions').run();
                await db.prepare('DELETE FROM system_kv').run();
                await db.prepare('DELETE FROM members').run();
        });

        it('flags inactive members and is idempotent within the same activity bucket', async () => {
                const stale = nextId();
                const fresh = nextId();
                await seedMember(stale);
                await seedMember(fresh);
                await setLastActive(stale, Date.now() - 30 * DAY);
                await setLastActive(fresh, Date.now() - 1 * DAY);

                const inactive = await listInactiveMembers(db);
                expect(inactive.map((m) => m.memberId)).toEqual([stale]);

                const first = await flagInactiveMembersAndNotify(db);
                expect(first.flagged).toBe(1);
                expect(first.notified).toBe(1);

                const second = await flagInactiveMembersAndNotify(db);
                expect(second.flagged).toBe(1);
                expect(second.notified).toBe(0);
                expect(second.skipped).toBe(1);

                const unread = await listUnreadInAppNotifications(db, stale);
                expect(unread).toHaveLength(1);
                expect(unread[0].kind).toBe('reengagement_14d');

                await dismissInAppNotification(db, stale, unread[0].id);
                expect(await listUnreadInAppNotifications(db, stale)).toHaveLength(0);
        });

        it('enqueueInAppNotification dedupes by (member, kind, source_ref)', async () => {
                const id = nextId();
                await seedMember(id);
                const a = await enqueueInAppNotification(db, {
                        memberId: id,
                        kind: 'reengagement_14d',
                        title: 'one',
                        sourceRef: 'last_active:2026-01-01'
                });
                const b = await enqueueInAppNotification(db, {
                        memberId: id,
                        kind: 'reengagement_14d',
                        title: 'two',
                        sourceRef: 'last_active:2026-01-01'
                });
                expect(a).toBe(true);
                expect(b).toBe(false);
        });

        it('lists, adds and removes member tags in bulk', async () => {
                const a = nextId();
                const b = nextId();
                await seedMember(a);
                await seedMember(b);
                await addMemberTag(db, { memberId: a, tagKey: 'ecqc_alumni', tagValue: null, assignedBy: null });
                await addMemberTag(db, { memberId: a, tagKey: 'state', tagValue: 'TX', assignedBy: null });
                await addMemberTag(db, { memberId: b, tagKey: 'le', tagValue: null, assignedBy: null });

                const map = await bulkListMemberTags(db, [a, b]);
                expect(map.get(a)?.length).toBe(2);
                expect(map.get(b)?.length).toBe(1);

                await removeMemberTag(db, { memberId: a, tagKey: 'state', tagValue: 'TX' });
                const remaining = await listMemberTags(db, a);
                expect(remaining.map((t) => t.tagKey)).toEqual(['ecqc_alumni']);
        });

        it('flags never-active paid members whose accounts are older than the threshold', async () => {
                const old = nextId();
                const recent = nextId();
                await seedMember(old, Date.now() - 30 * DAY);
                await seedMember(recent, Date.now() - 1 * DAY);

                const inactive = await listInactiveMembers(db);
                expect(inactive.map((m) => m.memberId)).toEqual([old]);
                expect(inactive[0].daysInactive).toBeGreaterThanOrEqual(REENGAGEMENT_INACTIVITY_DAYS);
        });

        it('throttles maybeRunReengagementScan within the configured window', async () => {
                const stale = nextId();
                await seedMember(stale, Date.now() - 30 * DAY);
                await setLastActive(stale, Date.now() - 30 * DAY);

                expect(await shouldRunReengagementScan(db)).toBe(true);
                const first = await maybeRunReengagementScan(db);
                expect(first?.notified).toBe(1);

                expect(await shouldRunReengagementScan(db)).toBe(false);
                const second = await maybeRunReengagementScan(db);
                expect(second).toBeNull();
        });

        it('throttle marker persists even when no inactive members are flagged', async () => {
                // Empty database — no members, no notifications produced.
                expect(await shouldRunReengagementScan(db)).toBe(true);
                const result = await maybeRunReengagementScan(db);
                expect(result).toEqual({ flagged: 0, notified: 0, skipped: 0 });
                // Subsequent calls should be throttled even though no notifications exist.
                expect(await shouldRunReengagementScan(db)).toBe(false);
                expect(await maybeRunReengagementScan(db)).toBeNull();
                // After the window elapses, scans run again.
                expect(await shouldRunReengagementScan(db, REENGAGEMENT_THROTTLE_MS, Date.now() + REENGAGEMENT_THROTTLE_MS + 1)).toBe(true);
        });

        it('omits the recognition leaderboard when caller is not an admin', async () => {
                const giver = nextId();
                const receiver = nextId();
                await seedMember(giver);
                await seedMember(receiver);
                const channelId = await seedWeeklyQuestionChannel();
                const messageId = `msg-${nextId()}`;
                const now = Date.now();
                await db
                        .prepare(
                                `INSERT INTO messages (id, channel_id, author_id, body, created_at)
                                 VALUES (?, ?, ?, ?, ?)`
                        )
                        .bind(messageId, channelId, giver, 'nice work', now)
                        .run();
                await db
                        .prepare(
                                `INSERT INTO recognitions (id, giver_id, recipient_id, message_id, day_bucket, created_at)
                                 VALUES (?, ?, ?, ?, ?, ?)`
                        )
                        .bind(`rec-${nextId()}`, giver, receiver, messageId, '2026-04-22', now)
                        .run();

                const adminView = await getCommunityMetrics(db, { includeRecognitionLeaderboard: true });
                expect(adminView.topRecognitionRecipients.length).toBe(1);

                const instructorView = await getCommunityMetrics(db, { includeRecognitionLeaderboard: false });
                expect(instructorView.topRecognitionRecipients).toEqual([]);
        });

        it('posts the weekly question and pins it', async () => {
                const author = nextId();
                await seedMember(author);
                await seedWeeklyQuestionChannel();
                const msg = await postWeeklyQuestion(db, {
                        authorId: author,
                        body: 'What was your biggest lesson this week?'
                });
                expect(msg.pinned).toBe(true);
                const row = await db
                        .prepare('SELECT pinned FROM messages WHERE id = ?')
                        .bind(msg.id)
                        .first<{ pinned: number }>();
                expect(Number(row?.pinned)).toBe(1);
        });
});
