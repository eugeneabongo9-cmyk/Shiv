<file path="src/routes/api/community/messages/[messageId]/attachments/+server.ts">
import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import {
	addMessageAttachment,
	getMessageById,
	listChannels
} from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { canEditMessage, permissionsFor } from '$lib/server/community-access';
import { channelTopic, publish } from '$lib/server/realtime';

const MAX_NAME = 256;
const MAX_BYTES = 25 * 1024 * 1024; // 25MB

function isHttpUrl(value: unknown): value is string {
	if (typeof value !== 'string') return false;
	try {
		const url = new URL(value);
		return url.protocol === 'https:' || url.protocol === 'http:';
	} catch {
		return false;
	}
}

export const POST: RequestHandler = async ({ params, request, locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const message = await getMessageById(db, params.messageId);
	if (!message || message.deletedAt) error(404, 'Message not found');
	if (!canEditMessage(user, message.authorId)) {
		error(403, 'Only the author can attach files to this message');
	}
	const channels = await listChannels(db);
	const channel = channels.find((c) => c.id === message.channelId);
	if (!channel) error(404, 'Channel not found');
	if (!permissionsFor(user, channel).canRead) error(403, 'Channel access denied');

	const body = (await request.json().catch(() => ({}))) as {
		url?: unknown;
		fileType?: unknown;
		fileName?: unknown;
		fileSize?: unknown;
	};

	if (!isHttpUrl(body.url)) error(400, 'A valid attachment URL is required');
	if (typeof body.fileType !== 'string' || !body.fileType.trim()) {
		error(400, 'fileType is required');
	}
	const fileName =
		typeof body.fileName === 'string' && body.fileName.trim()
			? body.fileName.trim().slice(0, MAX_NAME)
			: null;
	const fileSizeRaw = body.fileSize;
	let fileSize: number | null = null;
	if (fileSizeRaw !== undefined && fileSizeRaw !== null) {
		if (typeof fileSizeRaw !== 'number' || !Number.isFinite(fileSizeRaw) || fileSizeRaw < 0) {
			error(400, 'fileSize must be a non-negative number');
		}
		if (fileSizeRaw > MAX_BYTES) error(400, 'Attachment exceeds maximum size');
		fileSize = fileSizeRaw;
	}

	const attachment = await addMessageAttachment(db, {
		messageId: message.id,
		url: body.url,
		fileType: body.fileType.trim().slice(0, 64),
		fileName,
		fileSize
	});

	publish(channelTopic(channel.id), 'message.edited', {
		messageId: message.id,
		channelId: channel.id,
		attachment
	});

	return json({ attachment }, { status: 201 });
};
</file>

