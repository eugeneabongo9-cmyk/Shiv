<file path="src/lib/server/runtime-key-guard.ts">
/**
 * Runtime guard for required production keys.
 *
 * The deploy precheck (`scripts/check-auth-mode.mjs`) blocks builds that are
 * missing required keys, but keys can still be *removed* or *rotated
 * incorrectly* on Cloudflare after deploy. Without this guard the user just
 * sees a generic 500 on the first authenticated request and the cause is
 * invisible. This guard runs on every request in production: if any required
 * key is missing or blank it logs the offending variable name and short-circuits
 * with a friendly 503 maintenance page.
 */

interface RequiredKeyGroup {
        label: string;
        keys: string[];
}

const REQUIRED_KEY_GROUPS: RequiredKeyGroup[] = [
        {
                label: 'Clerk',
                keys: ['PUBLIC_CLERK_PUBLISHABLE_KEY', 'CLERK_SECRET_KEY']
        },
        {
                label: 'Stripe',
                keys: ['STRIPE_SECRET_KEY']
        },
        {
                label: 'Resend',
                keys: ['RESEND_API_KEY']
        }
];

export interface MissingKey {
        label: string;
        key: string;
}

export function findMissingProductionKeys(
        env: Record<string, string | undefined>
): MissingKey[] {
        const missing: MissingKey[] = [];
        for (const group of REQUIRED_KEY_GROUPS) {
                for (const key of group.keys) {
                        const value = env[key];
                        if (!value || !value.trim()) {
                                missing.push({ label: group.label, key });
                        }
                }
        }
        return missing;
}

export function isProductionRuntime(
        env: Record<string, string | undefined>
): boolean {
        return (env.NODE_ENV || '').toLowerCase() === 'production';
}

const SAFE_PATH_PREFIXES = ['/api/webhooks/', '/api/stripe/webhook', '/api/clerk/webhook'];

export function shouldBypassKeyGuard(pathname: string): boolean {
        return SAFE_PATH_PREFIXES.some((prefix) => pathname.startsWith(prefix));
}

export function renderMissingKeysPage(missing: MissingKey[]): Response {
        const labels = Array.from(new Set(missing.map((entry) => entry.label)));
        const services =
                labels.length === 1
                        ? labels[0]
                        : labels.slice(0, -1).join(', ') + ' and ' + labels[labels.length - 1];

        const body = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>ShivWorks Network — Temporarily Unavailable</title>
<style>
        :root { color-scheme: dark; }
        html, body { margin: 0; padding: 0; min-height: 100%; background: #0b0b0d; color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        main { max-width: 560px; margin: 0 auto; padding: 96px 24px; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; background: rgba(224, 49, 38, 0.12); color: #e03126; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
        h1 { font-size: 28px; line-height: 1.2; margin: 16px 0 12px; }
        p { color: #c8c8cc; line-height: 1.6; margin: 0 0 12px; }
        a { color: #e03126; }
        .meta { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 13px; color: #8a8a90; }
</style>
</head>
<body>
<main>
        <span class="badge">Service unavailable</span>
        <h1>We're temporarily offline.</h1>
        <p>The ShivWorks Network is briefly unavailable while we finish a configuration update. No action is needed on your end — please try again in a few minutes.</p>
        <p>If you continue to see this page, email <a href="mailto:support@shivworks.com">support@shivworks.com</a> and we'll get back to you right away.</p>
        <p class="meta">Status: ${services} configuration missing.</p>
</main>
</body>
</html>`;

        return new Response(body, {
                status: 503,
                headers: {
                        'content-type': 'text/html; charset=utf-8',
                        'cache-control': 'no-store',
                        'retry-after': '120'
                }
        });
}

let lastLoggedSignature: string | null = null;

export function logMissingKeysOnce(missing: MissingKey[]): void {
        const signature = missing.map((m) => m.key).sort().join(',');
        if (signature === lastLoggedSignature) return;
        lastLoggedSignature = signature;

        const lines = missing.map(({ label, key }) => `  - ${key} (${label})`).join('\n');
        console.error(
                '\n[runtime] Required production environment variable(s) are missing or blank:\n' +
                        lines +
                        '\n\nThe app is returning a 503 maintenance page for end users until these are\n' +
                        'restored in the Cloudflare Pages / wrangler environment. No code change is\n' +
                        'required — set the variable(s) above and the next request will recover.\n'
        );
}
</file>

<file path="src/lib/server/woocommerce.ts">
import { env } from '$env/dynamic/private';

interface CacheEntry {
	value: number;
	expires: number;
}

const cache = new Map<string, CacheEntry>();
const CACHE_TTL_MS = 5 * 60 * 1000;

interface WooProduct {
	id: number;
	total_sales?: number;
	name?: string;
}

export interface WoocommerceConfig {
	baseUrl: string;
	consumerKey: string;
	consumerSecret: string;
	productId: string;
}

export function getWoocommerceConfig(): WoocommerceConfig | null {
	const baseUrl = env.WOOCOMMERCE_API_URL;
	const consumerKey = env.WOOCOMMERCE_CONSUMER_KEY;
	const consumerSecret = env.WOOCOMMERCE_CONSUMER_SECRET;
	const productId = env.WOOCOMMERCE_PRODUCT_ID;
	if (!baseUrl || !consumerKey || !consumerSecret || !productId) return null;
	return { baseUrl: baseUrl.replace(/\/$/, ''), consumerKey, consumerSecret, productId };
}

export async function getWoocommerceProductSoldCount(
	options: { force?: boolean } = {}
): Promise<number | null> {
	const config = getWoocommerceConfig();
	if (!config) return null;

	const cacheKey = `product:${config.productId}`;
	const now = Date.now();
	if (!options.force) {
		const cached = cache.get(cacheKey);
		if (cached && cached.expires > now) return cached.value;
	}

	const url = `${config.baseUrl}/wp-json/wc/v3/products/${config.productId}`;
	const auth = Buffer.from(`${config.consumerKey}:${config.consumerSecret}`).toString('base64');

	try {
		const res = await fetch(url, {
			headers: {
				Authorization: `Basic ${auth}`,
				Accept: 'application/json'
			}
		});

		if (!res.ok) {
			console.warn(`[woocommerce] product fetch failed: ${res.status} ${res.statusText}`);
			return cache.get(cacheKey)?.value ?? null;
		}

		const data = (await res.json()) as WooProduct;
		const sold = typeof data.total_sales === 'number' ? data.total_sales : 0;
		cache.set(cacheKey, { value: sold, expires: now + CACHE_TTL_MS });
		return sold;
	} catch (err) {
		console.warn('[woocommerce] product fetch error', err);
		return cache.get(cacheKey)?.value ?? null;
	}
}
</file>

