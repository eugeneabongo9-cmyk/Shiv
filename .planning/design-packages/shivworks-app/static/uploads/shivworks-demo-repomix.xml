}

.dashboard-updates-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
        gap: 1.35rem 1.5rem;
        align-items: start;
}

.dashboard-update-lead,
.dashboard-update-context,
.dashboard-update-archive,
