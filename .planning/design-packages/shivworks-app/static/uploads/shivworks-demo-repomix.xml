import { mkdtempSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { beforeAll, beforeEach, describe, expect, it } from 'vitest';

const tmpDir = mkdtempSync(join(tmpdir(), 'gamif-'));
process.env.DATABASE_PATH = join(tmpDir, 'test.db');
process.env.SHIVWORKS_DB_MODE = 'sqlite';
delete process.env.DATABASE_URL;

import { getDB } from './d1-compat';
import {
        applyEntitlementMilestones,
        awardPoints,
        evaluateMilestones,
        getLeaderboard,
        getMemberDossier,
        getRankProgress,
        resolveRank,
        rolloverStreakIfStale,
        setLeaderboardOptIn,
        utcDateKey,
        DAILY_CAPS,
        TP_VALUES
} from './gamification';

const db = getDB();

let memberCounter = 0;
function nextMemberId(prefix = 'm'): string {
        memberCounter += 1;
        return `${prefix}-${Date.now()}-${memberCounter}`;
}

async function seedMember(opts: {
        id?: string;
        name?: string;
        tier?: 'free' | 'bronze' | 'vip';
        accessStatus?: 'none' | 'active' | 'revoked';
        entitle?: 'bronze' | 'vip' | null;
}) {
        const id = opts.id ?? nextMemberId();
        const now = Date.now();
        await db
                .prepare(
                        `INSERT OR REPLACE INTO members (clerk_user_id, email, name, tier, access_status, role, created_at, updated_at)
                         VALUES (?, ?, ?, ?, ?, 'member', ?, ?)`
                )
                .bind(id, `${id}@example.test`, opts.name ?? id, opts.tier ?? 'bronze', opts.accessStatus ?? 'active', now, now)
                .run();

        if (opts.entitle) {
                await db
                        .prepare(
                                `INSERT OR IGNORE INTO member_entitlements
                                        (id, member_id, tier, source_type, source_ref, status, created_at, updated_at)
                                 VALUES (?, ?, ?, 'test', ?, 'active', ?, ?)`
                        )
                        .bind(`ent-${id}`, id, opts.entitle, `seed-${id}`, now, now)
                        .run();
        }

        return id;
}

beforeAll(async () => {
        // Force first DB hit so migrations apply before any test runs.
        await db.prepare('SELECT 1').first();
});

beforeEach(async () => {
        // Each test scopes itself with a fresh memberId, so no cross-test cleanup
        // is required. Just reset the counter prefix to avoid collisions.
});

describe('rank resolution (Section B thresholds)', () => {
        it('places members in the correct rank tier', () => {
                expect(resolveRank(0).code).toBe('unknown_contact');
                expect(resolveRank(99).code).toBe('unknown_contact');
                expect(resolveRank(100).code).toBe('practitioner');
                expect(resolveRank(499).code).toBe('practitioner');
                expect(resolveRank(500).code).toBe('trained_practitioner');
                expect(resolveRank(1499).code).toBe('trained_practitioner');
                expect(resolveRank(1500).code).toBe('pressure_tested');
                expect(resolveRank(3999).code).toBe('pressure_tested');
                expect(resolveRank(4000).code).toBe('collective');
                expect(resolveRank(99999).code).toBe('collective');
        });

        it('clamps negatives and reports next-rank progress', () => {
                expect(resolveRank(-50).code).toBe('unknown_contact');

                const progress = getRankProgress(2340);
                expect(progress.rank.code).toBe('pressure_tested');
                expect(progress.nextRank?.code).toBe('collective');
                expect(progress.tpToNextRank).toBe(4000 - 2340);
                expect(progress.progressPct).toBeGreaterThan(0);
                expect(progress.progressPct).toBeLessThan(100);

                const top = getRankProgress(50000);
                expect(top.nextRank).toBeNull();
                expect(top.progressPct).toBe(100);
        });
});

describe('awardPoints — base behaviour', () => {
        it('awards the canonical TP value for a simple action', async () => {
                const member = await seedMember({});
                const result = await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'mod-1'
                });

                expect(result.reason).toBe('awarded');
                expect(result.awarded).toBe(TP_VALUES.module_complete);
                expect(result.totalTp).toBe(TP_VALUES.module_complete);
                expect(result.streak.current).toBe(1);
                expect(result.streak.longest).toBe(1);
                expect(result.newMilestones).toContain('first_module_completed');
        });

        it('is idempotent on the same (member, action, reference) tuple', async () => {
                const member = await seedMember({});
                const ref = { referenceType: 'module', referenceId: 'mod-dup' };
                const a = await awardPoints(db, { memberId: member, action: 'module_complete', ...ref });
                const b = await awardPoints(db, { memberId: member, action: 'module_complete', ...ref });

                expect(a.reason).toBe('awarded');
                expect(b.reason).toBe('duplicate');
                expect(b.awarded).toBe(0);
                expect(b.totalTp).toBe(a.totalTp);
        });
});

describe('awardPoints — daily caps', () => {
        it('clamps community_post awards to the 20 TP/day cap', async () => {
                const member = await seedMember({});
                const cap = DAILY_CAPS.community_post!;
                const baseTime = Date.parse('2026-06-01T12:00:00.000Z');

                const results = [];
                for (let i = 0; i < 5; i++) {
                        results.push(
                                await awardPoints(db, {
                                        memberId: member,
                                        action: 'community_post',
                                        referenceType: 'post',
                                        referenceId: `post-${i}`,
                                        occurredAt: baseTime + i * 1000
                                })
                        );
                }

                const awarded = results.map((r) => r.awarded);
                // First 4 awarded 5 TP each (20 total), the 5th should be capped at 0.
                expect(awarded).toEqual([5, 5, 5, 5, 0]);
                expect(results[4].reason).toBe('capped');

                const dossier = await getMemberDossier(db, member);
                expect(dossier.totalTp).toBe(cap);
        });

        it('partially clamps when remaining cap is less than the action value', async () => {
                const member = await seedMember({});
                const baseTime = Date.parse('2026-06-02T12:00:00.000Z');

                // Three posts of 5 TP each = 15 TP. Remaining cap = 5.
                for (let i = 0; i < 3; i++) {
                        await awardPoints(db, {
                                memberId: member,
                                action: 'community_post',
                                referenceType: 'post',
                                referenceId: `p-${i}`,
                                occurredAt: baseTime + i * 1000
                        });
                }
                const fourth = await awardPoints(db, {
                        memberId: member,
                        action: 'community_post',
                        referenceType: 'post',
                        referenceId: 'p-3',
                        occurredAt: baseTime + 4000
                });
                expect(fourth.awarded).toBe(5);
                expect(fourth.reason).toBe('awarded');

                // Cap is now exhausted (20 TP).
                const fifth = await awardPoints(db, {
                        memberId: member,
                        action: 'community_post',
                        referenceType: 'post',
                        referenceId: 'p-4',
                        occurredAt: baseTime + 5000
                });
                expect(fifth.reason).toBe('capped');
        });

        it('resets caps the next UTC day', async () => {
                const member = await seedMember({});
                const day1 = Date.parse('2026-06-03T23:00:00.000Z');
                const day2 = Date.parse('2026-06-04T00:30:00.000Z');

                for (let i = 0; i < 4; i++) {
                        await awardPoints(db, {
                                memberId: member,
                                action: 'community_post',
                                referenceType: 'post',
                                referenceId: `d1-${i}`,
                                occurredAt: day1 + i * 1000
                        });
                }
                const overflow = await awardPoints(db, {
                        memberId: member,
                        action: 'community_post',
                        referenceType: 'post',
                        referenceId: 'd1-4',
                        occurredAt: day1 + 5000
                });
                expect(overflow.reason).toBe('capped');

                const nextDay = await awardPoints(db, {
                        memberId: member,
                        action: 'community_post',
                        referenceType: 'post',
                        referenceId: 'd2-0',
                        occurredAt: day2
                });
                expect(nextDay.reason).toBe('awarded');
                expect(nextDay.awarded).toBe(5);
        });
});

describe('awardPoints — one-time events', () => {
        it('awards intro_post once per member', async () => {
                const member = await seedMember({});
                const a = await awardPoints(db, { memberId: member, action: 'intro_post' });
                const b = await awardPoints(db, { memberId: member, action: 'intro_post' });

                expect(a.awarded).toBe(TP_VALUES.intro_post);
                expect(b.reason).toBe('duplicate');
                expect(b.awarded).toBe(0);
        });

        it('awards profile_complete once per member', async () => {
                const member = await seedMember({});
                const a = await awardPoints(db, { memberId: member, action: 'profile_complete' });
                const b = await awardPoints(db, { memberId: member, action: 'profile_complete' });

                expect(a.awarded).toBe(TP_VALUES.profile_complete);
                expect(b.reason).toBe('duplicate');
        });

        it('treats one-time actions as per-member, regardless of differing references', async () => {
                const member = await seedMember({});

                const first = await awardPoints(db, {
                        memberId: member,
                        action: 'intro_post',
                        referenceType: 'post',
                        referenceId: 'post-A'
                });
                expect(first.awarded).toBe(TP_VALUES.intro_post);

                // A different referenceId must NOT bypass one-time semantics.
                const second = await awardPoints(db, {
                        memberId: member,
                        action: 'intro_post',
                        referenceType: 'post',
                        referenceId: 'post-B'
                });
                expect(second.reason).toBe('duplicate');
                expect(second.awarded).toBe(0);
        });
});

describe('streak rollover', () => {
        it('increments on consecutive days, resets on a gap', async () => {
                const member = await seedMember({});

                const day = (key: string, hour = 12) => Date.parse(`${key}T${String(hour).padStart(2, '0')}:00:00.000Z`);

                const r1 = await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'm1',
                        occurredAt: day('2026-06-01')
                });
                expect(r1.streak.current).toBe(1);

                const r2 = await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'm2',
                        occurredAt: day('2026-06-02')
                });
                expect(r2.streak.current).toBe(2);

                const r2b = await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'm2b',
                        occurredAt: day('2026-06-02', 18)
                });
                // Same UTC day → streak unchanged.
                expect(r2b.streak.current).toBe(2);

                // Skip 2026-06-03 — the 04 award resets the streak to 1.
                const r3 = await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'm3',
                        occurredAt: day('2026-06-04')
                });
                expect(r3.streak.current).toBe(1);
                expect(r3.streak.longest).toBe(2);
        });

        it('rolloverStreakIfStale resets the persisted streak after a missed day', async () => {
                const member = await seedMember({});
                const day1 = Date.parse('2026-08-01T12:00:00.000Z');

                await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'rollover-m1',
                        occurredAt: day1
                });

                // Same-day rollover is a no-op.
                const sameDay = await rolloverStreakIfStale(db, member, day1 + 1000);
                expect(sameDay.reset).toBe(false);
                expect(sameDay.current).toBe(1);

                // Yesterday is still in the active window — no reset.
                const nextDay = await rolloverStreakIfStale(db, member, day1 + 86400000);
                expect(nextDay.reset).toBe(false);

                // Two days later — the chain is broken, persist a 0.
                const stale = await rolloverStreakIfStale(db, member, day1 + 3 * 86400000);
                expect(stale.reset).toBe(true);
                expect(stale.current).toBe(0);

                // The dossier read also reflects 0 without any new award.
                const dossier = await getMemberDossier(db, member, { now: day1 + 3 * 86400000 });
                expect(dossier.streak.current).toBe(0);
                expect(dossier.streak.longest).toBe(1);

                // A second rollover at the same time is a no-op.
                const noop = await rolloverStreakIfStale(db, member, day1 + 3 * 86400000);
                expect(noop.reset).toBe(false);
        });

        it('reports streak as 0 when the member misses a day, even with no new award', async () => {
                const member = await seedMember({});
                const day1 = Date.parse('2026-07-01T12:00:00.000Z');
                const day2 = Date.parse('2026-07-02T12:00:00.000Z');

                await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'gap-m1',
                        occurredAt: day1
                });
                const second = await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'gap-m2',
                        occurredAt: day2
                });
                expect(second.streak.current).toBe(2);

                // Two days later — viewer reads the dossier without any new award.
                // The persisted `current_streak` is still 2, but the dossier must
                // surface 0 because the streak chain was broken on the missed day.
                const fourDaysLater = day2 + 2 * 86400000;
                const dossier = await getMemberDossier(db, member, { now: fourDaysLater });
                expect(dossier.streak.current).toBe(0);
                expect(dossier.streak.longest).toBe(2);
        });

        it('awards a 7-day streak bonus exactly once', async () => {
                const member = await seedMember({});
                const startKey = '2026-06-10';

                let last;
                for (let i = 0; i < 7; i++) {
                        const dateKey = utcDateKey(Date.parse(`${startKey}T12:00:00.000Z`) + i * 86400000);
                        last = await awardPoints(db, {
                                memberId: member,
                                action: 'module_complete',
                                referenceType: 'module',
                                referenceId: `streak-mod-${i}`,
                                occurredAt: Date.parse(`${dateKey}T12:00:00.000Z`)
                        });
                }

                expect(last!.streak.current).toBe(7);
                expect(last!.streak.hitMilestone).toBe(7);
                expect(last!.newMilestones).toContain('streak_7_day');

                // Same-day re-award does not retrigger the bonus.
                const repeat = await awardPoints(db, {
                        memberId: member,
                        action: 'community_post',
                        referenceType: 'post',
                        referenceId: 'extra-post',
                        occurredAt: Date.parse(`${utcDateKey(Date.parse(`${startKey}T12:00:00.000Z`) + 6 * 86400000)}T13:00:00.000Z`)
                });
                expect(repeat.streak.hitMilestone).toBeNull();

                // Total TP should include 7 module_completes (70) + 5 (community_post) +
                // 25 (streak bonus) = 100 → tipping into Practitioner rank.
                const dossier = await getMemberDossier(db, member);
                expect(dossier.totalTp).toBe(7 * TP_VALUES.module_complete + TP_VALUES.community_post + TP_VALUES.streak_7day_bonus);
                expect(dossier.rank.rank.code).toBe('practitioner');
        });
});

describe('milestone evaluation', () => {
        it('is idempotent — re-evaluating earned milestones never duplicates them', async () => {
                const member = await seedMember({});
                await awardPoints(db, { memberId: member, action: 'intro_post' });

                const first = await evaluateMilestones(db, member);
                const second = await evaluateMilestones(db, member);
                const third = await evaluateMilestones(db, member);

                // The award call already inserted "introduced"; subsequent evaluates
                // must not re-insert it.
                expect(first).toEqual([]);
                expect(second).toEqual([]);
                expect(third).toEqual([]);

                const dossier = await getMemberDossier(db, member);
                const introduced = dossier.milestones.find((m) => m.key === 'introduced');
                expect(introduced?.earnedAt).not.toBeNull();
        });

        it('auto-applies founding_member and vip_founding_member from entitlements', async () => {
                const bronze = await seedMember({ tier: 'bronze', entitle: 'bronze' });
                const vip = await seedMember({ tier: 'vip', entitle: 'vip' });

                const bronzeApplied = await applyEntitlementMilestones(db, bronze, 'bronze');
                expect(bronzeApplied).toContain('founding_member');
                expect(bronzeApplied).not.toContain('vip_founding_member');

                const vipApplied = await applyEntitlementMilestones(db, vip, 'vip');
                expect(vipApplied).toContain('founding_member');
                expect(vipApplied).toContain('vip_founding_member');

                // Re-applying is a no-op.
                const repeat = await applyEntitlementMilestones(db, vip, 'vip');
                expect(repeat).toEqual([]);
        });

        it('awards full_library after 11 course completes', async () => {
                const member = await seedMember({});
                let lastResult;
                for (let i = 0; i < 11; i++) {
                        lastResult = await awardPoints(db, {
                                memberId: member,
                                action: 'course_complete',
                                referenceType: 'course',
                                referenceId: `course-${i}`
                        });
                }
                expect(lastResult!.newMilestones).toContain('full_library');

                const dossier = await getMemberDossier(db, member);
                const earned = new Set(
                        dossier.milestones.filter((m) => m.earnedAt !== null).map((m) => m.key)
                );
                expect(earned.has('first_course_completed')).toBe(true);
                expect(earned.has('five_courses_completed')).toBe(true);
                expect(earned.has('full_library')).toBe(true);
        });
});

describe('dossier activity window', () => {
        it('windows recent activity to the last 30 days by default', async () => {
                const member = await seedMember({});
                const now = Date.parse('2026-09-30T12:00:00.000Z');

                // Old award — 45 days ago, should fall outside the window.
                await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'window-old',
                        occurredAt: now - 45 * 86400000
                });
                // Recent award — 5 days ago, inside the window.
                await awardPoints(db, {
                        memberId: member,
                        action: 'module_complete',
                        referenceType: 'module',
                        referenceId: 'window-new',
                        occurredAt: now - 5 * 86400000
                });

                const dossier = await getMemberDossier(db, member, { now });
                const refs = dossier.recentActivity
                        .map((a) => a.referenceId)
                        .filter((r): r is string => r !== null);
                expect(refs).toContain('window-new');
                expect(refs).not.toContain('window-old');

                // Disable the window — both should now appear.
                const full = await getMemberDossier(db, member, {
                        now,
                        activityWindowDays: null
                });
                const fullRefs = full.recentActivity
                        .map((a) => a.referenceId)
                        .filter((r): r is string => r !== null);
                expect(fullRefs).toContain('window-old');
                expect(fullRefs).toContain('window-new');
        });
});

describe('leaderboard read API', () => {
        it('only includes opted-in members and highlights the viewer', async () => {
                const a = await seedMember({ name: 'Alpha' });
                const b = await seedMember({ name: 'Bravo' });
                const c = await seedMember({ name: 'Charlie' });

                // a has the most TP, b is mid, c has lots but is NOT opted in.
                await awardPoints(db, { memberId: a, action: 'live_session_attend', referenceType: 'event', referenceId: 'e1' });
                await awardPoints(db, { memberId: a, action: 'live_session_attend', referenceType: 'event', referenceId: 'e2' });
                await awardPoints(db, { memberId: b, action: 'live_session_attend', referenceType: 'event', referenceId: 'e3' });
                await awardPoints(db, { memberId: c, action: 'course_complete', referenceType: 'course', referenceId: 'cx' });

                await setLeaderboardOptIn(db, a, true);
                await setLeaderboardOptIn(db, b, true);
                // c stays opted out.

                const board = await getLeaderboard(db, { scope: 'all_time', viewerId: b });
                const ids = board.entries.map((e) => e.memberId);

                expect(ids).toContain(a);
                expect(ids).toContain(b);
                expect(ids).not.toContain(c);

                expect(board.entries[0].memberId).toBe(a);
                expect(board.viewer?.memberId).toBe(b);
                expect(board.viewer?.isViewer).toBe(true);
        });
});

describe('getMemberTrainingStats', () => {
        it('counts course_complete and live_session_attend actions', async () => {
                const { getMemberTrainingStats } = await import('./db/shivworks');
                const m = await seedMember({ name: 'Trainer' });
                await awardPoints(db, { memberId: m, action: 'course_complete', referenceType: 'course', referenceId: 'c1' });
                await awardPoints(db, { memberId: m, action: 'course_complete', referenceType: 'course', referenceId: 'c2' });
                await awardPoints(db, { memberId: m, action: 'live_session_attend', referenceType: 'event', referenceId: 'e1' });
                await awardPoints(db, { memberId: m, action: 'community_post', referenceType: 'thread', referenceId: 't1' });

                const stats = await getMemberTrainingStats(db, m);
                expect(stats.coursesCompleted).toBe(2);
                expect(stats.liveSessionsAttended).toBe(1);
        });

        it('returns zeros when member has no training points', async () => {
                const { getMemberTrainingStats } = await import('./db/shivworks');
                const m = await seedMember({ name: 'Empty' });
                const stats = await getMemberTrainingStats(db, m);
                expect(stats).toEqual({ coursesCompleted: 0, liveSessionsAttended: 0 });
        });
});

describe('listFinderCandidates', () => {
        it('filters by state, ECQC, background and excludes the viewer + opted-out', async () => {
                const { listFinderCandidates, upsertMemberProfile } = await import('./db/shivworks');
                const viewer = await seedMember({ name: 'View Er' });
                const inTx = await seedMember({ name: 'Tex Ranger' });
                const inCa = await seedMember({ name: 'Cal Surfer' });
                const optOut = await seedMember({ name: 'Hide Mode' });
                const free = await seedMember({ name: 'Free Tier', tier: 'free', accessStatus: 'none' });

                await upsertMemberProfile(db, viewer, {
                        locationCity: 'Houston', locationState: 'TX',
                        background: { lawEnforcement: true }, ecqcAlumni: true,
                        trainingGoal: 'sharpen ecqc', showInFinder: true
                });
                await upsertMemberProfile(db, inTx, {
                        locationCity: 'Austin', locationState: 'TX',
                        background: { civilian: true }, ecqcAlumni: true,
                        trainingGoal: 'defensive carry', showInFinder: true
                });
                await upsertMemberProfile(db, inCa, {
                        locationCity: 'San Diego', locationState: 'CA',
                        background: { military: true }, ecqcAlumni: false,
                        trainingGoal: 'fitness', showInFinder: true
                });
                await upsertMemberProfile(db, optOut, {
                        locationCity: 'Dallas', locationState: 'TX',
                        background: { civilian: true }, ecqcAlumni: true,
                        trainingGoal: 'private', showInFinder: false
                });
                await upsertMemberProfile(db, free, {
                        locationCity: 'Austin', locationState: 'TX',
                        background: { civilian: true }, ecqcAlumni: true,
                        trainingGoal: 'free', showInFinder: true
                });

                const tx = await listFinderCandidates(db, viewer, { state: 'TX', ecqcOnly: true });
                const txIds = tx.map((c) => c.member.clerkUserId);
                expect(txIds).toContain(inTx);
                expect(txIds).not.toContain(viewer);
                expect(txIds).not.toContain(inCa);
                expect(txIds).not.toContain(optOut);
                expect(txIds).not.toContain(free);

                const goalMatch = await listFinderCandidates(db, viewer, { goalQuery: 'fitness' });
                expect(goalMatch.map((c) => c.member.clerkUserId)).toEqual([inCa]);

                const cityMatch = await listFinderCandidates(db, viewer, {
                        state: 'TX', cityQuery: 'aust'
                });
                expect(cityMatch.map((c) => c.member.clerkUserId)).toEqual([inTx]);

                const military = await listFinderCandidates(db, viewer, {
                        backgrounds: ['military']
                });
                expect(military.map((c) => c.member.clerkUserId)).toContain(inCa);
                expect(military.map((c) => c.member.clerkUserId)).not.toContain(inTx);
        });
});
