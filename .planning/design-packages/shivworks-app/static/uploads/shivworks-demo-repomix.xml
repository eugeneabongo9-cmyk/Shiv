import type { D1Compat } from '$lib/server/d1-compat';
import {
        getChannelBySlug,
        getMemberProfile,
        getOnboardingChecklistProgress,
        hasMessageInChannelByAuthor,
        upsertOnboardingChecklistProgress
} from '$lib/server/db/shivworks';
import { awardPoints } from '$lib/server/gamification';

export type ChecklistItemKey =
        | 'profile'
        | 'introduce'
        | 'first_module'
        | 'rsvp_live'
        | 'weekly_question';

export interface ChecklistItem {
        key: ChecklistItemKey;
        label: string;
        href: string;
        complete: boolean;
}

export interface OnboardingChecklistState {
        visible: boolean;
        completed: boolean;
        dismissed: boolean;
        items: ChecklistItem[];
        completedCount: number;
        totalCount: number;
}

/**
 * Compute the 5-step onboarding checklist for the dashboard. Reads existing
 * signals (profile, training-point events, weekly-question messages) so the
 * checklist always reflects reality without requiring every action surface
 * to upsert into the dedicated table.
 *
 * The dedicated `onboarding_checklist_progress` row only persists the two
 * terminal states (completed/dismissed) plus per-step timestamps for
 * auditability. Item completion itself is derived.
 */
/**
 * Window during which a brand-new member sees the onboarding checklist
 * automatically. After this window, they only see it if they have an in-flight
 * progress row (i.e. they started it within the window and haven't finished
 * or dismissed yet). This prevents legacy members from suddenly seeing the
 * checklist when this feature ships.
 */
export const FIRST_TIME_WINDOW_MS = 30 * 24 * 60 * 60 * 1000;

export async function computeOnboardingChecklist(
        db: D1Compat,
        memberId: string,
        options: { memberCreatedAt?: number; now?: number } = {}
): Promise<OnboardingChecklistState> {
        const [progress, profile] = await Promise.all([
                getOnboardingChecklistProgress(db, memberId),
                getMemberProfile(db, memberId)
        ]);

        const profileComplete = !!(profile?.profileCompletedAt) || !!progress?.profileCompletedAt;

        const tpRows = await db
                .prepare(
                        `SELECT action_type FROM member_training_points
                         WHERE member_id = ?
                           AND action_type IN ('intro_post','module_complete','live_session_rsvp')
                         GROUP BY action_type`
                )
                .bind(memberId)
                .all<{ action_type: string }>();
        const tpActions = new Set(tpRows.results.map((r) => String(r.action_type)));

        const introduced = tpActions.has('intro_post') || !!progress?.introducedAt;
        const firstModule = tpActions.has('module_complete') || !!progress?.firstModuleAt;
        const rsvped = tpActions.has('live_session_rsvp') || !!progress?.firstRsvpAt;

        let weeklyQuestionPosted = !!progress?.weeklyQuestionAt;
        if (!weeklyQuestionPosted) {
                const channel = await getChannelBySlug(db, 'weekly-question');
                if (channel) {
                        weeklyQuestionPosted = await hasMessageInChannelByAuthor(db, channel.id, memberId);
                }
        }

        const items: ChecklistItem[] = [
                {
                        key: 'profile',
                        label: 'Complete your training profile',
                        href: '/account?welcome=1',
                        complete: profileComplete
                },
                {
                        key: 'introduce',
                        label: 'Introduce yourself in the community',
                        href: '/community',
                        complete: introduced
                },
                {
                        key: 'first_module',
                        label: 'Watch your first module',
                        href: '/library',
                        complete: firstModule
                },
                {
                        key: 'rsvp_live',
                        label: 'RSVP to the next live session',
                        href: '/live',
                        complete: rsvped
                },
                {
                        key: 'weekly_question',
                        label: 'Reply to this week\u2019s question',
                        href: '/community',
                        complete: weeklyQuestionPosted
                }
        ];

        const completedCount = items.filter((i) => i.complete).length;
        const totalCount = items.length;
        const completed = !!progress?.completedAt;
        const dismissed = !!progress?.dismissedAt;

        // Opportunistically persist per-item timestamps + create the progress row
        // the first time we observe any item complete. This guarantees in-flight
        // continuity past the first-time window (the row's existence keeps the
        // checklist visible) without coupling every action surface to onboarding.
        if (!completed && !dismissed && completedCount > 0) {
                const stamp = options.now ?? Date.now();
                const patch: Record<string, number> = {};
                if (profileComplete && !progress?.profileCompletedAt) patch.profileCompletedAt = stamp;
                if (introduced && !progress?.introducedAt) patch.introducedAt = stamp;
                if (firstModule && !progress?.firstModuleAt) patch.firstModuleAt = stamp;
                if (rsvped && !progress?.firstRsvpAt) patch.firstRsvpAt = stamp;
                if (weeklyQuestionPosted && !progress?.weeklyQuestionAt) patch.weeklyQuestionAt = stamp;
                if (!progress || Object.keys(patch).length > 0) {
                        await upsertOnboardingChecklistProgress(db, memberId, patch);
                }
        }

        // First-time gating: a member sees the checklist if they are within their
        // first-time window OR they have already started filling out the dedicated
        // progress row. Legacy members past the window with no progress row never
        // see it.
        const now = options.now ?? Date.now();
        const withinFirstTimeWindow =
                typeof options.memberCreatedAt === 'number'
                        ? now - options.memberCreatedAt <= FIRST_TIME_WINDOW_MS
                        : true;
        const hasProgressRow = !!progress;
        const isFirstTimeMember = withinFirstTimeWindow || hasProgressRow;
        const visible = isFirstTimeMember && !completed && !dismissed;

        return {
                visible,
                completed,
                dismissed,
                items,
                completedCount,
                totalCount
        };
}

/**
 * Finalize the checklist when all 5 items are complete. Idempotent — calling
 * twice awards the 50 TP only once (handled by the engine's one-time dedupe).
 *
 * Returns the resulting state for client UI updates.
 */
export async function finalizeOnboardingIfReady(
        db: D1Compat,
        memberId: string,
        options: { memberCreatedAt?: number; now?: number } = {}
): Promise<{ awarded: number; state: OnboardingChecklistState; eligible: boolean }> {
        const state = await computeOnboardingChecklist(db, memberId, options);
        // Refuse if the member is not first-time eligible (already completed,
        // dismissed, or past the first-time window with no in-flight progress).
        if (!state.visible) {
                return { awarded: 0, state, eligible: false };
        }
        if (state.completedCount < state.totalCount) {
                return { awarded: 0, state, eligible: true };
        }
        const award = await awardPoints(db, {
                memberId,
                action: 'onboarding_checklist_complete'
        });
        await upsertOnboardingChecklistProgress(db, memberId, {
                completedAt: Date.now()
        });
        const finalState = await computeOnboardingChecklist(db, memberId, options);
        return { awarded: award.awarded, state: finalState, eligible: true };
}

export async function dismissOnboardingChecklist(
        db: D1Compat,
        memberId: string,
        options: { memberCreatedAt?: number; now?: number } = {}
): Promise<{ state: OnboardingChecklistState; eligible: boolean }> {
        const before = await computeOnboardingChecklist(db, memberId, options);
        if (!before.visible) {
                return { state: before, eligible: false };
        }
        await upsertOnboardingChecklistProgress(db, memberId, { dismissedAt: Date.now() });
        const after = await computeOnboardingChecklist(db, memberId, options);
        return { state: after, eligible: true };
}
