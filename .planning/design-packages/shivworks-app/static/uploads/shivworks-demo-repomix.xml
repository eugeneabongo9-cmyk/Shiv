<file path="src/lib/components/CustomVideoPlayer.svelte">
<script lang="ts">
        import { onDestroy } from 'svelte';
        import {
                Play,
                Pause,
                Volume2,
                VolumeX,
                Maximize,
                Minimize,
                PictureInPicture
        } from 'lucide-svelte';

        interface Props {
                src: string;
                captionUrl?: string;
                poster?: string;
                initialSeconds?: number;
                onTimeUpdate?: (currentSeconds: number, durationSeconds: number | null) => void;
                onPause?: (currentSeconds: number, durationSeconds: number | null) => void;
                onLoadedMetadata?: (durationSeconds: number | null) => void;
                onEnded?: (durationSeconds: number | null) => void;
        }

        let {
                src,
                captionUrl,
                poster,
                initialSeconds = 0,
                onTimeUpdate,
                onPause,
                onLoadedMetadata,
                onEnded
        }: Props = $props();

        const SPEEDS = [0.75, 1, 1.25, 1.5, 2] as const;

        let videoElement = $state<HTMLVideoElement | null>(null);
        let containerElement = $state<HTMLDivElement | null>(null);
        let isPlaying = $state(false);
        let currentTime = $state(0);
        let duration = $state(0);
        let volume = $state(1);
        let muted = $state(false);
        let speed = $state<number>(1);
        let speedMenuOpen = $state(false);
        let isFullscreen = $state(false);
        let pipSupported = $state(false);
        let inPip = $state(false);
        let controlsVisible = $state(true);
        let restored = false;
        let hideTimer: ReturnType<typeof setTimeout> | null = null;

        $effect(() => {
                if (typeof document !== 'undefined' && 'pictureInPictureEnabled' in document) {
                        pipSupported = (document as Document & { pictureInPictureEnabled?: boolean })
                                .pictureInPictureEnabled === true;
                }
        });

        $effect(() => {
                // Reset restoration when src changes
                void src;
                restored = false;
        });

        $effect(() => {
                const el = videoElement;
                if (!el) return;
                const onEnter = () => (inPip = true);
                const onLeave = () => (inPip = false);
                el.addEventListener('enterpictureinpicture', onEnter);
                el.addEventListener('leavepictureinpicture', onLeave);
                return () => {
                        el.removeEventListener('enterpictureinpicture', onEnter);
                        el.removeEventListener('leavepictureinpicture', onLeave);
                };
        });

        function togglePlay() {
                if (!videoElement) return;
                if (videoElement.paused) {
                        void videoElement.play();
                } else {
                        videoElement.pause();
                }
        }

        function handlePlayState() {
                if (!videoElement) return;
                isPlaying = !videoElement.paused;
                if (isPlaying) scheduleHide();
                else showControls();
        }

        function handleLoadedMetadata() {
                if (!videoElement) return;
                duration = Number.isFinite(videoElement.duration) ? videoElement.duration : 0;
                if (!restored && initialSeconds > 0 && duration > 0 && initialSeconds < duration - 4) {
                        videoElement.currentTime = initialSeconds;
                }
                restored = true;
                onLoadedMetadata?.(duration || null);
        }

        function handleTimeUpdate() {
                if (!videoElement) return;
                currentTime = videoElement.currentTime;
                onTimeUpdate?.(currentTime, duration || null);
        }

        function handlePauseEvent() {
                if (!videoElement) return;
                isPlaying = false;
                onPause?.(videoElement.currentTime, duration || null);
                showControls();
        }

        function handleEndedEvent() {
                isPlaying = false;
                onEnded?.(duration || null);
                showControls();
        }

        function handleVolumeChange() {
                if (!videoElement) return;
                volume = videoElement.volume;
                muted = videoElement.muted;
        }

        function onScrub(event: Event) {
                const target = event.target as HTMLInputElement;
                const next = Number(target.value);
                if (videoElement && Number.isFinite(next)) {
                        videoElement.currentTime = next;
                        currentTime = next;
                }
        }

        function onVolume(event: Event) {
                const target = event.target as HTMLInputElement;
                const next = Number(target.value);
                if (videoElement && Number.isFinite(next)) {
                        videoElement.volume = next;
                        videoElement.muted = next === 0;
                }
        }

        function toggleMute() {
                if (!videoElement) return;
                videoElement.muted = !videoElement.muted;
        }

        function setSpeed(value: number) {
                if (!videoElement) return;
                videoElement.playbackRate = value;
                speed = value;
                speedMenuOpen = false;
        }

        async function toggleFullscreen() {
                if (!containerElement) return;
                if (document.fullscreenElement) {
                        await document.exitFullscreen();
                } else {
                        await containerElement.requestFullscreen();
                }
        }

        function handleFullscreenChange() {
                isFullscreen = document.fullscreenElement === containerElement;
        }

        async function togglePip() {
                if (!videoElement || !pipSupported) return;
                const doc = document as Document & { pictureInPictureElement?: Element | null };
                const vid = videoElement as HTMLVideoElement & {
                        requestPictureInPicture?: () => Promise<PictureInPictureWindow>;
                };
                try {
                        if (doc.pictureInPictureElement) {
                                await (document as Document & { exitPictureInPicture?: () => Promise<void> }).exitPictureInPicture?.();
                                inPip = false;
                        } else if (vid.requestPictureInPicture) {
                                await vid.requestPictureInPicture();
                                inPip = true;
                        }
                } catch (err) {
                        console.error('PiP failed', err);
                }
        }

        function showControls() {
                controlsVisible = true;
                if (hideTimer) {
                        clearTimeout(hideTimer);
                        hideTimer = null;
                }
                if (isPlaying) scheduleHide();
        }

        function scheduleHide() {
                if (hideTimer) clearTimeout(hideTimer);
                hideTimer = setTimeout(() => {
                        if (isPlaying && !speedMenuOpen) controlsVisible = false;
                }, 2800);
        }

        function handleMouseLeave() {
                if (isPlaying) controlsVisible = false;
        }

        function formatTime(seconds: number): string {
                if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
                const total = Math.floor(seconds);
                const h = Math.floor(total / 3600);
                const m = Math.floor((total % 3600) / 60);
                const s = total % 60;
                const mm = h > 0 ? m.toString().padStart(2, '0') : m.toString();
                const ss = s.toString().padStart(2, '0');
                return h > 0 ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
        }

        function handleKeydown(event: KeyboardEvent) {
                if (!videoElement) return;
                const target = event.target as HTMLElement;
                if (target.tagName === 'INPUT' || target.tagName === 'BUTTON') return;
                if (event.key === ' ' || event.key === 'k') {
                        event.preventDefault();
                        togglePlay();
                } else if (event.key === 'f') {
                        event.preventDefault();
                        void toggleFullscreen();
                } else if (event.key === 'm') {
                        event.preventDefault();
                        toggleMute();
                }
        }

        onDestroy(() => {
                if (hideTimer) clearTimeout(hideTimer);
        });
</script>

<svelte:document onfullscreenchange={handleFullscreenChange} />

<div
        class="player"
        class:fullscreen={isFullscreen}
        class:controls-hidden={!controlsVisible}
        bind:this={containerElement}
        onmousemove={showControls}
        onmouseleave={handleMouseLeave}
        onkeydown={handleKeydown}
        role="region"
        aria-label="Video player"
        tabindex="-1"
>
        <!-- svelte-ignore a11y_media_has_caption -->
        <video
                class="video"
                {src}
                {poster}
                bind:this={videoElement}
                preload="metadata"
                playsinline
                onclick={togglePlay}
                onplay={handlePlayState}
                onpause={handlePauseEvent}
                onended={handleEndedEvent}
                onloadedmetadata={handleLoadedMetadata}
                ontimeupdate={handleTimeUpdate}
                onvolumechange={handleVolumeChange}
        >
                {#if captionUrl}
                        <track kind="captions" src={captionUrl} srclang="en" label="English captions" default />
                {/if}
        </video>

        {#if !isPlaying}
                <button class="big-play" onclick={togglePlay} aria-label="Play video" type="button">
                        <Play size={42} fill="currentColor" />
                </button>
        {/if}

        <div class="controls" aria-hidden={!controlsVisible}>
                <input
                        class="scrubber"
                        type="range"
                        min="0"
                        max={duration || 0}
                        step="0.1"
                        value={currentTime}
                        oninput={onScrub}
                        aria-label="Seek"
                />

                <div class="controls-row">
                        <button class="ctrl-btn" onclick={togglePlay} aria-label={isPlaying ? 'Pause' : 'Play'} type="button">
                                {#if isPlaying}
                                        <Pause size={20} fill="currentColor" />
                                {:else}
                                        <Play size={20} fill="currentColor" />
                                {/if}
                        </button>

                        <div class="volume">
                                <button class="ctrl-btn" onclick={toggleMute} aria-label={muted ? 'Unmute' : 'Mute'} type="button">
                                        {#if muted || volume === 0}
                                                <VolumeX size={20} />
                                        {:else}
                                                <Volume2 size={20} />
                                        {/if}
                                </button>
                                <input
                                        class="volume-slider"
                                        type="range"
                                        min="0"
                                        max="1"
                                        step="0.05"
                                        value={muted ? 0 : volume}
                                        oninput={onVolume}
                                        aria-label="Volume"
                                />
                        </div>

                        <span class="time-display">
                                {formatTime(currentTime)} / {formatTime(duration)}
                        </span>

                        <div class="spacer"></div>

                        <div class="speed">
                                <button
                                        class="ctrl-btn speed-btn"
                                        onclick={() => (speedMenuOpen = !speedMenuOpen)}
                                        aria-haspopup="menu"
                                        aria-expanded={speedMenuOpen}
                                        type="button"
                                >
                                        {speed}×
                                </button>
                                {#if speedMenuOpen}
                                        <div class="speed-menu" role="menu">
                                                {#each SPEEDS as option}
                                                        <button
                                                                class="speed-option"
                                                                class:active={option === speed}
                                                                onclick={() => setSpeed(option)}
                                                                role="menuitemradio"
                                                                aria-checked={option === speed}
                                                                type="button"
                                                        >
                                                                {option}×
                                                        </button>
                                                {/each}
                                        </div>
                                {/if}
                        </div>

                        {#if pipSupported}
                                <button class="ctrl-btn" onclick={togglePip} aria-label="Picture in picture" type="button">
                                        <PictureInPicture size={20} />
                                </button>
                        {/if}

                        <button
                                class="ctrl-btn"
                                onclick={toggleFullscreen}
                                aria-label={isFullscreen ? 'Exit fullscreen' : 'Fullscreen'}
                                type="button"
                        >
                                {#if isFullscreen}
                                        <Minimize size={20} />
                                {:else}
                                        <Maximize size={20} />
                                {/if}
                        </button>
                </div>
        </div>
</div>

