import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { listChannelMessages, listChannels } from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import {
	presentMessages,
	reorderChannelsForBrief
} from '$lib/server/community-presenter';

const FEED_LIMIT = 60;

export const load: PageServerLoad = async ({ locals, platform }) => {
	const user = requirePaidMember(locals, '/community');
	const db = getDBFromPlatform(platform);
	const all = await listChannels(db);
	const visibleEntries = all
		.map((c) => ({ channel: c, permissions: permissionsFor(user, c) }))
		.filter((e) => e.permissions.canRead)
		.map(({ channel, permissions }) => ({
			...channel,
			canPostTopLevel: permissions.canPostTopLevel,
			canPostReply: permissions.canPostReply
		}));

	const groups = reorderChannelsForBrief(visibleEntries);
	const channelMap = new Map(visibleEntries.map((c) => [c.id, c] as const));

	const perChannel = await Promise.all(
		visibleEntries.map((c) =>
			listChannelMessages(db, c.id, { limit: FEED_LIMIT })
		)
	);
	const merged = perChannel
		.flat()
		.sort((a, b) => b.createdAt - a.createdAt)
		.slice(0, FEED_LIMIT);
	const presented = await presentMessages(db, merged, user);
	const items = presented.map((m) => {
		const ch = channelMap.get(m.channelId);
		return {
			...m,
			channel: ch
				? { id: ch.id, slug: ch.slug, name: ch.name, category: ch.category }
				: null
		};
	});

	return {
		viewer: {
			clerkUserId: user.clerkUserId,
			name: user.name,
			tier: user.tier,
			role: user.role
		},
		channelGroups: groups,
		feed: items
	};
};
