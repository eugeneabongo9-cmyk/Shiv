import { error } from '@sveltejs/kit';
import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { requirePaidMember } from '$lib/server/guards';
import {
        countUnreadDirectMessages,
        getMemberByClerkId,
        listDirectMessageThread,
        markDirectMessagesRead
} from '$lib/server/db/shivworks';
import { publish, userTopic } from '$lib/server/realtime';

export const load: PageServerLoad = async ({ locals, platform, params }) => {
        const user = requirePaidMember(locals, `/messages/${params.partnerId}`);
        const partnerId = params.partnerId;
        if (!partnerId || partnerId === user.clerkUserId) {
                error(400, 'Invalid conversation partner');
        }
        const db = getDBFromPlatform(platform);
        const partner = await getMemberByClerkId(db, partnerId);
        if (!partner) error(404, 'Member not found');

        const messages = await listDirectMessageThread(db, user.clerkUserId, partnerId, 100);
        messages.reverse();

        // Mark inbound messages as read on load and broadcast a read receipt
        // so the in-page DmListener (and any other open tabs) immediately
        // clears the unread badge — layout load already ran with the stale
        // count when the user navigated here.
        await markDirectMessagesRead(db, user.clerkUserId, partnerId);
        const unreadTotal = await countUnreadDirectMessages(db, user.clerkUserId);
        publish(userTopic(user.clerkUserId), 'dm.created', {
                readReceipt: { partnerId, unreadTotal }
        });

        return {
                viewer: {
                        clerkUserId: user.clerkUserId,
                        name: user.name,
                        tier: user.tier
                },
                partner: {
                        clerkUserId: partner.clerkUserId,
                        name: partner.name,
                        tier: partner.tier
                },
                messages
        };
};
</file>

