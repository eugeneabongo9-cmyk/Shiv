import { error, json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { getMessageById, listChannels, setMessagePinned } from '$lib/server/db/shivworks';
import { requirePaidMember } from '$lib/server/guards';
import { permissionsFor } from '$lib/server/community-access';
import { channelTopic, publish } from '$lib/server/realtime';

async function toggle(pinned: boolean, params: { messageId: string }, locals: App.Locals, platform: App.Platform | undefined) {
        const user = requirePaidMember(locals, '/community');
        if (user.role !== 'admin') error(403, 'Admin only');
        const db = getDBFromPlatform(platform);
        const message = await getMessageById(db, params.messageId);
        if (!message || message.deletedAt) error(404, 'Message not found');
        const channels = await listChannels(db);
        const channel = channels.find((c) => c.id === message.channelId);
        if (!channel) error(404, 'Channel not found');
        if (!permissionsFor(user, channel).canRead) error(403, 'Channel access denied');

        await setMessagePinned(db, message.id, pinned);
        publish(channelTopic(channel.id), 'message.pinned', {
                messageId: message.id,
                channelId: channel.id,
                pinned
        });
        return json({ pinned });
}

export const POST: RequestHandler = ({ params, locals, platform }) =>
        toggle(true, params as { messageId: string }, locals, platform);

export const DELETE: RequestHandler = ({ params, locals, platform }) =>
        toggle(false, params as { messageId: string }, locals, platform);
