<file path="src/lib/server/admin-analytics.ts">
import type { D1Compat } from '$lib/server/d1-compat';
import { enqueueInAppNotification } from '$lib/server/in-app-notifications';

const DAY_MS = 24 * 60 * 60 * 1000;
const WEEK_MS = 7 * DAY_MS;
const MONTH_MS = 30 * DAY_MS;
export const REENGAGEMENT_INACTIVITY_DAYS = 14;

function dayKey(ts: number): string {
        return new Date(ts).toISOString().slice(0, 10);
}

/**
 * Best signal of "active on the platform": latest of any TP-awarding action
 * (member_training_points.created_at) or any session ping
 * (member_sessions.last_active_at). Returns 0 when never active.
 */
interface MemberActivityRow {
        id: string;
        createdAt: number;
        lastActive: number;
}

async function listMemberActivity(db: D1Compat): Promise<MemberActivityRow[]> {
        // Restrict to the paid-active cohort so DAU/WAU/MAU numerators match
        // the denominator used by getEngagementMetrics(). Carries created_at
        // so retention can flag never-active accounts older than the threshold.
        const rows = await db
                .prepare(
                        `SELECT m.clerk_user_id AS id,
                                m.created_at AS created_at,
                                MAX(COALESCE(tp.last_tp, 0), COALESCE(s.last_session, 0)) AS last_active
                         FROM members m
                         LEFT JOIN (
                                SELECT member_id, MAX(created_at) AS last_tp
                                FROM member_training_points
                                GROUP BY member_id
                         ) tp ON tp.member_id = m.clerk_user_id
                         LEFT JOIN (
                                SELECT member_id, MAX(last_active_at) AS last_session
                                FROM member_sessions
                                GROUP BY member_id
                         ) s ON s.member_id = m.clerk_user_id
                         WHERE m.access_status = 'active' AND m.tier IN ('bronze','vip')`
                )
                .all<{ id: string; created_at: number | null; last_active: number | null }>();
        return rows.results.map((r) => ({
                id: String(r.id),
                createdAt: Number(r.created_at || 0),
                lastActive: Number(r.last_active || 0)
        }));
}

async function listMemberLastActive(db: D1Compat): Promise<Map<string, number>> {
        const map = new Map<string, number>();
        for (const r of await listMemberActivity(db)) {
                map.set(r.id, r.lastActive);
        }
        return map;
}

// ---- Engagement -------------------------------------------------------------

export interface EngagementMetrics {
        dau: number;
        wau: number;
        mau: number;
        dauPct: number;
        wauPct: number;
        topContributors: Array<{ memberId: string; name: string; tp: number }>;
        topChannels: Array<{ channelId: string; name: string; messageCount: number }>;
        topModules: Array<{ moduleId: string; courseTitle: string; moduleTitle: string; views: number }>;
        topCourses: Array<{ courseId: string; title: string; views: number }>;
}

export async function getEngagementMetrics(
        db: D1Compat,
        now: number = Date.now()
): Promise<EngagementMetrics> {
        const totalRow = await db
                .prepare(
                        `SELECT COUNT(*) AS n FROM members
                         WHERE access_status = 'active' AND tier IN ('bronze','vip')`
                )
                .first<{ n: number | string }>();
        const totalActive = Math.max(1, Number(totalRow?.n ?? 0));

        const lastActive = await listMemberLastActive(db);
        let dau = 0;
        let wau = 0;
        let mau = 0;
        for (const ts of lastActive.values()) {
                if (!ts) continue;
                const age = now - ts;
                if (age <= DAY_MS) dau += 1;
                if (age <= WEEK_MS) wau += 1;
                if (age <= MONTH_MS) mau += 1;
        }

        const monthStart = (() => {
                const d = new Date(now);
                return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1);
        })();
        const contribRows = await db
                .prepare(
                        `SELECT tp.member_id AS id, m.name AS name, SUM(tp.points_awarded) AS tp
                         FROM member_training_points tp
                         JOIN members m ON m.clerk_user_id = tp.member_id
                         WHERE tp.created_at >= ?
                         GROUP BY tp.member_id, m.name
                         ORDER BY tp DESC
                         LIMIT 10`
                )
                .bind(monthStart)
                .all<{ id: string; name: string; tp: number | string }>();
        const topContributors = contribRows.results.map((r) => ({
                memberId: String(r.id),
                name: String(r.name || 'Member'),
                tp: Number(r.tp || 0)
        }));

        const channelRows = await db
                .prepare(
                        `SELECT msg.channel_id AS id, c.name AS name, COUNT(*) AS n
                         FROM messages msg
                         JOIN channels c ON c.id = msg.channel_id
                         WHERE msg.deleted_at IS NULL AND msg.created_at >= ?
                         GROUP BY msg.channel_id, c.name
                         ORDER BY n DESC
                         LIMIT 5`
                )
                .bind(now - MONTH_MS)
                .all<{ id: string; name: string; n: number | string }>();
        const topChannels = channelRows.results.map((r) => ({
                channelId: String(r.id),
                name: String(r.name || 'channel'),
                messageCount: Number(r.n || 0)
        }));

        const moduleRows = await db
                .prepare(
                        `SELECT mp.module_id AS id, cm.title AS module_title, c.title AS course_title,
                                COUNT(*) AS n
                         FROM member_module_progress mp
                         JOIN course_modules cm ON cm.id = mp.module_id
                         JOIN courses c ON c.id = cm.course_id
                         WHERE mp.updated_at >= ?
                         GROUP BY mp.module_id, cm.title, c.title
                         ORDER BY n DESC
                         LIMIT 5`
                )
                .bind(now - MONTH_MS)
                .all<{ id: string; module_title: string; course_title: string; n: number | string }>();
        const topModules = moduleRows.results.map((r) => ({
                moduleId: String(r.id),
                courseTitle: String(r.course_title || ''),
                moduleTitle: String(r.module_title || ''),
                views: Number(r.n || 0)
        }));

        const courseRows = await db
                .prepare(
                        `SELECT c.id AS id, c.title AS title, COUNT(*) AS n
                         FROM member_module_progress mp
                         JOIN course_modules cm ON cm.id = mp.module_id
                         JOIN courses c ON c.id = cm.course_id
                         WHERE mp.updated_at >= ?
                         GROUP BY c.id, c.title
                         ORDER BY n DESC
                         LIMIT 5`
                )
                .bind(now - MONTH_MS)
                .all<{ id: string; title: string; n: number | string }>();
        const topCourses = courseRows.results.map((r) => ({
                courseId: String(r.id),
                title: String(r.title || ''),
                views: Number(r.n || 0)
        }));

        return {
                dau,
                wau,
                mau,
                dauPct: Math.round((dau / totalActive) * 1000) / 10,
                wauPct: Math.round((wau / totalActive) * 1000) / 10,
                topContributors,
                topChannels,
                topModules,
                topCourses
        };
}

// ---- Retention --------------------------------------------------------------

export interface InactiveMember {
        memberId: string;
        name: string;
        email: string;
        tier: string | null;
        lastActiveAt: number;
        daysInactive: number;
}

export interface RetentionMetrics {
        inactive: InactiveMember[];
        avgStreak: number;
        milestoneCompletion: Array<{ key: string; count: number; rate: number }>;
        milestoneEligibleTotal: number;
}

export async function listInactiveMembers(
        db: D1Compat,
        thresholdDays = REENGAGEMENT_INACTIVITY_DAYS,
        now: number = Date.now()
): Promise<InactiveMember[]> {
        const activity = await listMemberActivity(db);
        const cutoff = now - thresholdDays * DAY_MS;
        const ids: string[] = [];
        const tsById = new Map<string, number>();
        for (const row of activity) {
                // Last "active" signal: most recent activity, or fallback to
                // account creation so never-active accounts still surface once
                // they cross the inactivity threshold.
                const reference = row.lastActive > 0 ? row.lastActive : row.createdAt;
                if (reference === 0 || reference > cutoff) continue;
                ids.push(row.id);
                tsById.set(row.id, reference);
        }
        if (ids.length === 0) return [];
        const placeholders = ids.map(() => '?').join(',');
        const rows = await db
                .prepare(
                        `SELECT clerk_user_id AS id, name, email, tier
                         FROM members
                         WHERE clerk_user_id IN (${placeholders})
                           AND access_status = 'active' AND tier IN ('bronze','vip')`
                )
                .bind(...ids)
                .all<{ id: string; name: string; email: string; tier: string | null }>();
        return rows.results
                .map((r) => {
                        const ts = tsById.get(String(r.id)) || 0;
                        return {
                                memberId: String(r.id),
                                name: String(r.name || 'Member'),
                                email: String(r.email || ''),
                                tier: r.tier ?? null,
                                lastActiveAt: ts,
                                daysInactive: Math.floor((now - ts) / DAY_MS)
                        };
                })
                .sort((a, b) => b.daysInactive - a.daysInactive);
}

export async function getRetentionMetrics(
        db: D1Compat,
        now: number = Date.now()
): Promise<RetentionMetrics> {
        const inactive = await listInactiveMembers(db, REENGAGEMENT_INACTIVITY_DAYS, now);

        const streakRow = await db
                .prepare(
                        `SELECT AVG(current_streak) AS avg_streak FROM member_streaks
                         WHERE current_streak > 0`
                )
                .first<{ avg_streak: number | string | null }>();
        const avgStreak = Math.round(Number(streakRow?.avg_streak ?? 0) * 10) / 10;

        // Denominator for milestone "completion rate": paid-active members,
        // matching the engagement cohort. A floor of 1 prevents divide-by-zero
        // when no eligible members exist (rate stays 0).
        const eligibleRow = await db
                .prepare(
                        `SELECT COUNT(*) AS n FROM members
                         WHERE access_status = 'active' AND tier IN ('bronze','vip')`
                )
                .first<{ n: number | string }>();
        const milestoneEligibleTotal = Number(eligibleRow?.n ?? 0);
        const denom = Math.max(1, milestoneEligibleTotal);

        const milestoneRows = await db
                .prepare(
                        `SELECT milestone_key AS key, COUNT(*) AS n
                         FROM member_milestones
                         GROUP BY milestone_key
                         ORDER BY n DESC`
                )
                .all<{ key: string; n: number | string }>();
        const milestoneCompletion = milestoneRows.results.map((r) => {
                const count = Number(r.n || 0);
                return {
                        key: String(r.key),
                        count,
                        rate: Math.round((count / denom) * 1000) / 10
                };
        });

        return { inactive, avgStreak, milestoneCompletion, milestoneEligibleTotal };
}

// ---- Content ---------------------------------------------------------------

export interface ContentMetrics {
        courses: Array<{
                courseId: string;
                title: string;
                completionRate: number;
                completed: number;
                started: number;
        }>;
        moduleDropoff: Array<{
                moduleId: string;
                courseTitle: string;
                moduleTitle: string;
                started: number;
                completed: number;
                dropoffPct: number;
        }>;
        rsvpVsAttendance: Array<{
                eventId: string;
                title: string;
                rsvps: number;
                attended: number;
        }>;
}

export async function getContentMetrics(db: D1Compat): Promise<ContentMetrics> {
        const courseRows = await db
                .prepare(
                        `SELECT c.id AS id, c.title AS title,
                                (SELECT COUNT(DISTINCT member_id) FROM member_training_points
                                 WHERE action_type = 'course_complete' AND reference_id = c.id) AS completed,
                                (SELECT COUNT(DISTINCT mp.member_id)
                                 FROM member_module_progress mp
                                 JOIN course_modules cm ON cm.id = mp.module_id
                                 WHERE cm.course_id = c.id) AS started
                         FROM courses c
                         WHERE c.status = 'available'
                         ORDER BY c.sort_order`
                )
                .all<{ id: string; title: string; completed: number | string; started: number | string }>();
        const courses = courseRows.results.map((r) => {
                const completed = Number(r.completed || 0);
                const started = Number(r.started || 0);
                return {
                        courseId: String(r.id),
                        title: String(r.title || ''),
                        completed,
                        started,
                        completionRate: started === 0 ? 0 : Math.round((completed / started) * 1000) / 10
                };
        });

        const dropoffRows = await db
                .prepare(
                        `SELECT cm.id AS id, cm.title AS module_title, c.title AS course_title,
                                COUNT(*) AS started,
                                SUM(CASE WHEN mp.completed_at IS NOT NULL THEN 1 ELSE 0 END) AS completed
                         FROM member_module_progress mp
                         JOIN course_modules cm ON cm.id = mp.module_id
                         JOIN courses c ON c.id = cm.course_id
                         WHERE c.status = 'available'
                         GROUP BY cm.id, cm.title, c.title
                         ORDER BY started DESC
                         LIMIT 10`
                )
                .all<{
                        id: string;
                        module_title: string;
                        course_title: string;
                        started: number | string;
                        completed: number | string;
                }>();
        const moduleDropoff = dropoffRows.results.map((r) => {
                const started = Number(r.started || 0);
                const completed = Number(r.completed || 0);
                return {
                        moduleId: String(r.id),
                        courseTitle: String(r.course_title || ''),
                        moduleTitle: String(r.module_title || ''),
                        started,
                        completed,
                        dropoffPct: started === 0 ? 0 : Math.round(((started - completed) / started) * 1000) / 10
                };
        });

        const eventRows = await db
                .prepare(
                        `SELECT e.id AS id, e.title AS title,
                                (SELECT COUNT(*) FROM event_rsvps WHERE event_id = e.id) AS rsvps,
                                (SELECT COUNT(*) FROM member_training_points
                                 WHERE action_type = 'live_session_attend' AND reference_id = e.id) AS attended
                         FROM events e
                         WHERE e.event_kind = 'livestream'
                         ORDER BY e.starts_at DESC NULLS LAST
                         LIMIT 10`
                )
                .all<{ id: string; title: string; rsvps: number | string; attended: number | string }>();
        const rsvpVsAttendance = eventRows.results.map((r) => ({
                eventId: String(r.id),
                title: String(r.title || ''),
                rsvps: Number(r.rsvps || 0),
                attended: Number(r.attended || 0)
        }));

        return { courses, moduleDropoff, rsvpVsAttendance };
}

// ---- Community -------------------------------------------------------------

export interface CommunityMetrics {
        postsByDay: Array<{ day: string; count: number }>;
        topPosts: Array<{
                messageId: string;
                channelName: string;
                authorName: string;
                excerpt: string;
                reactions: number;
        }>;
        /** Admin-only. Empty array when caller is not an admin. */
        topRecognitionRecipients: Array<{ memberId: string; name: string; received: number }>;
}

export interface CommunityMetricsOptions {
        /** When false, the recognition leaderboard is omitted (admin-only). */
        includeRecognitionLeaderboard?: boolean;
        now?: number;
}

export async function getCommunityMetrics(
        db: D1Compat,
        options: CommunityMetricsOptions = {}
): Promise<CommunityMetrics> {
        const now = options.now ?? Date.now();
        const includeRecognition = options.includeRecognitionLeaderboard !== false;
        const since = now - 30 * DAY_MS;
        const dayRows = await db
                .prepare(
                        `SELECT created_at FROM messages
                         WHERE deleted_at IS NULL AND created_at >= ?`
                )
                .bind(since)
                .all<{ created_at: number | string }>();
        const buckets = new Map<string, number>();
        for (const r of dayRows.results) {
                const k = dayKey(Number(r.created_at || 0));
                buckets.set(k, (buckets.get(k) ?? 0) + 1);
        }
        const postsByDay: Array<{ day: string; count: number }> = [];
        for (let i = 29; i >= 0; i--) {
                const k = dayKey(now - i * DAY_MS);
                postsByDay.push({ day: k, count: buckets.get(k) ?? 0 });
        }

        const topPostRows = await db
                .prepare(
                        `SELECT m.id AS id, m.body AS body, c.name AS channel_name,
                                mem.name AS author_name,
                                (SELECT COUNT(*) FROM message_reactions WHERE message_id = m.id) AS reactions
                         FROM messages m
                         JOIN channels c ON c.id = m.channel_id
                         JOIN members mem ON mem.clerk_user_id = m.author_id
                         WHERE m.deleted_at IS NULL AND m.created_at >= ?
                         ORDER BY reactions DESC, m.created_at DESC
                         LIMIT 5`
                )
                .bind(since)
                .all<{
                        id: string;
                        body: string;
                        channel_name: string;
                        author_name: string;
                        reactions: number | string;
                }>();
        const topPosts = topPostRows.results
                .filter((r) => Number(r.reactions || 0) > 0)
                .map((r) => ({
                        messageId: String(r.id),
                        channelName: String(r.channel_name || ''),
                        authorName: String(r.author_name || 'Member'),
                        excerpt: String(r.body || '').slice(0, 140),
                        reactions: Number(r.reactions || 0)
                }));

        let topRecognitionRecipients: CommunityMetrics['topRecognitionRecipients'] = [];
        if (includeRecognition) {
                const recogRows = await db
                        .prepare(
                                `SELECT r.recipient_id AS id, m.name AS name, COUNT(*) AS n
                                 FROM recognitions r
                                 JOIN members m ON m.clerk_user_id = r.recipient_id
                                 GROUP BY r.recipient_id, m.name
                                 ORDER BY n DESC
                                 LIMIT 10`
                        )
                        .all<{ id: string; name: string; n: number | string }>();
                topRecognitionRecipients = recogRows.results.map((r) => ({
                        memberId: String(r.id),
                        name: String(r.name || 'Member'),
                        received: Number(r.n || 0)
                }));
        }

        return { postsByDay, topPosts, topRecognitionRecipients };
}

// ---- Re-engagement ----------------------------------------------------------

export interface ReengagementResult {
        flagged: number;
        notified: number;
        skipped: number;
}

export const REENGAGEMENT_THROTTLE_MS = 6 * 60 * 60 * 1000; // 6 hours
const REENGAGEMENT_LAST_SCAN_KEY = 'reengagement.last_scan_at';

async function readLastScanAt(db: D1Compat): Promise<number> {
        const row = await db
                .prepare(`SELECT value FROM system_kv WHERE key = ?`)
                .bind(REENGAGEMENT_LAST_SCAN_KEY)
                .first<{ value: string | null }>();
        return Number(row?.value ?? 0) || 0;
}

async function writeLastScanAt(db: D1Compat, ts: number): Promise<void> {
        await db
                .prepare(
                        `INSERT INTO system_kv (key, value, updated_at) VALUES (?, ?, ?)
                         ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at`
                )
                .bind(REENGAGEMENT_LAST_SCAN_KEY, String(ts), ts)
                .run();
}

/**
 * True iff the throttle window has elapsed since the last persisted scan.
 * Independent of whether prior scans produced notifications, so empty scans
 * still mark the window as consumed.
 */
export async function shouldRunReengagementScan(
        db: D1Compat,
        windowMs: number = REENGAGEMENT_THROTTLE_MS,
        now: number = Date.now()
): Promise<boolean> {
        const last = await readLastScanAt(db);
        return last === 0 || now - last >= windowMs;
}

/**
 * Throttled wrapper that auto-runs the scan at most once per window.
 * Persists a marker timestamp regardless of how many members were notified
 * so empty scans still consume the throttle window. Safe to call on every
 * admin page load.
 */
export async function maybeRunReengagementScan(
        db: D1Compat,
        windowMs: number = REENGAGEMENT_THROTTLE_MS,
        now: number = Date.now()
): Promise<ReengagementResult | null> {
        if (!(await shouldRunReengagementScan(db, windowMs, now))) return null;
        const result = await flagInactiveMembersAndNotify(db, now);
        await writeLastScanAt(db, now);
        return result;
}

/**
 * Find paid/active members inactive for >= 14 days and enqueue an in-app
 * re-engagement notification. Deduplicates on a 14-day bucket of last activity
 * so each inactivity stretch only triggers one nudge.
 */
export async function flagInactiveMembersAndNotify(
        db: D1Compat,
        now: number = Date.now()
): Promise<ReengagementResult> {
        const inactive = await listInactiveMembers(db, REENGAGEMENT_INACTIVITY_DAYS, now);
        let notified = 0;
        let skipped = 0;
        for (const m of inactive) {
                const bucket = dayKey(m.lastActiveAt);
                const inserted = await enqueueInAppNotification(db, {
                        memberId: m.memberId,
                        kind: 'reengagement_14d',
                        title: 'Welcome back to the Network.',
                        body: `It's been ${m.daysInactive} days since your last training activity. Pick up where you left off — your next module is one click away.`,
                        ctaLabel: 'Resume training',
                        ctaHref: '/dashboard',
                        sourceRef: `last_active:${bucket}`
                });
                if (inserted) notified += 1;
                else skipped += 1;
        }
        return { flagged: inactive.length, notified, skipped };
}
