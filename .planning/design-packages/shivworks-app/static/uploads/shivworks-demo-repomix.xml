<script lang="ts">
	import { onMount, onDestroy, tick } from 'svelte';
	import { invalidateAll } from '$app/navigation';
	import type { PageData } from './$types';

	interface DmRecord {
		id: string;
		senderId: string;
		recipientId: string;
		body: string;
		readAt: number | null;
		createdAt: number;
	}

	interface Props {
		data: PageData;
	}
	let { data }: Props = $props();

	let messages = $state<DmRecord[]>([...(data.messages as DmRecord[])]);
	let composerBody = $state('');
	let sending = $state(false);
	let sendError = $state<string | null>(null);
	let scrollContainer: HTMLDivElement | undefined = $state();
	let eventSource: EventSource | null = null;
	let reportOpen = $state(false);
	let reportReason = $state('');
	let reportSubmitting = $state(false);
	let reportFlash = $state<string | null>(null);

	$effect(() => {
		// Re-sync if the loader re-runs (e.g. after invalidateAll on incoming DM).
		messages = [...(data.messages as DmRecord[])];
	});

	async function scrollToBottom() {
		await tick();
		if (scrollContainer) scrollContainer.scrollTop = scrollContainer.scrollHeight;
	}

	function formatTime(ts: number): string {
		const d = new Date(ts);
		return d.toLocaleString([], {
			month: 'short',
			day: 'numeric',
			hour: 'numeric',
			minute: '2-digit'
		});
	}

	async function send(event: Event) {
		event.preventDefault();
		const body = composerBody.trim();
		if (!body || sending) return;
		sending = true;
		sendError = null;
		try {
			const res = await fetch(`/api/messages/${data.partner.clerkUserId}`, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ body })
			});
			if (!res.ok) {
				const err = await res.json().catch(() => ({}));
				sendError = err?.message || 'Failed to send message';
				return;
			}
			const payload = await res.json();
			messages = [...messages, payload.message as DmRecord];
			composerBody = '';
			await scrollToBottom();
		} finally {
			sending = false;
		}
	}

	async function markReadOnServer() {
		try {
			await fetch(`/api/messages/${data.partner.clerkUserId}/read`, { method: 'POST' });
		} catch {
			// best-effort
		}
	}

	async function submitReport(event: Event) {
		event.preventDefault();
		if (reportSubmitting) return;
		reportSubmitting = true;
		try {
			const res = await fetch(`/api/messages/${data.partner.clerkUserId}/report`, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ reason: reportReason.trim() || null })
			});
			if (res.ok) {
				reportOpen = false;
				reportReason = '';
				reportFlash = 'Conversation reported. The team will review it.';
				setTimeout(() => (reportFlash = null), 4000);
			} else {
				reportFlash = 'Could not submit report. Try again later.';
			}
		} finally {
			reportSubmitting = false;
		}
	}

	onMount(() => {
		scrollToBottom();
		eventSource = new EventSource('/api/messages/stream');
		eventSource.addEventListener('dm.created', (e) => {
			try {
				const evt = JSON.parse((e as MessageEvent).data);
				const payload = evt?.payload;
				if (!payload || !payload.message) return;
				const m = payload.message as DmRecord;
				const otherId = data.partner.clerkUserId;
				const isThisThread =
					(m.senderId === data.viewer.clerkUserId && m.recipientId === otherId) ||
					(m.senderId === otherId && m.recipientId === data.viewer.clerkUserId);
				if (!isThisThread) return;
				if (messages.some((existing) => existing.id === m.id)) return;
				messages = [...messages, m];
				scrollToBottom();
				if (m.recipientId === data.viewer.clerkUserId) {
					markReadOnServer().then(() => invalidateAll());
				}
			} catch {
				// ignore
			}
		});
	});

	onDestroy(() => {
		eventSource?.close();
		eventSource = null;
	});
</script>

<svelte:head><title>{data.partner.name} — Messages</title></svelte:head>

<section class="thread-shell">
	<header class="thread-header">
		<a class="back" href="/messages" aria-label="Back to inbox">← Inbox</a>
		<div class="who">
			<strong>{data.partner.name}</strong>
			{#if data.partner.tier === 'vip'}
				<span class="tier-pill tier-vip">VIP</span>
			{:else if data.partner.tier === 'bronze'}
				<span class="tier-pill tier-bronze">Bronze</span>
			{/if}
		</div>
		<button class="report-btn" type="button" onclick={() => (reportOpen = !reportOpen)}>
			Report conversation
		</button>
	</header>

	{#if reportFlash}
		<div class="flash" role="status">{reportFlash}</div>
	{/if}

	{#if reportOpen}
		<form class="report-form" onsubmit={submitReport}>
			<label for="report-reason">Reason (optional)</label>
			<textarea
				id="report-reason"
				rows="3"
				bind:value={reportReason}
				placeholder="What's the problem with this conversation?"
				maxlength="1000"
			></textarea>
			<div class="report-actions">
				<button type="button" class="ghost" onclick={() => (reportOpen = false)}>Cancel</button>
				<button type="submit" class="primary" disabled={reportSubmitting}>
					{reportSubmitting ? 'Submitting…' : 'Flag for review'}
				</button>
			</div>
		</form>
	{/if}

	<div class="thread-scroll" bind:this={scrollContainer}>
		{#if messages.length === 0}
			<div class="empty">No messages yet — say hello.</div>
		{:else}
			<ol class="messages" role="list">
				{#each messages as msg (msg.id)}
					{@const mine = msg.senderId === data.viewer.clerkUserId}
					<li class="msg" class:msg--mine={mine}>
						<div class="bubble">
							<p class="body">{msg.body}</p>
							<span class="meta">{formatTime(msg.createdAt)}</span>
						</div>
					</li>
				{/each}
			</ol>
		{/if}
	</div>

	<form class="composer" onsubmit={send}>
		{#if sendError}
			<div class="composer-error">{sendError}</div>
		{/if}
		<textarea
			rows="2"
			placeholder={`Message ${data.partner.name}…`}
			bind:value={composerBody}
			maxlength="4000"
			disabled={sending}
			onkeydown={(e) => {
				if ((e as KeyboardEvent).key === 'Enter' && !(e as KeyboardEvent).shiftKey) {
					e.preventDefault();
					send(e);
				}
			}}
		></textarea>
		<div class="composer-row">
			<span class="composer-hint">Enter to send · Shift + Enter for newline</span>
			<button type="submit" class="primary" disabled={sending || composerBody.trim().length === 0}>
				{sending ? 'Sending…' : 'Send'}
			</button>
		</div>
	</form>
</section>

