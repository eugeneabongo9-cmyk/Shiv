<script lang="ts">
        import { onDestroy } from 'svelte';
        import CustomVideoPlayer from './CustomVideoPlayer.svelte';

        interface Props {
                episodeId: string;
                initialSeconds?: number;
                onTimeUpdate?: (currentSeconds: number, durationSeconds: number | null) => void;
                onPause?: (currentSeconds: number, durationSeconds: number | null) => void;
                onEnded?: (durationSeconds: number | null) => void;
        }

        type PlaybackData = {
                episodeId: string;
                provider: 'cloudflare_stream' | 'external';
                playbackType: 'hls' | 'mp4' | 'external';
                url: string;
                expiresAt?: number;
                durationSeconds?: number | null;
        };

        type PlaybackResponse = {
                success: boolean;
                error?: string;
                data?: PlaybackData;
                ingestStatus?: 'pending' | 'processing' | 'ready' | 'failed' | string;
                failureReason?: string | null;
        };

        type StreamPlayerLike = {
                addEventListener(event: string, handler: (...args: unknown[]) => void): void;
                removeEventListener(event: string, handler: (...args: unknown[]) => void): void;
                readonly currentTime: number;
                readonly duration: number;
        };

        type StreamFactory = (iframe: HTMLIFrameElement) => StreamPlayerLike;

        const STREAM_SDK_URL = 'https://embed.cloudflarestream.com/embed/sdk.latest.js';

        let {
                episodeId,
                initialSeconds = 0,
                onTimeUpdate,
                onPause,
                onEnded
        }: Props = $props();

        let loading = $state(true);
        let errorMessage = $state<string | null>(null);
        let errorKind = $state<'failed' | 'processing' | 'generic'>('generic');
        let failureReason = $state<string | null>(null);
        let playback = $state<PlaybackData | null>(null);
        let iframeEl = $state<HTMLIFrameElement | null>(null);
        let player: StreamPlayerLike | null = null;
        let lastReportedSeconds = 0;
        let lastKnownDuration: number | null = null;

        $effect(() => {
                const id = episodeId;
                loading = true;
                errorMessage = null;
                errorKind = 'generic';
                failureReason = null;
                playback = null;
                lastReportedSeconds = 0;
                lastKnownDuration = null;
                void loadPlayback(id);
        });

        async function loadPlayback(id: string) {
                try {
                        const response = await fetch(`/api/library/episodes/${id}/playback`);
                        const body = (await response.json().catch(() => ({}))) as PlaybackResponse;
                        if (id !== episodeId) return;
                        if (!response.ok || !body.success || !body.data) {
                                if (body.ingestStatus === 'failed') {
                                        errorKind = 'failed';
                                        failureReason = (body.failureReason ?? '').trim() || null;
                                        errorMessage =
                                                "This video failed to process and can't be played right now. An admin has been notified.";
                                } else if (body.ingestStatus === 'pending' || body.ingestStatus === 'processing') {
                                        errorKind = 'processing';
                                        errorMessage =
                                                body.error || 'This episode is still processing. Try again in a few minutes.';
                                } else {
                                        errorKind = 'generic';
                                        errorMessage =
                                                body.error || 'This episode is not ready to play yet. Try again in a few minutes.';
                                }
                                return;
                        }
                        playback = body.data;
                        lastKnownDuration = body.data.durationSeconds ?? null;
                } catch {
                        if (id === episodeId) {
                                errorKind = 'generic';
                                errorMessage = 'Unable to load the video. Check your connection and refresh.';
                        }
                } finally {
                        if (id === episodeId) loading = false;
                }
        }

        function loadStreamSdk(): Promise<StreamFactory> {
                return new Promise((resolve, reject) => {
                        if (typeof window === 'undefined') {
                                reject(new Error('window is not available'));
                                return;
                        }
                        const win = window as unknown as { Stream?: StreamFactory };
                        if (win.Stream) {
                                resolve(win.Stream);
                                return;
                        }
                        const existing = document.querySelector<HTMLScriptElement>(
                                `script[src="${STREAM_SDK_URL}"]`
                        );
                        const finish = () => {
                                if (win.Stream) resolve(win.Stream);
                                else reject(new Error('Stream SDK loaded but window.Stream is missing'));
                        };
                        if (existing) {
                                existing.addEventListener('load', finish, { once: true });
                                existing.addEventListener(
                                        'error',
                                        () => reject(new Error('Failed to load Stream SDK')),
                                        { once: true }
                                );
                                return;
                        }
                        const script = document.createElement('script');
                        script.src = STREAM_SDK_URL;
                        script.async = true;
                        script.onload = finish;
                        script.onerror = () => reject(new Error('Failed to load Stream SDK'));
                        document.head.appendChild(script);
                });
        }

        function detachPlayer() {
                if (!player) return;
                try {
                        player.removeEventListener('timeupdate', handleTimeUpdate);
                        player.removeEventListener('pause', handlePause);
                        player.removeEventListener('ended', handleEnded);
                        player.removeEventListener('loadedmetadata', handleLoadedMetadata);
                } catch {
                        // best effort
                }
                player = null;
        }

        function handleLoadedMetadata() {
                if (!player) return;
                const duration = Number.isFinite(player.duration) ? player.duration : 0;
                if (duration > 0) lastKnownDuration = duration;
        }

        function handleTimeUpdate() {
                if (!player) return;
                const current = Math.max(0, Math.round(player.currentTime));
                const duration = Number.isFinite(player.duration) && player.duration > 0
                        ? player.duration
                        : lastKnownDuration;
                if (duration && duration > 0) lastKnownDuration = duration;
                if (Math.abs(current - lastReportedSeconds) >= 10) {
                        lastReportedSeconds = current;
                        onTimeUpdate?.(current, lastKnownDuration);
                }
        }

        function handlePause() {
                if (!player) return;
                const current = Math.max(0, Math.round(player.currentTime));
                lastReportedSeconds = current;
                onPause?.(current, lastKnownDuration);
        }

        function handleEnded() {
                const duration = lastKnownDuration;
                if (duration && duration > 0) lastReportedSeconds = Math.round(duration);
                onEnded?.(duration);
        }

        const iframeUrl = $derived.by((): string | null => {
                if (!playback || playback.playbackType !== 'hls') return null;
                // `url` is `https://videodelivery.net/<TOKEN_OR_UID>/manifest/video.m3u8`.
                // The Stream iframe player accepts the same token/UID at `iframe.videodelivery.net/<TOKEN_OR_UID>`.
                try {
                        const parsed = new URL(playback.url);
                        const tokenOrUid = parsed.pathname.split('/').filter(Boolean)[0];
                        if (!tokenOrUid) return null;
                        const params = new URLSearchParams();
                        if (initialSeconds > 0) params.set('startTime', `${Math.round(initialSeconds)}s`);
                        const query = params.toString();
                        return `https://iframe.videodelivery.net/${tokenOrUid}${query ? `?${query}` : ''}`;
                } catch {
                        return null;
                }
        });

        $effect(() => {
                const iframe = iframeEl;
                const url = iframeUrl;
                detachPlayer();
                if (!iframe || !url) return;
                let cancelled = false;
                void loadStreamSdk()
                        .then((StreamFactory) => {
                                if (cancelled || iframeEl !== iframe) return;
                                const next = StreamFactory(iframe);
                                player = next;
                                next.addEventListener('timeupdate', handleTimeUpdate);
                                next.addEventListener('pause', handlePause);
                                next.addEventListener('ended', handleEnded);
                                next.addEventListener('loadedmetadata', handleLoadedMetadata);
                        })
                        .catch((err) => {
                                console.error('Stream SDK init failed', err);
                        });
                return () => {
                        cancelled = true;
                        detachPlayer();
                };
        });

        onDestroy(() => {
                detachPlayer();
        });
</script>

<div class="episode-player">
