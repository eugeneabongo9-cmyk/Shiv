<script lang="ts">
        import { onDestroy } from 'svelte';
        import {
                ArrowLeft,
                ArrowRight,
                Check,
                ChevronRight,
                CircleDot,
                Lock,
                Menu,
                X
        } from 'lucide-svelte';
        import CustomVideoPlayer from '$lib/components/CustomVideoPlayer.svelte';
        import EpisodePlayer from '$lib/components/EpisodePlayer.svelte';
        import { isPaidMemberTier } from '$lib/constants/tiers';
        import type { PageData } from './$types';

        interface Props {
                data: PageData;
        }

        type ModuleProgress = {
                moduleId: string;
                currentSeconds: number;
                durationSeconds: number | null;
                completedAt: number | null;
                updatedAt: number;
        };

        type EpisodeProgress = {
                episodeId: string;
                currentSeconds: number;
                durationSeconds: number | null;
                completedAt: number | null;
                updatedAt: number;
        };

        let { data }: Props = $props();
        let progressByEpisode = $state<Record<string, EpisodeProgress>>(
                { ...(data.progressByEpisode ?? {}) }
        );
        let episodeSaveFeedback = $state<string | null>(null);
        let episodeSaveResetTimer: ReturnType<typeof setTimeout> | null = null;

        function clearEpisodeSaveFeedbackSoon() {
                if (episodeSaveResetTimer) clearTimeout(episodeSaveResetTimer);
                episodeSaveResetTimer = setTimeout(() => {
                        episodeSaveFeedback = null;
                }, 2200);
        }

        function updateLocalEpisodeProgress(
                episodeId: string,
                currentSeconds: number,
                durationSeconds: number | null,
                completed: boolean
        ) {
                const prev = progressByEpisode[episodeId];
                progressByEpisode = {
                        ...progressByEpisode,
                        [episodeId]: {
                                episodeId,
                                currentSeconds: Math.max(0, Math.round(currentSeconds)),
                                durationSeconds:
                                        durationSeconds === null || durationSeconds === undefined
                                                ? prev?.durationSeconds ?? null
                                                : Math.max(0, Math.round(durationSeconds)),
                                completedAt: completed ? prev?.completedAt || Date.now() : prev?.completedAt || null,
                                updatedAt: Date.now()
                        }
                };
        }

        async function persistEpisodeProgress(
                episodeId: string,
                currentSeconds: number,
                durationSeconds: number | null,
                completed: boolean
        ) {
                try {
                        const response = await fetch(`/api/library/episodes/${episodeId}/progress`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                        currentSeconds: Math.max(0, Math.round(currentSeconds)),
                                        durationSeconds,
                                        completed
                                })
                        });
                        if (!response.ok) {
                                const result = await response
                                        .json()
                                        .catch(() => ({ error: 'Unable to save progress.' }));
                                episodeSaveFeedback = result.error || 'Unable to save progress.';
                                clearEpisodeSaveFeedbackSoon();
                        }
                } catch {
                        episodeSaveFeedback = 'Unable to save progress.';
                        clearEpisodeSaveFeedbackSoon();
                }
        }

        function handleEpisodeTimeUpdate(
                episodeId: string,
                currentSeconds: number,
                durationSeconds: number | null
        ) {
                updateLocalEpisodeProgress(episodeId, currentSeconds, durationSeconds, false);
                void persistEpisodeProgress(episodeId, currentSeconds, durationSeconds, false);
        }

        function handleEpisodePause(
                episodeId: string,
                currentSeconds: number,
                durationSeconds: number | null
        ) {
                updateLocalEpisodeProgress(episodeId, currentSeconds, durationSeconds, false);
                void persistEpisodeProgress(episodeId, currentSeconds, durationSeconds, false);
        }

        function handleEpisodeEnded(episodeId: string, durationSeconds: number | null) {
                const seconds = durationSeconds || progressByEpisode[episodeId]?.durationSeconds || 0;
                updateLocalEpisodeProgress(episodeId, seconds, durationSeconds, true);
                void persistEpisodeProgress(episodeId, seconds, durationSeconds, true);
        }

        function formatEpisodeProgress(progress: EpisodeProgress | undefined): string | null {
                if (!progress) return null;
                if (progress.completedAt) return 'Watched';
                if (progress.durationSeconds && progress.durationSeconds > 0) {
                        const pct = Math.min(
                                100,
                                Math.round((progress.currentSeconds / progress.durationSeconds) * 100)
                        );
                        if (pct > 0) return `${pct}% watched`;
                }
                if (progress.currentSeconds > 0) {
                        const mins = Math.floor(progress.currentSeconds / 60);
                        const secs = progress.currentSeconds % 60;
                        return `Resume at ${mins}:${String(secs).padStart(2, '0')}`;
                }
                return null;
        }

        // June 1, 2026 00:00 UTC — platform launch.
        const LAUNCH_TIMESTAMP = Date.UTC(2026, 5, 1);

        const initialProgressByModule = (): Record<string, ModuleProgress> => data.progressByModule;
        let progressByModule = $state<Record<string, ModuleProgress>>(initialProgressByModule());
        let saveFeedback = $state<string | null>(null);
        let curriculumOpen = $state(false);
        let lastSavedSeconds = 0;
        let activeModuleId: string | null = null;
        let saveErrorResetTimer: ReturnType<typeof setTimeout> | null = null;
        let lastKnownSeconds = 0;
        let lastKnownDuration: number | null = null;

        const selectedModule = $derived(
                data.modules.find((module) => module.id === data.selectedModuleId) || data.modules[0] || null
        );
        const selectedIndex = $derived(
                selectedModule ? data.modules.findIndex((module) => module.id === selectedModule.id) : -1
        );
        const previousModule = $derived(selectedIndex > 0 ? data.modules[selectedIndex - 1] : null);
        const nextModule = $derived(
                selectedIndex >= 0 && selectedIndex < data.modules.length - 1
                        ? data.modules[selectedIndex + 1]
                        : null
        );
        const selectedProgress = $derived(
                selectedModule ? progressByModule[selectedModule.id] || null : null
        );
        const canPlaySelected = $derived(
                Boolean(selectedModule && selectedModule.status === 'available' && selectedModule.videoUrl)
        );
        const isPreLaunch = $derived(Date.now() < LAUNCH_TIMESTAMP);
        const isPaidMember = $derived(isPaidMemberTier(data.user?.tier ?? null));
        const showGateOverlay = $derived(Boolean(selectedModule) && !isPaidMember);
        const showPreLaunchCard = $derived(
                Boolean(selectedModule) && isPaidMember && !canPlaySelected && isPreLaunch
        );
        const completedCount = $derived(
                data.modules.filter((module) => Boolean(progressByModule[module.id]?.completedAt)).length
        );
        const selectedEpisode = $derived(
                data.selectedEpisodeId
                        ? data.episodes.find((episode) => episode.id === data.selectedEpisodeId) || null
                        : null
        );
        const moduleEpisodes = $derived(
                selectedModule
                        ? data.episodes.filter((episode) => episode.moduleId === selectedModule.id)
                        : []
        );
        const selectedEpisodeProgress = $derived(
                selectedEpisode ? progressByEpisode[selectedEpisode.id] || null : null
        );
        const showEpisodePlayer = $derived(
                Boolean(selectedEpisode && selectedEpisode.playable && isPaidMember)
        );

        function getCaptionUrl(moduleId: string | undefined): string | undefined {
                if (!moduleId) return undefined;
                // Captions live alongside the video assets. Most modules ship with
                // the standard caption track; the core platform brief ships its own.
                return moduleId === 'module_core_platform_brief'
                        ? '/captions/shivworks-member-brief.vtt'
                        : '/captions/shivworks-preview.vtt';
        }

        function getDescriptionSentences(text: string | null | undefined): string {
                if (!text) return 'Module summary coming soon.';
                // Limit to first two sentences for the player page lede.
                const sentences = text.match(/[^.!?]+[.!?]+/g);
                if (!sentences || sentences.length === 0) return text;
                return sentences.slice(0, 2).join(' ').trim();
        }

        function clearSaveFeedbackSoon() {
                if (saveErrorResetTimer) clearTimeout(saveErrorResetTimer);
                saveErrorResetTimer = setTimeout(() => {
                        saveFeedback = null;
                }, 2200);
        }

        function updateLocalProgress(
                currentSeconds: number,
                durationSeconds: number | null,
                completed = false
        ) {
                if (!selectedModule) return;
                progressByModule = {
                        ...progressByModule,
                        [selectedModule.id]: {
                                moduleId: selectedModule.id,
                                currentSeconds: Math.max(0, Math.round(currentSeconds)),
                                durationSeconds:
                                        durationSeconds === null ? null : Math.max(0, Math.round(durationSeconds)),
                                completedAt: completed
                                        ? progressByModule[selectedModule.id]?.completedAt || Date.now()
                                        : progressByModule[selectedModule.id]?.completedAt || null,
                                updatedAt: Date.now()
                        }
                };
        }

        async function persistProgress(
                currentSeconds: number,
                durationSeconds: number | null,
                completed: boolean,
                force: boolean
        ) {
                if (!selectedModule || selectedModule.videoKind !== 'mp4') return;
                const rounded = Math.max(0, Math.round(currentSeconds));
                if (!force && Math.abs(rounded - lastSavedSeconds) < 10) return;
                lastSavedSeconds = rounded;
                updateLocalProgress(rounded, durationSeconds, completed);

                try {
                        const response = await fetch(`/api/library/modules/${selectedModule.id}/progress`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                        currentSeconds: rounded,
                                        durationSeconds,
                                        completed
                                })
                        });
                        if (!response.ok) {
                                const result = await response
                                        .json()
                                        .catch(() => ({ error: 'Unable to save progress.' }));
                                saveFeedback = result.error || 'Unable to save progress.';
                                clearSaveFeedbackSoon();
                        }
                } catch {
                        saveFeedback = 'Unable to save progress.';
                        clearSaveFeedbackSoon();
                }
        }

        function handleTimeUpdate(currentSeconds: number, durationSeconds: number | null) {
                lastKnownSeconds = currentSeconds;
                lastKnownDuration = durationSeconds;
                updateLocalProgress(currentSeconds, durationSeconds, false);
                void persistProgress(currentSeconds, durationSeconds, false, false);
        }

        function handlePause(currentSeconds: number, durationSeconds: number | null) {
                lastKnownSeconds = currentSeconds;
                lastKnownDuration = durationSeconds;
                void persistProgress(currentSeconds, durationSeconds, false, true);
        }

        function handleEnded(durationSeconds: number | null) {
                const seconds = durationSeconds || selectedProgress?.durationSeconds || 0;
                lastKnownSeconds = seconds;
                lastKnownDuration = durationSeconds;
                updateLocalProgress(seconds, durationSeconds, true);
                void persistProgress(seconds, durationSeconds, true, true);
        }

        function flushProgressOnUnload() {
                const moduleId = activeModuleId;
                if (!moduleId || lastKnownSeconds <= lastSavedSeconds) return;
                try {
                        const payload = JSON.stringify({
                                currentSeconds: lastKnownSeconds,
                                durationSeconds: lastKnownDuration,
                                completed: false
                        });
                        const blob = new Blob([payload], { type: 'application/json' });
                        if (typeof navigator !== 'undefined' && typeof navigator.sendBeacon === 'function') {
                                navigator.sendBeacon(`/api/library/modules/${moduleId}/progress`, blob);
                        } else {
                                void fetch(`/api/library/modules/${moduleId}/progress`, {
                                        method: 'POST',
                                        headers: { 'content-type': 'application/json' },
                                        body: payload,
                                        keepalive: true
                                });
                        }
                        lastSavedSeconds = lastKnownSeconds;
                } catch {
                        // best-effort flush; nothing to surface to the user on unload.
                }
        }

        $effect(() => {
                if (typeof window === 'undefined') return;
                const onVisibility = () => {
                        if (document.visibilityState === 'hidden') flushProgressOnUnload();
                };
                window.addEventListener('pagehide', flushProgressOnUnload);
                document.addEventListener('visibilitychange', onVisibility);
                return () => {
                        window.removeEventListener('pagehide', flushProgressOnUnload);
                        document.removeEventListener('visibilitychange', onVisibility);
                };
        });

        function getModuleStatusKind(
                moduleId: string,
                status: string,
                videoUrl: string | null
        ): 'completed' | 'locked' | 'available' {
                if (progressByModule[moduleId]?.completedAt) return 'completed';
                if (status === 'available' && videoUrl) return 'available';
                return 'locked';
        }

        $effect(() => {
                const moduleId = selectedModule?.id || null;
                if (!moduleId || moduleId === activeModuleId) return;
                activeModuleId = moduleId;
                lastSavedSeconds = progressByModule[moduleId]?.currentSeconds || 0;
                saveFeedback = null;
                curriculumOpen = false;
        });

        onDestroy(() => {
                if (saveErrorResetTimer) clearTimeout(saveErrorResetTimer);
        });
</script>

<svelte:head>
        <title>{selectedModule?.title ? `${selectedModule.title} — ` : ''}{data.course.title} | ShivWorks Network</title>
</svelte:head>

<section class="player-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
                <a href="/library" class="crumb">
                        <ArrowLeft size={14} />
                        <span>Library</span>
                </a>
                <ChevronRight size={14} class="crumb-sep" />
                <a href={`/library/${data.course.slug}`} class="crumb">{data.course.title}</a>
                {#if selectedModule}
                        <ChevronRight size={14} class="crumb-sep" />
                        <span class="crumb current">{selectedModule.title}</span>
                {/if}
        </nav>

        <button
                class="curriculum-toggle"
                type="button"
                onclick={() => (curriculumOpen = true)}
                aria-label="Open curriculum"
        >
                <Menu size={18} />
                <span>Curriculum · {completedCount}/{data.modules.length}</span>
        </button>

        <div class="player-grid">
                <main class="player-main">
                        <div class="player-shell">
                                {#if showEpisodePlayer && selectedEpisode}
                                        <EpisodePlayer
                                                episodeId={selectedEpisode.id}
                                                initialSeconds={selectedEpisodeProgress && !selectedEpisodeProgress.completedAt
                                                        ? selectedEpisodeProgress.currentSeconds
                                                        : 0}
                                                onTimeUpdate={(current, duration) =>
                                                        handleEpisodeTimeUpdate(selectedEpisode.id, current, duration)}
                                                onPause={(current, duration) =>
                                                        handleEpisodePause(selectedEpisode.id, current, duration)}
                                                onEnded={(duration) => handleEpisodeEnded(selectedEpisode.id, duration)}
                                        />
                                {:else if showGateOverlay}
                                        <div class="gate-overlay">
                                                <img src="/logo.svg" alt="ShivWorks" class="gate-logo" />
                                                <p class="gate-eyebrow">Founding Members</p>
                                                <h2 class="gate-title">Lifetime access to Craig's complete methodology.</h2>
                                                <p class="gate-copy">
                                                        This module is reserved for Bronze and VIP Founding Members. Claim your spot to
                                                        unlock the full curriculum, livestreams, and the private member network.
                                                </p>
                                                <a
                                                class="gate-cta"
                                                href={`/checkout?redirect=${encodeURIComponent(`/library/${data.course.slug}`)}`}
                                        >
                                                Join the Network
                                        </a>
                                        </div>
                                {:else if selectedModule && canPlaySelected && selectedModule.videoKind === 'mp4' && selectedModule.videoUrl}
                                        {#key selectedModule.id}
                                                <CustomVideoPlayer
                                                        src={selectedModule.videoUrl}
                                                        captionUrl={getCaptionUrl(selectedModule.id)}
                                                        initialSeconds={selectedProgress && !selectedProgress.completedAt
                                                                ? selectedProgress.currentSeconds
                                                                : 0}
                                                        onTimeUpdate={handleTimeUpdate}
                                                        onPause={handlePause}
                                                        onEnded={handleEnded}
                                                />
                                        {/key}
                                {:else if selectedModule && canPlaySelected && selectedModule.videoKind === 'embed' && selectedModule.videoUrl}
                                        <div class="embed-shell">
                                                <iframe
                                                        title={`Playback for ${selectedModule.title}`}
                                                        src={selectedModule.videoUrl}
                                                        loading="lazy"
                                                        allow="autoplay; fullscreen; picture-in-picture"
                                                ></iframe>
                                        </div>
                                {:else if showPreLaunchCard}
                                        <div class="prelaunch-card">
                                                <img src="/logo.svg" alt="ShivWorks" class="prelaunch-logo" />
                                                <p class="prelaunch-eyebrow">Founding Member Access</p>
                                                <h2 class="prelaunch-title">Content drops June 1, 2026</h2>
                                                <p class="prelaunch-copy">
                                                        The full curriculum unlocks on launch day. You'll find this module live here the moment
                                                        Craig opens the lane.
                                                </p>
                                        </div>
                                {:else}
                                        <div class="prelaunch-card">
                                                <Lock size={28} />
                                                <h2 class="prelaunch-title">This module is not live yet</h2>
                                                <p class="prelaunch-copy">
                                                        Playback opens here as soon as ShivWorks marks the module available.
                                                </p>
                                        </div>
                                {/if}
                        </div>

                        {#if selectedModule}
                                <div class="module-meta">
                                        <p class="module-eyebrow">
                                                Module {selectedModule.sortOrder}
                                                {#if selectedModule.durationLabel}
                                                        <span class="dot">·</span>
                                                        <span>{selectedModule.durationLabel}</span>
                                                {/if}
                                                {#if selectedProgress?.completedAt}
                                                        <span class="dot">·</span>
                                                        <span class="badge-complete">Completed</span>
                                                {/if}
                                        </p>
                                        <h1 class="module-title">{selectedModule.title}</h1>
                                        <p class="module-description">{getDescriptionSentences(selectedModule.description)}</p>

                                        <div class="module-nav">
                                                {#if previousModule}
                                                        <a
                                                                class="nav-button ghost"
                                                                href={`/library/${data.course.slug}?module=${previousModule.id}`}
                                                        >
                                                                <ArrowLeft size={16} />
                                                                <span class="nav-label">
                                                                        <span class="nav-hint">Previous</span>
                                                                        <strong>{previousModule.title}</strong>
                                                                </span>
                                                        </a>
                                                {:else}
                                                        <span></span>
                                                {/if}
                                                {#if nextModule}
                                                        <a
                                                                class="nav-button primary"
                                                                href={`/library/${data.course.slug}?module=${nextModule.id}`}
                                                        >
                                                                <span class="nav-label">
                                                                        <span class="nav-hint">Next</span>
                                                                        <strong>{nextModule.title}</strong>
                                                                </span>
                                                                <ArrowRight size={16} />
                                                        </a>
                                                {/if}
                                        </div>

                                        {#if saveFeedback}
                                                <p class="save-feedback" role="status">{saveFeedback}</p>
                                        {/if}
                                </div>
                        {/if}

                        {#if selectedModule && moduleEpisodes.length > 0}
                                <section class="episode-list" aria-label="Episodes for this module">
                                        <div class="episode-list-header">
                                                <p class="episode-list-eyebrow">Episodes</p>
                                                <h2 class="episode-list-title">
                                                        {moduleEpisodes.length} episode{moduleEpisodes.length === 1 ? '' : 's'} in this module
                                                </h2>
                                        </div>

                                        <ol class="episode-rows">
                                                {#each moduleEpisodes as episode (episode.id)}
                                                        {@const epProgress = progressByEpisode[episode.id]}
                                                        {@const progressLabel = formatEpisodeProgress(epProgress)}
                                                        {@const isActive = selectedEpisode?.id === episode.id}
                                                        <li>
                                                                <a
                                                                        class="episode-row"
                                                                        class:active={isActive}
                                                                        class:locked={!episode.playable}
                                                                        href={`/library/${data.course.slug}?module=${selectedModule.id}&episode=${episode.id}`}
                                                                >
                                                                        <span class="episode-index" aria-hidden="true">
                                                                                {#if epProgress?.completedAt}
                                                                                        <Check size={14} />
                                                                                {:else if !episode.playable}
                                                                                        <Lock size={12} />
                                                                                {:else}
                                                                                        {episode.episodeNumber}
                                                                                {/if}
                                                                        </span>
                                                                        <span class="episode-body">
                                                                                <span class="episode-title">{episode.title}</span>
                                                                                {#if episode.description}
                                                                                        <span class="episode-desc">{episode.description}</span>
                                                                                {/if}
                                                                                <span class="episode-meta">
                                                                                        {#if episode.durationLabel}
                                                                                                <span>{episode.durationLabel}</span>
                                                                                        {/if}
                                                                                        {#if episode.ingestStatus === 'failed'}
                                                                                                <span class="episode-status episode-status-failed">Failed to process</span>
                                                                                        {:else if episode.ingestStatus && episode.ingestStatus !== 'ready'}
                                                                                                <span class="episode-status">Processing</span>
                                                                                        {/if}
                                                                                        {#if progressLabel}
                                                                                                <span class="episode-status">{progressLabel}</span>
                                                                                        {/if}
                                                                                </span>
                                                                        </span>
                                                                </a>
                                                        </li>
                                                {/each}
                                        </ol>

                                        {#if episodeSaveFeedback}
                                                <p class="save-feedback" role="status">{episodeSaveFeedback}</p>
                                        {/if}
                                </section>
                        {/if}
                </main>

                <aside
                        class="curriculum"
                        class:open={curriculumOpen}
                        aria-label="Course curriculum"
                >
                        <div class="curriculum-header">
                                <div>
                                        <p class="curriculum-eyebrow">Curriculum</p>
                                        <h2 class="curriculum-title">{data.course.title}</h2>
                                        <p class="curriculum-progress">{completedCount} of {data.modules.length} complete</p>
                                </div>
                                <button
                                        class="curriculum-close"
                                        type="button"
                                        onclick={() => (curriculumOpen = false)}
                                        aria-label="Close curriculum"
                                >
                                        <X size={18} />
                                </button>
                        </div>

                        <ol class="curriculum-list">
                                {#each data.modules as module (module.id)}
                                        {@const kind = getModuleStatusKind(module.id, module.status, module.videoUrl)}
                                        {@const isActive = module.id === selectedModule?.id}
                                        <li>
                                                <a
                                                        class="module-row"
                                                        class:active={isActive}
                                                        class:locked={kind === 'locked'}
                                                        href={`/library/${data.course.slug}?module=${module.id}`}
                                                        aria-current={isActive ? 'true' : undefined}
                                                >
                                                        <span class="module-status" aria-hidden="true">
                                                                {#if kind === 'completed'}
                                                                        <Check size={16} />
                                                                {:else if kind === 'locked'}
                                                                        <Lock size={14} />
                                                                {:else}
                                                                        <CircleDot size={14} />
                                                                {/if}
                                                        </span>
                                                        <span class="module-info">
                                                                <span class="module-row-title">{module.title}</span>
                                                                <span class="module-row-meta">
                                                                        <span>Module {module.sortOrder}</span>
                                                                        {#if module.durationLabel}
                                                                                <span class="dot">·</span>
                                                                                <span>{module.durationLabel}</span>
                                                                        {/if}
                                                                </span>
                                                        </span>
                                                </a>
                                        </li>
                                {/each}
                        </ol>
                </aside>

                {#if curriculumOpen}
                        <button
                                class="curriculum-backdrop"
                                type="button"
                                aria-label="Close curriculum"
                                onclick={() => (curriculumOpen = false)}
                        ></button>
                {/if}
        </div>
</section>

