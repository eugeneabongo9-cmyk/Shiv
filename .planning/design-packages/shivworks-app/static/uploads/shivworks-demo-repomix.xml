<script lang="ts">
        import type { DossierActivityEntry, TrainingAction } from '$lib/server/gamification';
        interface Props { entries: DossierActivityEntry[]; }
        let { entries }: Props = $props();

        const ACTION_LABELS: Record<TrainingAction, string> = {
                module_complete: 'Completed a module',
                course_complete: 'Completed a course',
                roadshow_episode_watch: 'Watched a Roadshow episode',
                live_session_rsvp: 'RSVP\u2019d to a live session',
                live_session_attend: 'Attended a live session',
                intro_post: 'Introduced yourself',
                community_post: 'Posted in the community',
                community_reply: 'Replied in a thread',
                aar_post: 'Submitted an after-action report',
                profile_complete: 'Completed your training profile',
                onboarding_checklist_complete: 'Completed the onboarding checklist',
                streak_7day_bonus: '7-day streak bonus',
                streak_30day_bonus: '30-day streak bonus',
                recognition_received: 'Received peer recognition'
        };

        function actionLabel(a: TrainingAction): string {
                return ACTION_LABELS[a] ?? a.replace(/_/g, ' ');
        }
        function rel(ms: number): string {
                const diff = Date.now() - ms;
                const day = 86400000;
                if (diff < day) return 'today';
                if (diff < 2 * day) return 'yesterday';
                const days = Math.floor(diff / day);
                if (days < 7) return `${days}d ago`;
                if (days < 30) return `${Math.floor(days / 7)}w ago`;
                return new Date(ms).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }
</script>

<section class="activity">
        <h3>Recent Activity (last 30 days)</h3>
        {#if entries.length === 0}
                <p class="empty">No training activity in the last 30 days.</p>
        {:else}
                <ul>
                        {#each entries as e}
                                <li>
                                        <span class="time">{rel(e.createdAt)}</span>
                                        <span class="text">{actionLabel(e.action)}</span>
                                        <span class="pts">+{e.points} TP</span>
                                </li>
                        {/each}
                </ul>
        {/if}
</section>

