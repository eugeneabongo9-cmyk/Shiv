<script lang="ts">
        import '../app.css';
        import { page } from '$app/stores';
        import Nav from '$lib/components/Nav.svelte';
        import Footer from '$lib/components/Footer.svelte';
        import Sidebar from '$lib/components/Sidebar.svelte';
        import DmListener from '$lib/components/DmListener.svelte';
        import type { LayoutData } from './$types';

        interface Props {
                data: LayoutData;
                children: import('svelte').Snippet;
        }

        let { data, children }: Props = $props();

        let savingPreview = $state(false);

        const PREVIEW_ROLE_LABELS: Record<string, string> = {
                member: 'Member',
                admin: 'Admin'
        };
        const PREVIEW_TIER_LABELS: Record<string, string> = {
                free: 'Preview',
                bronze: 'Bronze',
                vip: 'VIP'
        };

        function formatPreviewIdentity(role: string, tier: string | null | undefined): string {
                const roleLabel = PREVIEW_ROLE_LABELS[role] ?? role;
                const tierKey = tier ?? 'bronze';
                const tierLabel = PREVIEW_TIER_LABELS[tierKey] ?? tierKey;
                return `${roleLabel} · ${tierLabel}`;
        }

        async function updatePreviewIdentity(next: { role: string; tier: string | null }) {
                if (savingPreview) return;
                savingPreview = true;
                try {
                        const response = await fetch('/api/preview-identity', {
                                method: 'POST',
                                headers: { 'content-type': 'application/json' },
                                body: JSON.stringify({ role: next.role, tier: next.tier ?? 'bronze' })
                        });
                        if (response.ok) {
                                window.location.reload();
                                return;
                        }
                } catch (error) {
                        console.error('Failed to update preview identity', error);
                }
                savingPreview = false;
        }

        async function resetPreviewIdentity() {
                if (savingPreview) return;
                savingPreview = true;
                try {
                        const response = await fetch('/api/preview-identity', { method: 'DELETE' });
                        if (response.ok) {
                                window.location.reload();
                                return;
                        }
                } catch (error) {
                        console.error('Failed to reset preview identity', error);
                }
                savingPreview = false;
        }

        const currentPath = $derived($page.url.pathname);
        const isMarketingPage = $derived(currentPath === '/');
        const isAuthPage = $derived(
                currentPath.startsWith('/login') ||
                currentPath.startsWith('/signup') ||
                currentPath.startsWith('/welcome') ||
                currentPath.startsWith('/checkout')
        );
        const isSidebarPage = $derived(
                data.user?.accessStatus === 'active' &&
                (currentPath.startsWith('/dashboard') ||
                        currentPath.startsWith('/library') ||
                        currentPath.startsWith('/community') ||
                        currentPath.startsWith('/live') ||
                        currentPath.startsWith('/updates') ||
                        currentPath.startsWith('/messages') ||
                        currentPath.startsWith('/vip-calls') ||
                        currentPath.startsWith('/admin'))
        );
        const isAppSurface = $derived(
                isSidebarPage || currentPath.startsWith('/settings')
        );
        const showPreviewBadge = $derived(data.authMode === 'mock' && isAppSurface);
        const showProfileBanner = $derived(
                data.profileSetupRequired && isAppSurface && !currentPath.startsWith('/account')
        );
        const enableDmListener = $derived(
                !!data.user &&
                        data.user.accessStatus === 'active' &&
                        (data.user.tier === 'bronze' || data.user.tier === 'vip' || data.user.role === 'admin')
        );
</script>

{#if enableDmListener}
        <DmListener
                viewerClerkUserId={data.user!.clerkUserId}
                initialUnread={data.dmUnreadCount ?? 0}
        />
{/if}

{#if showPreviewBadge}
        {@const identity = data.previewIdentity ?? { role: 'admin', tier: 'bronze' }}
        <div class="preview-auth-badge" role="status" aria-live="polite">
                <span class="preview-dot" aria-hidden="true"></span>
                <span class="preview-label">Preview auth</span>
                <span class="preview-detail">
                        Clerk disabled · viewing as
                        <strong class="preview-identity">{formatPreviewIdentity(identity.role, identity.tier)}</strong>
                </span>
                <span class="preview-pickers">
                        <label class="preview-picker">
                                <span class="preview-picker-label">Role</span>
                                <select
                                        aria-label="Preview role"
                                        value={identity.role}
                                        onchange={(event) => updatePreviewIdentity({
                                                role: (event.currentTarget as HTMLSelectElement).value,
                                                tier: identity.tier
                                        })}
                                        disabled={savingPreview}
                                >
                                        <option value="member">Member</option>
                                        <option value="admin">Admin</option>
                                </select>
                        </label>
                        <label class="preview-picker">
                                <span class="preview-picker-label">Tier</span>
                                <select
                                        aria-label="Preview tier"
                                        value={identity.tier ?? 'bronze'}
                                        onchange={(event) => updatePreviewIdentity({
                                                role: identity.role,
                                                tier: (event.currentTarget as HTMLSelectElement).value
                                        })}
                                        disabled={savingPreview}
                                >
                                        <option value="free">Preview</option>
                                        <option value="bronze">Bronze</option>
                                        <option value="vip">VIP</option>
                                </select>
                        </label>
                        <button
                                type="button"
                                class="preview-reset"
                                onclick={resetPreviewIdentity}
                                disabled={savingPreview}
                                aria-label="Reset preview identity to defaults"
                        >
                                Reset
                        </button>
                </span>
        </div>
{/if}

{#if showProfileBanner}
        <div class="profile-banner" role="status">
                <span>Complete your training profile to earn 20 TP and appear in the Training Partner Finder.</span>
