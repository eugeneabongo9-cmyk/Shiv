import { error, redirect } from '@sveltejs/kit';
import type { PageServerLoad } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { requirePaidMember } from '$lib/server/guards';
import {
        getMemberByClerkId,
        getMemberProfile,
        getMemberTrainingStats
} from '$lib/server/db/shivworks';
import { getMemberDossier } from '$lib/server/gamification';

export const load: PageServerLoad = async ({ locals, platform, params }) => {
        const viewer = requirePaidMember(locals, `/profile/${params.userId}`);
        const targetId = params.userId;
        if (!targetId) error(400, 'Invalid member id');
        if (targetId === viewer.clerkUserId) {
                redirect(303, '/profile');
        }
        const db = getDBFromPlatform(platform);
        const member = await getMemberByClerkId(db, targetId);
        if (!member || member.accessStatus !== 'active' || (member.tier !== 'bronze' && member.tier !== 'vip')) {
                error(404, 'Member not found');
        }

        const [profile, dossier, stats] = await Promise.all([
                getMemberProfile(db, targetId),
                getMemberDossier(db, targetId),
                getMemberTrainingStats(db, targetId)
        ]);

        const publicMember = {
                clerkUserId: member.clerkUserId,
                name: member.name,
                tier: member.tier,
                createdAt: member.createdAt
        };
        const publicProfile = profile
                ? {
                                locationCity: profile.locationCity,
                                locationState: profile.locationState,
                                ecqcAlumni: profile.ecqcAlumni,
                                mucAlumni: profile.mucAlumni,
                                trainingGoal: profile.trainingGoal,
                                background: profile.background
                  }
                : null;

        return {
                viewer: { clerkUserId: viewer.clerkUserId },
                member: publicMember,
                profile: publicProfile,
                dossier,
                stats,
                viewerIsSelf: false
        };
};
</file>

