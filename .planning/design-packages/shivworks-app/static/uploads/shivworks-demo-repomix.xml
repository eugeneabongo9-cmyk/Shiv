	]);

	function getTierLaneCopy(tier: PaidMembershipTier): string {
		return tier === 'vip' ? 'Highest-touch lane' : 'Core member lane';
	}

	async function startCheckout(tier: PaidMembershipTier) {
		isLoading = tier;
