import type { Actions, PageServerLoad } from './$types';
import { fail } from '@sveltejs/kit';
import { getDBFromPlatform, type D1Compat } from '$lib/server/d1-compat';
import { requireAdminOrInstructor } from '$lib/server/guards';
import {
        addMemberTag,
        bulkListMemberTags,
        listAdminMembers,
        listMemberTags,
        postWeeklyQuestion,
        removeMemberTag
} from '$lib/server/db/shivworks';
import {
        flagInactiveMembersAndNotify,
        getCommunityMetrics,
        getContentMetrics,
        getEngagementMetrics,
        getRetentionMetrics,
        maybeRunReengagementScan
} from '$lib/server/admin-analytics';

function instructorChecker(db: D1Compat) {
        return async (memberId: string): Promise<boolean> => {
                const tags = await listMemberTags(db, memberId);
                return tags.some((t) => t.tagKey === 'instructor');
        };
}

const TAG_KEYS = [
        'ecqc_alumni',
        'muc_alumni',
        'le',
        'military',
        'vip',
        'state',
        'instructor'
] as const;
const ALLOWED_TAG_KEYS = new Set<string>(TAG_KEYS);

function readText(data: FormData, key: string): string {
        return String(data.get(key) || '').trim();
}

export const load: PageServerLoad = async ({ locals, platform, url }) => {
        const db = getDBFromPlatform(platform);
        const actor = await requireAdminOrInstructor(locals, instructorChecker(db));
        const isAdmin = actor.role === 'admin';

        // Deterministic auto-trigger: at most once per throttle window, scan
        // for 14+ day inactive members and enqueue re-engagement notifications.
        // Manual admin button below remains as an override.
        await maybeRunReengagementScan(db);

        const tagFilter = (url.searchParams.get('tag') || '').trim();
        const tagValueFilter = (url.searchParams.get('tagValue') || '').trim();

        const [members, engagement, retention, content, community] = await Promise.all([
                listAdminMembers(db),
                getEngagementMetrics(db),
                getRetentionMetrics(db),
                getContentMetrics(db),
                getCommunityMetrics(db, { includeRecognitionLeaderboard: isAdmin })
        ]);

        const tagsByMember = await bulkListMemberTags(
                db,
                members.map((m) => m.clerkUserId)
        );

        const decoratedMembers = members.map((m) => ({
                clerkUserId: m.clerkUserId,
                name: m.name,
                email: m.email,
                tier: m.tier,
                accessStatus: m.accessStatus,
                role: m.role,
                tags: tagsByMember.get(m.clerkUserId) ?? []
        }));

        const filteredMembers = tagFilter
                ? decoratedMembers.filter((m) =>
                                m.tags.some(
                                        (t) =>
                                                t.tagKey === tagFilter &&
                                                (!tagValueFilter || (t.tagValue || '').toLowerCase() === tagValueFilter.toLowerCase())
                                )
                  )
                : decoratedMembers;

        return {
                engagement,
                retention,
                content,
                community,
                members: filteredMembers,
                tagFilter,
                tagValueFilter,
                tagKeys: TAG_KEYS,
                isAdmin
        };
};

export const actions: Actions = {
        addTag: async ({ request, locals, platform }) => {
                const db = getDBFromPlatform(platform);
                const actor = await requireAdminOrInstructor(locals, instructorChecker(db));
                const data = await request.formData();
                const memberId = readText(data, 'memberId');
                const tagKey = readText(data, 'tagKey');
                const tagValue = readText(data, 'tagValue') || null;
                if (!memberId || !tagKey) {
                        return fail(400, { error: 'Member and tag are required.' });
                }
                if (!ALLOWED_TAG_KEYS.has(tagKey)) {
                        return fail(400, { error: 'Unknown tag.' });
                }
                await addMemberTag(db, { memberId, tagKey, tagValue, assignedBy: actor.clerkUserId });
                return { success: 'Tag added.' };
        },

        removeTag: async ({ request, locals, platform }) => {
                const db = getDBFromPlatform(platform);
                await requireAdminOrInstructor(locals, instructorChecker(db));
                const data = await request.formData();
                const memberId = readText(data, 'memberId');
                const tagKey = readText(data, 'tagKey');
                const tagValue = readText(data, 'tagValue') || null;
                if (!memberId || !tagKey) {
                        return fail(400, { error: 'Member and tag are required.' });
                }
                if (!ALLOWED_TAG_KEYS.has(tagKey)) {
                        return fail(400, { error: 'Unknown tag.' });
                }
                await removeMemberTag(db, { memberId, tagKey, tagValue });
                return { success: 'Tag removed.' };
        },

        postWeeklyQuestion: async ({ request, locals, platform }) => {
                const db = getDBFromPlatform(platform);
                const actor = await requireAdminOrInstructor(locals, instructorChecker(db));
                const data = await request.formData();
                const body = readText(data, 'body');
                if (!body) {
                        return fail(400, { error: 'Question text is required.' });
                }
                await postWeeklyQuestion(db, { authorId: actor.clerkUserId, body, pinned: true });
                return { success: 'Weekly question posted and pinned in #weekly-question.' };
        },

        runReengagementCheck: async ({ locals, platform }) => {
                const db = getDBFromPlatform(platform);
                await requireAdminOrInstructor(locals, instructorChecker(db));
                const result = await flagInactiveMembersAndNotify(db);
                return {
                        success: `${result.flagged} member${result.flagged === 1 ? '' : 's'} flagged inactive. ${result.notified} new notification${result.notified === 1 ? '' : 's'} sent, ${result.skipped} already nudged.`
                };
        }
};
