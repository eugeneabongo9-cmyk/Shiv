import { POST as initPost } from './init/+server';
import { POST as completePost } from './complete/+server';
import { POST as webhookPost } from '../../../webhooks/stream/+server';
import { GET as playbackGet } from '../../../library/episodes/[episodeId]/playback/+server';
import { getDB } from '$lib/server/d1-compat';
import { setEpisodeStatus } from '$lib/server/db/shivworks';
import { buildSignedHlsUrl } from '$lib/server/stream';

const ADMIN_CLERK_ID = 'user_admin_lifecycle';
const MEMBER_CLERK_ID = 'user_member_lifecycle';
const COURSE_ID = 'course_lifecycle';
const MODULE_ID = 'module_lifecycle';

function adminUser(): NonNullable<App.Locals['user']> {
        return {
                clerkUserId: ADMIN_CLERK_ID,
                email: 'admin@example.com',
                name: 'Admin Tester',
                tier: 'vip',
                accessStatus: 'active',
                role: 'admin',
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString()
        };
}

function memberUser(): NonNullable<App.Locals['user']> {
        return {
                clerkUserId: MEMBER_CLERK_ID,
                email: 'member@example.com',
                name: 'Member Tester',
                tier: 'bronze',
                accessStatus: 'active',
                role: 'member',
                createdAt: new Date().toISOString(),
                updatedAt: new Date().toISOString()
        };
}

function locals(user: NonNullable<App.Locals['user']> | null): App.Locals {
        return {
                auth: {
                        userId: user?.clerkUserId ?? null,
                        sessionId: user ? 'sess_test' : null,
                        isAuthenticated: Boolean(user)
                },
                user,
                authMode: 'mock'
        };
}

const platform = { env: {} } as App.Platform;

function signedWebhookHeader(body: string, timestampOverride?: number): string {
        const timestamp = timestampOverride ?? Math.floor(Date.now() / 1000);
        const signature = createHmac('sha256', WEBHOOK_SECRET)
                .update(`${timestamp}.${body}`)
                .digest('hex');
        return `time=${timestamp},sig1=${signature}`;
}

async function seedFixtures(): Promise<void> {
        const db = getDB();
        const now = Date.now();

        await db
                .prepare(
                        `INSERT INTO members (clerk_user_id, email, name, tier, access_status, role, email_verified, created_at, updated_at)
                         VALUES (?, ?, ?, 'vip', 'active', 'admin', 1, ?, ?)`
                )
                .bind(ADMIN_CLERK_ID, 'admin@example.com', 'Admin Tester', now, now)
                .run();

        await db
                .prepare(
                        `INSERT INTO members (clerk_user_id, email, name, tier, access_status, role, email_verified, created_at, updated_at)
                         VALUES (?, ?, ?, 'bronze', 'active', 'member', 1, ?, ?)`
                )
                .bind(MEMBER_CLERK_ID, 'member@example.com', 'Member Tester', now, now)
                .run();

        await db
                .prepare(
                        `INSERT INTO courses (id, slug, title, description, status, sort_order, course_kind, access_tier, created_at, updated_at)
                         VALUES (?, ?, ?, ?, 'available', 1, 'course', 'member', ?, ?)`
                )
                .bind(COURSE_ID, 'lifecycle-course', 'Lifecycle Course', 'Test course', now, now)
                .run();

        await db
                .prepare(
                        `INSERT INTO course_modules (id, course_id, title, description, sort_order, status, created_at, updated_at)
                         VALUES (?, ?, ?, ?, 1, 'available', ?, ?)`
                )
                .bind(MODULE_ID, COURSE_ID, 'Lifecycle Module', 'Test module', now, now)
                .run();
}

beforeAll(async () => {
        await seedFixtures();
});

afterAll(() => {
        rmSync(tmpDir, { recursive: true, force: true });
});

beforeEach(() => {
        createTusDirectUploadMock.mockClear();
        createStreamPlaybackTokenMock.mockClear();
        sendMediaUploadFailedEmailMock.mockClear();
});

describe('video upload lifecycle: init → webhook ready → signed playback', () => {
        it('reserves an episode, accepts the Stream webhook, and returns a signed playback URL', async () => {
                const initRes = await initPost({
                        request: new Request('https://network.shivworks.com/api/admin/media/uploads/init', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                        moduleId: MODULE_ID,
                                        title: 'Lifecycle Episode',
                                        description: 'integration test',
                                        fileSizeBytes: 1_000_000,
                                        fileName: 'lifecycle.mp4',
                                        playbackPolicy: 'private'
                                })
                        }),
                        locals: locals(adminUser()),
                        platform
                } as never);

                expect(initRes.status).toBe(200);
                const initBody = await initRes.json();
                expect(initBody).toMatchObject({
                        success: true,
                        data: {
                                streamUid: STREAM_UID,
                                tusResumable: '1.0.0',
                                ingestStatus: 'pending_upload'
                        }
                });
                expect(initBody.data.mediaAssetId).toEqual(expect.any(String));
                expect(initBody.data.episodeId).toEqual(expect.any(String));
                expect(createTusDirectUploadMock).toHaveBeenCalledTimes(1);

                const { mediaAssetId, episodeId } = initBody.data as {
                        mediaAssetId: string;
                        episodeId: string;
                };

                const completeRes = await completePost({
                        request: new Request('https://network.shivworks.com/api/admin/media/uploads/complete', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ mediaAssetId })
                        }),
                        locals: locals(adminUser()),
                        platform
                } as never);

                expect(completeRes.status).toBe(200);
                expect(await completeRes.json()).toMatchObject({
                        success: true,
                        data: { ingestStatus: 'processing', streamUid: STREAM_UID }
                });

                const webhookBody = JSON.stringify({
                        uid: STREAM_UID,
                        readyToStream: true,
                        status: { state: 'ready' },
                        duration: 123.4,
                        size: 999_888
                });
                const webhookRes = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: {
                                        'Content-Type': 'application/json',
                                        'webhook-signature': signedWebhookHeader(webhookBody)
                                },
                                body: webhookBody
                        }),
                        platform
                } as never);

                expect(webhookRes.status).toBe(200);
                expect(await webhookRes.json()).toMatchObject({
                        success: true,
                        data: { mediaAssetId, streamUid: STREAM_UID, ingestStatus: 'ready' }
                });

                // Admin still needs to flip the episode to available before members can play it.
                await setEpisodeStatus(getDB(), episodeId, 'available');

                const playbackRes = await playbackGet({
                        params: { episodeId },
                        locals: locals(memberUser()),
                        platform
                } as never);

                expect(playbackRes.status).toBe(200);
                const playbackBody = await playbackRes.json();
                expect(playbackBody).toMatchObject({
                        success: true,
                        data: {
                                episodeId,
                                provider: 'cloudflare_stream',
                                playbackType: 'hls',
                                url: buildSignedHlsUrl(SIGNED_PLAYBACK_TOKEN),
                                durationSeconds: 123
                        }
                });
                expect(typeof playbackBody.data.expiresAt).toBe('number');
                expect(createStreamPlaybackTokenMock).toHaveBeenCalledTimes(1);
                expect(createStreamPlaybackTokenMock).toHaveBeenCalledWith(
                        expect.any(Object),
                        STREAM_UID,
                        expect.any(Number)
                );
        });
});

describe('video upload lifecycle: init → webhook error → playback blocked', () => {
        it('flips ingest_status to failed and surfaces the failure reason on playback', async () => {
                const FAILED_STREAM_UID = 'stream-uid-lifecycle-failed';
                const FAILURE_REASON = 'ERR_TRANSCODE_BROKEN_INPUT';

                createTusDirectUploadMock.mockResolvedValueOnce({
                        streamUid: FAILED_STREAM_UID,
                        uploadUrl: `https://upload.videodelivery.net/tus/${FAILED_STREAM_UID}`,
                        expiresAt: Math.floor(Date.now() / 1000) + 3600
                });

                const initRes = await initPost({
                        request: new Request('https://network.shivworks.com/api/admin/media/uploads/init', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                        moduleId: MODULE_ID,
                                        title: 'Failed Lifecycle Episode',
                                        description: 'integration test (failure)',
                                        fileSizeBytes: 1_000_000,
                                        fileName: 'lifecycle-failed.mp4',
                                        playbackPolicy: 'private'
                                })
                        }),
                        locals: locals(adminUser()),
                        platform
                } as never);

                expect(initRes.status).toBe(200);
                const initBody = await initRes.json();
                const { mediaAssetId, episodeId } = initBody.data as {
                        mediaAssetId: string;
                        episodeId: string;
                };
                expect(initBody.data.streamUid).toBe(FAILED_STREAM_UID);

                const completeRes = await completePost({
                        request: new Request('https://network.shivworks.com/api/admin/media/uploads/complete', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ mediaAssetId })
                        }),
                        locals: locals(adminUser()),
                        platform
                } as never);
                expect(completeRes.status).toBe(200);

                const webhookBody = JSON.stringify({
                        uid: FAILED_STREAM_UID,
                        readyToStream: false,
                        status: { state: 'error', errorReasonText: FAILURE_REASON }
                });
                const webhookRes = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: {
                                        'Content-Type': 'application/json',
                                        'webhook-signature': signedWebhookHeader(webhookBody)
                                },
                                body: webhookBody
                        }),
                        platform
                } as never);

                expect(webhookRes.status).toBe(200);
                expect(await webhookRes.json()).toMatchObject({
                        success: true,
                        data: { mediaAssetId, streamUid: FAILED_STREAM_UID, ingestStatus: 'failed' }
                });

                const db = getDB();
                const row = await db
                        .prepare(`SELECT ingest_status, failure_reason FROM media_assets WHERE id = ?`)
                        .bind(mediaAssetId)
                        .first<{ ingest_status: string; failure_reason: string | null }>();
                expect(row?.ingest_status).toBe('failed');
                expect(row?.failure_reason).toBe(FAILURE_REASON);

                // Admin still flips the episode to available; playback guard must block on ingest_status.
                await setEpisodeStatus(getDB(), episodeId, 'available');

                const playbackRes = await playbackGet({
                        params: { episodeId },
                        locals: locals(memberUser()),
                        platform
                } as never);

                expect(playbackRes.status).toBe(409);
                const playbackBody = await playbackRes.json();
                expect(playbackBody).toMatchObject({
                        success: false,
                        ingestStatus: 'failed',
                        failureReason: FAILURE_REASON
                });
                expect(createStreamPlaybackTokenMock).not.toHaveBeenCalled();

                // The uploading admin should have been emailed exactly once about the failure.
                expect(sendMediaUploadFailedEmailMock).toHaveBeenCalledTimes(1);
                expect(sendMediaUploadFailedEmailMock).toHaveBeenCalledWith(
                        expect.any(Object),
                        expect.objectContaining({
                                email: 'admin@example.com',
                                videoTitle: 'Failed Lifecycle Episode',
                                failureReason: FAILURE_REASON
                        })
                );

                // A Cloudflare retry of the same failure must not re-send the email.
                const retryRes = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: {
                                        'Content-Type': 'application/json',
                                        'webhook-signature': signedWebhookHeader(webhookBody)
                                },
                                body: webhookBody
                        }),
                        platform
                } as never);
                expect(retryRes.status).toBe(200);
                expect(sendMediaUploadFailedEmailMock).toHaveBeenCalledTimes(1);
        });
});

describe('Cloudflare Stream webhook signature verification', () => {
        const body = JSON.stringify({
                uid: 'irrelevant-uid-for-signature-tests',
                readyToStream: true,
                status: { state: 'ready' }
        });

        it('accepts a request with a valid signature within the replay window', async () => {
                const res = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: {
                                        'Content-Type': 'application/json',
                                        'webhook-signature': signedWebhookHeader(body)
                                },
                                body
                        }),
                        platform
                } as never);

                // Unknown stream UID returns 202 ignored — but the signature must have been accepted to get here.
                expect([200, 202]).toContain(res.status);
                const payload = await res.json();
                expect(payload.success).toBe(true);
        });

        it('rejects a request whose HMAC does not match the body', async () => {
                const validHeader = signedWebhookHeader(body);
                const tamperedHeader = validHeader.replace(/sig1=[0-9a-f]+/, 'sig1=' + 'a'.repeat(64));

                const res = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: {
                                        'Content-Type': 'application/json',
                                        'webhook-signature': tamperedHeader
                                },
                                body
                        }),
                        platform
                } as never);

                expect(res.status).toBe(401);
                expect(await res.json()).toMatchObject({ success: false, error: 'Invalid webhook signature' });
        });

        it('rejects a request whose timestamp falls outside the 5-minute replay window', async () => {
                const staleTimestamp = Math.floor(Date.now() / 1000) - 6 * 60;
                const res = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: {
                                        'Content-Type': 'application/json',
                                        'webhook-signature': signedWebhookHeader(body, staleTimestamp)
                                },
                                body
                        }),
                        platform
                } as never);

                expect(res.status).toBe(401);
                expect(await res.json()).toMatchObject({ success: false, error: 'Invalid webhook signature' });
        });

        it('rejects a request with a missing signature header', async () => {
                const res = await webhookPost({
                        request: new Request('https://network.shivworks.com/api/webhooks/stream', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body
                        }),
                        platform
                } as never);

                expect(res.status).toBe(401);
        });
});
