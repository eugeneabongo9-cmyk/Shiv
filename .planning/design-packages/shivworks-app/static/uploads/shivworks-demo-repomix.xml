import type { RequestHandler } from './$types';
import { requirePaidMember } from '$lib/server/guards';
import { subscribe, userTopic, type RealtimeEvent } from '$lib/server/realtime';

const HEARTBEAT_MS = 25_000;

/**
 * SSE transport for direct messaging. Subscribes the caller to their
 * own user topic only. The same broker that powers the community feed
 * delivers `dm.created` events here.
 */
export const GET: RequestHandler = async ({ locals, request }) => {
	const user = requirePaidMember(locals, '/messages');
	const topic = userTopic(user.clerkUserId);

	const encoder = new TextEncoder();
	let unsubscribe: (() => void) | null = null;
	let heartbeat: ReturnType<typeof setInterval> | null = null;
	let cleaned = false;

	const cleanup = () => {
		if (cleaned) return;
		cleaned = true;
		if (heartbeat) {
			clearInterval(heartbeat);
			heartbeat = null;
		}
		if (unsubscribe) {
			unsubscribe();
			unsubscribe = null;
		}
	};

	const stream = new ReadableStream<Uint8Array>({
		start(controller) {
			const send = (event: RealtimeEvent) => {
				try {
					const frame = `event: ${event.kind}\ndata: ${JSON.stringify(event)}\n\n`;
					controller.enqueue(encoder.encode(frame));
				} catch (err) {
					console.error('[messages/stream] enqueue failed', err);
				}
			};
			unsubscribe = subscribe([topic], send);
			controller.enqueue(
				encoder.encode(`event: ready\ndata: ${JSON.stringify({ topic })}\n\n`)
			);
			heartbeat = setInterval(() => {
				try {
					controller.enqueue(encoder.encode(`: ping\n\n`));
				} catch {
					cleanup();
				}
			}, HEARTBEAT_MS);
			request.signal.addEventListener('abort', () => {
				cleanup();
				try {
					controller.close();
				} catch {
					// already closed
				}
			});
		},
		cancel() {
			cleanup();
		}
	});

	return new Response(stream, {
		headers: {
			'content-type': 'text/event-stream',
			'cache-control': 'no-cache, no-transform',
			connection: 'keep-alive',
			'x-accel-buffering': 'no'
		}
	});
};
</file>

