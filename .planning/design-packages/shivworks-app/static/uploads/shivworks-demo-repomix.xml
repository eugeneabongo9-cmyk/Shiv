import { mkdtempSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { beforeEach, describe, expect, it } from 'vitest';

const tmpDir = mkdtempSync(join(tmpdir(), 'onboarding-'));
process.env.DATABASE_PATH = join(tmpDir, 'test.db');
process.env.SHIVWORKS_DB_MODE = 'sqlite';
delete process.env.DATABASE_URL;

import { getDB } from './d1-compat';
import { awardPoints } from './gamification';
import {
        computeOnboardingChecklist,
        dismissOnboardingChecklist,
        finalizeOnboardingIfReady
} from './onboarding';
import { createChannelMessage, upsertMemberProfile } from './db/shivworks';

const db = getDB();

let counter = 0;
function nextId(prefix = 'm'): string {
        counter += 1;
        return `${prefix}-${Date.now()}-${counter}`;
}

async function seedMember(id: string) {
        const now = Date.now();
        await db
                .prepare(
                        `INSERT OR REPLACE INTO members (clerk_user_id, email, name, tier, access_status, role, created_at, updated_at)
                         VALUES (?, ?, ?, 'bronze', 'active', 'member', ?, ?)`
                )
                .bind(id, `${id}@test.local`, id, now, now)
                .run();
}

async function seedWeeklyQuestionChannel(): Promise<string> {
        const id = `ch-${Date.now()}-${++counter}`;
        const now = Date.now();
        await db
                .prepare(
                        `INSERT OR REPLACE INTO channels
                                (id, slug, name, description, category, category_sort, channel_sort, vip_only, read_only, created_at, updated_at)
                         VALUES (?, 'weekly-question', 'Weekly Question', '', 'general', 0, 0, 0, 0, ?, ?)`
                )
                .bind(id, now, now)
                .run();
        return id;
}

describe('onboarding checklist', () => {
        beforeEach(async () => {
                await db.prepare('DELETE FROM member_training_points').run();
                await db.prepare('DELETE FROM member_milestones').run();
                await db.prepare('DELETE FROM member_streaks').run();
                await db.prepare('DELETE FROM onboarding_checklist_progress').run();
                await db.prepare('DELETE FROM messages').run();
                await db.prepare('DELETE FROM channels').run();
                await db.prepare('DELETE FROM member_profiles').run();
                await db.prepare('DELETE FROM members').run();
        });

        it('reports zero progress for a brand-new member', async () => {
                const id = nextId();
                await seedMember(id);
                const state = await computeOnboardingChecklist(db, id, { memberCreatedAt: Date.now() });
                expect(state.totalCount).toBe(5);
                expect(state.completedCount).toBe(0);
                expect(state.visible).toBe(true);
                expect(state.completed).toBe(false);
        });

        it('hides the checklist for legacy members past the first-time window', async () => {
                const id = nextId();
                await seedMember(id);
                const longAgo = Date.now() - 365 * 24 * 60 * 60 * 1000;
                const state = await computeOnboardingChecklist(db, id, { memberCreatedAt: longAgo });
                expect(state.visible).toBe(false);
        });

        it('keeps the checklist visible for legacy members who have an in-flight progress row', async () => {
                const id = nextId();
                await seedMember(id);
                const longAgo = Date.now() - 365 * 24 * 60 * 60 * 1000;
                // Member has interacted with the checklist before (e.g., one item ticked)
                // so they keep seeing it past the window until they finish or dismiss.
                await db
                        .prepare(
                                `INSERT INTO onboarding_checklist_progress
                                        (member_id, profile_completed_at, introduced_at, first_module_at,
                                         first_rsvp_at, weekly_question_at, completed_at, dismissed_at,
                                         created_at, updated_at)
                                 VALUES (?, ?, NULL, NULL, NULL, NULL, NULL, NULL, ?, ?)`
                        )
                        .bind(id, Date.now(), Date.now(), Date.now())
                        .run();
                const state = await computeOnboardingChecklist(db, id, { memberCreatedAt: longAgo });
                expect(state.visible).toBe(true);
        });

        it('marks profile complete when profileCompletedAt is set', async () => {
                const id = nextId();
                await seedMember(id);
                await upsertMemberProfile(db, id, { profileCompletedAt: Date.now() });
                const state = await computeOnboardingChecklist(db, id);
                const profileItem = state.items.find((i) => i.key === 'profile')!;
                expect(profileItem.complete).toBe(true);
                expect(state.completedCount).toBe(1);
        });

        it('derives intro/module/RSVP completion from training-point events', async () => {
                const id = nextId();
                await seedMember(id);
                await awardPoints(db, { memberId: id, action: 'intro_post' });
                await awardPoints(db, { memberId: id, action: 'module_complete', referenceId: 'mod-1' });
                await awardPoints(db, { memberId: id, action: 'live_session_rsvp', referenceId: 'sess-1' });
                const state = await computeOnboardingChecklist(db, id);
                const map = Object.fromEntries(state.items.map((i) => [i.key, i.complete]));
                expect(map.introduce).toBe(true);
                expect(map.first_module).toBe(true);
                expect(map.rsvp_live).toBe(true);
        });

        it('marks weekly_question complete when the member has posted in that channel', async () => {
                const id = nextId();
                await seedMember(id);
                const channelId = await seedWeeklyQuestionChannel();
                await createChannelMessage(db, { channelId, authorId: id, body: 'My answer' });
                const state = await computeOnboardingChecklist(db, id);
                const item = state.items.find((i) => i.key === 'weekly_question')!;
                expect(item.complete).toBe(true);
        });

        it('finalizeOnboardingIfReady is a no-op when not all items are complete', async () => {
                const id = nextId();
                await seedMember(id);
                const result = await finalizeOnboardingIfReady(db, id, { memberCreatedAt: Date.now() });
                expect(result.awarded).toBe(0);
                expect(result.eligible).toBe(true);
                expect(result.state.completed).toBe(false);
        });

        it('finalizeOnboardingIfReady refuses legacy members past the first-time window', async () => {
                const id = nextId();
                await seedMember(id);
                const longAgo = Date.now() - 365 * 24 * 60 * 60 * 1000;
                await upsertMemberProfile(db, id, { profileCompletedAt: Date.now() });
                await awardPoints(db, { memberId: id, action: 'intro_post' });
                await awardPoints(db, { memberId: id, action: 'module_complete', referenceId: 'mod-1' });
                await awardPoints(db, { memberId: id, action: 'live_session_rsvp', referenceId: 'sess-1' });
                const channelId = await seedWeeklyQuestionChannel();
                await createChannelMessage(db, { channelId, authorId: id, body: 'q1' });

                const result = await finalizeOnboardingIfReady(db, id, { memberCreatedAt: longAgo });
                expect(result.eligible).toBe(false);
                expect(result.awarded).toBe(0);
                // No 'ready' milestone should have been awarded.
                const milestoneRow = await db
                        .prepare(`SELECT milestone_key FROM member_milestones WHERE member_id = ? AND milestone_key = 'ready'`)
                        .bind(id)
                        .first<{ milestone_key: string }>();
                expect(milestoneRow).toBeNull();
        });

        it('finalizeOnboardingIfReady awards 50 TP once and is idempotent', async () => {
                const id = nextId();
                await seedMember(id);
                await upsertMemberProfile(db, id, { profileCompletedAt: Date.now() });
                await awardPoints(db, { memberId: id, action: 'intro_post' });
                await awardPoints(db, { memberId: id, action: 'module_complete', referenceId: 'mod-1' });
                await awardPoints(db, { memberId: id, action: 'live_session_rsvp', referenceId: 'sess-1' });
                const channelId = await seedWeeklyQuestionChannel();
                await createChannelMessage(db, { channelId, authorId: id, body: 'q1' });

                // Pre-finalize: all items complete but checklist still visible so the
                // user can press the "Claim" button.
                const pre = await computeOnboardingChecklist(db, id, { memberCreatedAt: Date.now() });
                expect(pre.completedCount).toBe(pre.totalCount);
                expect(pre.completed).toBe(false);
                expect(pre.visible).toBe(true);

                const first = await finalizeOnboardingIfReady(db, id, { memberCreatedAt: Date.now() });
                expect(first.eligible).toBe(true);
                expect(first.awarded).toBe(50);
                expect(first.state.completed).toBe(true);
                expect(first.state.visible).toBe(false);

                // Ready milestone must be awarded by the gamification engine.
                const milestoneRow = await db
                        .prepare(`SELECT milestone_key FROM member_milestones WHERE member_id = ? AND milestone_key = 'ready'`)
                        .bind(id)
                        .first<{ milestone_key: string }>();
                expect(milestoneRow?.milestone_key).toBe('ready');

                // After finalize, checklist is no longer visible, so a second call is refused.
                const second = await finalizeOnboardingIfReady(db, id, { memberCreatedAt: Date.now() });
                expect(second.awarded).toBe(0);
                expect(second.eligible).toBe(false);
                expect(second.state.completed).toBe(true);
        });

        it('dismissOnboardingChecklist hides the checklist for first-time members', async () => {
                const id = nextId();
                await seedMember(id);
                const result = await dismissOnboardingChecklist(db, id, { memberCreatedAt: Date.now() });
                expect(result.eligible).toBe(true);
                expect(result.state.dismissed).toBe(true);
                expect(result.state.visible).toBe(false);
        });

        it('dismissOnboardingChecklist refuses legacy members past the first-time window', async () => {
                const id = nextId();
                await seedMember(id);
                const longAgo = Date.now() - 365 * 24 * 60 * 60 * 1000;
                const result = await dismissOnboardingChecklist(db, id, { memberCreatedAt: longAgo });
                expect(result.eligible).toBe(false);
                expect(result.state.dismissed).toBe(false);
        });
});
