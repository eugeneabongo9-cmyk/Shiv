<script lang="ts">
        import {
                LayoutDashboard,
                BookOpen,
                Film,
                Radio,
                Users,
                Star,
                Settings,
                Shield,
                MessageSquare,
                Trophy,
                UserSearch,
                User,
                ChevronRight
        } from 'lucide-svelte';
        import { page } from '$app/stores';
        import MembershipBadge from '$lib/components/MembershipBadge.svelte';
        import SignOutButton from '$lib/components/SignOutButton.svelte';
        import { SITE_NAME } from '$lib/constants/site';
        import { dmUnreadStore } from '$lib/stores/dm-unread';

        interface Props {
                user: NonNullable<App.Locals['user']>;
                clerkPublishableKey?: string | null;
                coursesStarted?: number;
                coursesTotal?: number;
                isInstructor?: boolean;
        }

        let {
                user,
                clerkPublishableKey = null,
                coursesStarted = 0,
                coursesTotal = 0,
                isInstructor = false
        }: Props = $props();

        const dmUnread = $derived($dmUnreadStore);

        const initials = $derived.by(() => {
                const tokens = user.name
                        .trim()
                        .split(/\s+/)
                        .filter(Boolean)
                        .slice(0, 2);
                return tokens.length > 0 ? tokens.map((t) => t[0]?.toUpperCase() ?? '').join('') : 'SW';
        });

        const firstName = $derived(user.name.trim().split(/\s+/)[0] ?? user.name);

        const currentPath = $derived($page.url.pathname);

        const isPaidMember = $derived(
                user.accessStatus === 'active' && (user.tier === 'bronze' || user.tier === 'vip')
        );

        const navItems: Array<{ href: string; label: string; icon: typeof LayoutDashboard; vipOnly?: boolean; paidOnly?: boolean; badgeKey?: 'dm' }> = [
                { href: '/dashboard', label: 'Dashboard', icon: LayoutDashboard },
                { href: '/library', label: 'Library', icon: BookOpen },
                { href: '/updates', label: 'Updates', icon: Film },
                { href: '/live', label: 'Live', icon: Radio },
                { href: '/community', label: 'Community', icon: Users },
                { href: '/messages', label: 'Messages', icon: MessageSquare, badgeKey: 'dm' },
                { href: '/leaderboard', label: 'Leaderboard', icon: Trophy, paidOnly: true },
                { href: '/find-partners', label: 'Find Partners', icon: UserSearch, paidOnly: true },
                { href: '/vip-calls', label: 'VIP Lounge', icon: Star, vipOnly: true }
        ];

        const visibleNavItems = $derived(
                navItems.filter((item) => {
                        if (item.vipOnly) return user.tier === 'vip' || user.role === 'admin';
                        if (item.paidOnly) return isPaidMember || user.role === 'admin';
                        return true;
                })
        );

        const secondaryItems = $derived([
                ...(isPaidMember || user.role === 'admin'
                        ? [{ href: '/profile', label: 'Profile', icon: User }]
                        : []),
                { href: '/account', label: 'Training Profile', icon: Users },
                { href: '/settings', label: 'Settings', icon: Settings }
        ]);

        const visibleSecondaryItems = $derived(secondaryItems);

        let mobileOpen = $state(false);
</script>

