import { json, error } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { resolveRuntimeEnv } from '$lib/server/env';
import {
        resolveAuthMode,
        serializePreviewIdentity,
        PREVIEW_IDENTITY_COOKIE,
        MOCK_ROLES,
        MOCK_TIERS,
        type MockRole,
        type MockTier
} from '$lib/server/auth-mode';

function assertMockMode(platform: App.Platform | undefined) {
        const runtimeEnv = resolveRuntimeEnv(
                (platform as { env?: Record<string, string | undefined> } | undefined)?.env
        );
        const mode = resolveAuthMode(runtimeEnv);
        if (mode !== 'mock') {
                throw error(404, 'Not found');
        }
}

export const POST: RequestHandler = async ({ request, cookies, platform }) => {
        assertMockMode(platform);

        let body: { role?: unknown; tier?: unknown };
        try {
                body = await request.json();
        } catch {
                throw error(400, 'Invalid JSON body');
        }

        const role = body.role;
        const tier = body.tier;
        if (!MOCK_ROLES.includes(role as MockRole)) {
                throw error(400, 'Invalid role');
        }
        if (!MOCK_TIERS.includes(tier as MockTier)) {
                throw error(400, 'Invalid tier');
        }

        const value = serializePreviewIdentity({
                role: role as MockRole,
                tier: tier as MockTier
        });

        cookies.set(PREVIEW_IDENTITY_COOKIE, value, {
                path: '/',
                httpOnly: true,
                sameSite: 'lax',
                maxAge: 60 * 60 * 24 * 30
        });

        return json({ ok: true, role, tier });
};

export const DELETE: RequestHandler = async ({ cookies, platform }) => {
        assertMockMode(platform);
        cookies.delete(PREVIEW_IDENTITY_COOKIE, { path: '/' });
        return json({ ok: true });
};
