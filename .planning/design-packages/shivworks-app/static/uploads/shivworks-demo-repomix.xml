export async function countActivePaidMembers(
        db: D1Compat
): Promise<{ bronze: number; vip: number }> {
        const row = await db
                .prepare(
                        `SELECT
                                SUM(CASE WHEN tier = 'bronze' THEN 1 ELSE 0 END) AS bronze,
                                SUM(CASE WHEN tier = 'vip' THEN 1 ELSE 0 END) AS vip
                         FROM members
                         WHERE tier IN ('bronze', 'vip') AND access_status = 'active'`
                )
                .first<{ bronze: number | null; vip: number | null }>();
        return { bronze: row?.bronze ?? 0, vip: row?.vip ?? 0 };
}

