import { json } from '@sveltejs/kit';
import type { RequestHandler } from './$types';
import { getDBFromPlatform } from '$lib/server/d1-compat';
import { requirePaidMember } from '$lib/server/guards';
import { finalizeOnboardingIfReady } from '$lib/server/onboarding';

export const POST: RequestHandler = async ({ locals, platform }) => {
	const user = requirePaidMember(locals, '/dashboard');
	const db = getDBFromPlatform(platform);
	const result = await finalizeOnboardingIfReady(db, user.clerkUserId, {
		memberCreatedAt: Date.parse(user.createdAt) || undefined
	});
	if (!result.eligible) {
		return json(
			{ success: false, error: 'not_eligible', state: result.state },
			{ status: 403 }
		);
	}
	return json({ success: true, awarded: result.awarded, state: result.state });
};
