  ON member_episode_progress(member_id, updated_at DESC);

INSERT INTO media_assets (
  id,
  provider,
  provider_asset_id,
  title,
  file_name,
  source_url,
  source_bytes,
  duration_seconds,
  duration_label,
  playback_policy,
  ingest_status,
  failure_reason,
  created_by_member_id,
  uploaded_at,
  playback_ready_at,
  created_at,
  updated_at
)
SELECT
  'media_' || course_modules.id,
  CASE
    WHEN course_modules.video_url LIKE '/videos/%' THEN 'external'
    ELSE 'external'
  END,
  NULL,
  course_modules.title,
  NULL,
  course_modules.video_url,
  NULL,
  NULL,
  course_modules.duration_label,
  'private',
  'ready',
  NULL,
  NULL,
  course_modules.updated_at,
  course_modules.updated_at,
  course_modules.created_at,
  course_modules.updated_at
FROM course_modules
WHERE course_modules.video_url IS NOT NULL
  AND course_modules.video_url != ''
ON CONFLICT(id) DO NOTHING;

INSERT INTO course_module_episodes (
  id,
  course_id,
  module_id,
  media_asset_id,
  episode_number,
  title,
  description,
  status,
  access_tier,
  sort_order,
  duration_label,
  created_at,
  updated_at
)
SELECT
  'episode_' || course_modules.id,
  course_modules.course_id,
  course_modules.id,
  'media_' || course_modules.id,
  1,
  course_modules.title,
  course_modules.description,
  course_modules.status,
  courses.access_tier,
  course_modules.sort_order,
  course_modules.duration_label,
  course_modules.created_at,
  course_modules.updated_at
FROM course_modules
INNER JOIN courses ON courses.id = course_modules.course_id
WHERE course_modules.video_url IS NOT NULL
  AND course_modules.video_url != ''
ON CONFLICT(id) DO NOTHING;
</file>

<file path="replit.md">
# ShivWorks Network in Replit

This repository is already scoped to the ShivWorks member app.

## Primary commands

- `pnpm install --frozen-lockfile=false`
- `pnpm dev -- --host 0.0.0.0 --port 3000`
- `pnpm check`
- `pnpm test`
- `pnpm build`

## App stack

- `SvelteKit`
- `Vite`
- `Cloudflare Pages`
- `Cloudflare D1`
- `Clerk`
- `Stripe`
- `Resend`
- `Circle`

## Runtime note

Use Node `20` in Replit. This app uses `better-sqlite3` for local D1 compatibility, and that dependency requires Node `20+`.

## Completed deliverables

### Deliverable 1 — Marketing landing page (`/`)
- 10-section page: Hero, Social Proof Bar, The Gap, Curriculum Preview (live DB), About Craig, Benefits, Founding Member Pricing (spot-based, live DB), Testimonials, FAQ, Footer CTA
- Global Nav shown; Footer suppressed for marketing page
- Redirects authenticated active users to `/dashboard`
- Pricing tiers: Bronze T1=$199 (sold out, 100 spots), T2=$249 (current, 571 remaining), T3=$299, T4=$399; VIP=$599 (200 spots). `LAUNCH_MEMBER_COUNT_FLOOR=100` ensures T1 displays as sold out in dev.
- Color system: ShivWorks red (`#e03126`) + dark neutral backgrounds — NOT amber/gold. All CSS variables and hardcoded rgba values updated globally.

### Deliverable 2 — Dashboard visual redesign
- `Sidebar.svelte` — 260px fixed left sidebar with brand, member identity, nav, progress pill, sign-out
- `dashboard/+page.svelte` — fully redesigned: greeting header, resume card with progress, What's New row (update + event), course grid, network row (community + roadshow), quick links
- Global layout now routes authenticated app pages (`/dashboard`, `/library`, `/community`, `/live`, `/updates`, `/vip-calls`, `/admin`) through sidebar layout instead of top Nav + Footer
- Page server (`+page.server.ts`) unchanged — all data sources and Clerk session logic intact

## Layout routing logic (global `+layout.svelte`)

| Page type | Nav | Sidebar | Footer |
|-----------|-----|---------|--------|
| Marketing (`/`) | Yes | No | No |
| Auth (`/login`, `/signup`, `/checkout`, `/welcome`) | No | No | No |
| Authenticated app pages | No | Yes | No |
| Everything else | Yes | No | Yes |

## Replit usage

Use Replit for product editing, previewing, and client-side iteration.

Do not replace the Cloudflare deployment or database path with Replit-managed hosting or storage unless that is a deliberate migration decision.

## Secrets to add in Replit

- `PUBLIC_CLERK_PUBLISHABLE_KEY`
- `CLERK_SECRET_KEY`
- `CLERK_JWT_KEY`
- `CLERK_WEBHOOK_SIGNING_SECRET`
- `STRIPE_SECRET_KEY`
- `STRIPE_WEBHOOK_SECRET`
- `STRIPE_BRONZE_PRICE_ID`
- `STRIPE_VIP_PRICE_ID`
- `RESEND_API_KEY`
- `PUBLIC_CIRCLE_COMMUNITY_URL`

## Roles & instructor permission

Member roles are stored in the `members.role` column with the values `member` and `admin`. There is no first-class `instructor` role; instructor-level permission for the analytics surface (`/admin/analytics`, weekly-question publishing, member tagging) is granted by assigning a member the `instructor` member tag. The server guard `requireAdminOrInstructor` accepts either `role === 'admin'` or the presence of the `instructor` tag, and the sidebar exposes the Analytics link to both groups via `data.isInstructor` from the root layout.
</file>

