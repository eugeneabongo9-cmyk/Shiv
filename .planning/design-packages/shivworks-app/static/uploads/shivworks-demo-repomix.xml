                        ></iframe>
                </div>
        {:else if playback && (playback.playbackType === 'mp4' || playback.playbackType === 'external') && playback.url}
                {#key episodeId}
                        <CustomVideoPlayer
                                src={playback.url}
                                initialSeconds={initialSeconds}
                                onTimeUpdate={(current, duration) => {
                                        if (duration && duration > 0) lastKnownDuration = duration;
                                        const rounded = Math.max(0, Math.round(current));
                                        if (Math.abs(rounded - lastReportedSeconds) >= 10) {
                                                lastReportedSeconds = rounded;
                                                onTimeUpdate?.(rounded, lastKnownDuration);
                                        }
                                }}
                                onPause={(current, duration) => {
                                        if (duration && duration > 0) lastKnownDuration = duration;
                                        const rounded = Math.max(0, Math.round(current));
                                        lastReportedSeconds = rounded;
                                        onPause?.(rounded, lastKnownDuration);
                                }}
                                onEnded={(duration) => {
                                        if (duration && duration > 0) lastKnownDuration = duration;
                                        onEnded?.(lastKnownDuration);
                                }}
                        />
                {/key}
        {:else}
                <div class="episode-state">
                        <p class="state-eyebrow">No playable media</p>
                        <p class="state-copy">This episode has no media attached yet.</p>
                </div>
        {/if}
