import type { D1Compat } from '$lib/server/d1-compat';
import type { ChannelRecord } from '$lib/server/db/shivworks';
import { awardPoints, type AwardResult } from '$lib/server/gamification';

/**
 * Award the right TP event(s) for a top-level community post.
 * `intro_post` is one-time (tracked by gamification engine), `aar_post`
 * is per-post in the AAR channel, otherwise generic `community_post`.
 * The engine handles per-day caps internally.
 */
export async function awardTopLevelPostTp(
	db: D1Compat,
	memberId: string,
	channel: ChannelRecord,
	messageId: string
): Promise<AwardResult | null> {
	const safe = async (action: 'intro_post' | 'aar_post' | 'community_post') => {
		try {
			return await awardPoints(db, {
				memberId,
				action,
				referenceType: 'message',
				referenceId: messageId
			});
		} catch (err) {
			console.error('[community-tp] awardPoints failed', action, err);
			return null;
		}
	};
	if (channel.slug === 'introductions') return safe('intro_post');
	if (channel.slug === 'after-action-reports') return safe('aar_post');
	return safe('community_post');
}

export async function awardThreadReplyTp(
	db: D1Compat,
	memberId: string,
	threadId: string
): Promise<AwardResult | null> {
	try {
		return await awardPoints(db, {
			memberId,
			action: 'community_reply',
			referenceType: 'thread_message',
			referenceId: threadId
		});
	} catch (err) {
		console.error('[community-tp] awardPoints failed community_reply', err);
		return null;
	}
}
</file>

<file path="src/lib/server/db-availability-guard.test.ts">
import { describe, it, expect, beforeEach } from 'vitest';
import {
        logDbUnavailableOnce,
        probeDatabase,
        renderDbUnavailablePage,
        resetDbGuardStateForTests,
        shouldBypassDbGuard
} from './db-availability-guard';

beforeEach(() => {
        resetDbGuardStateForTests();
});

describe('db-availability-guard', () => {
        it('bypasses webhook endpoints', () => {
                expect(shouldBypassDbGuard('/api/stripe/webhook')).toBe(true);
                expect(shouldBypassDbGuard('/api/clerk/webhook')).toBe(true);
                expect(shouldBypassDbGuard('/api/webhooks/stream')).toBe(true);
                expect(shouldBypassDbGuard('/dashboard')).toBe(false);
        });

        it('reports the missing D1 binding when platform.env exists but DB is unbound', async () => {
                const result = await probeDatabase({ env: {} }, {});
                expect(result.ok).toBe(false);
                if (result.ok) return;
                expect(result.failure.binding).toBe('DB');
                expect(result.failure.reason).toMatch(/not bound/i);
        });

        it('reports the underlying error when a D1 binding throws on probe', async () => {
                const original = process.env.SHIVWORKS_DB_MODE;
                process.env.SHIVWORKS_DB_MODE = 'cloudflare-d1';
                const exploding = {
                        env: {
                                DB: {
                                        prepare() {
                                                return {
                                                        bind() {
                                                                return this;
                                                        },
                                                        first() {
                                                                throw new Error('D1_ERROR: network unreachable');
                                                        }
                                                };
                                        }
                                }
                        }
                };
                try {
                        const result = await probeDatabase(exploding as never, {});
                        expect(result.ok).toBe(false);
                        if (result.ok) return;
                        expect(result.failure.reason).toMatch(/network unreachable/);
                } finally {
                        if (original === undefined) {
                                delete process.env.SHIVWORKS_DB_MODE;
                        } else {
                                process.env.SHIVWORKS_DB_MODE = original;
                        }
                }
        });

        it('renders a 503 HTML page that names the missing binding', async () => {
                const response = renderDbUnavailablePage({
                        binding: 'DB',
                        reason: 'binding missing'
                });
                expect(response.status).toBe(503);
                expect(response.headers.get('content-type')).toMatch(/text\/html/);
                expect(response.headers.get('cache-control')).toBe('no-store');
                const body = await response.text();
                expect(body).toMatch(/temporarily/i);
                expect(body).toMatch(/"DB"/);
        });

        it('logs each distinct failure signature only once', () => {
                const errors: unknown[][] = [];
                const original = console.error;
                console.error = (...args: unknown[]) => {
                        errors.push(args);
                };
                try {
                        logDbUnavailableOnce({ binding: 'DB', reason: 'gone' });
                        logDbUnavailableOnce({ binding: 'DB', reason: 'gone' });
                        logDbUnavailableOnce({ binding: 'DB', reason: 'different' });
                } finally {
                        console.error = original;
                }
                expect(errors.length).toBe(2);
        });
});
