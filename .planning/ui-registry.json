	"status_legend": {
		"port_status": {
			"NOT-PORTED": "Aaron has a designed version; our codebase has nothing",
			"STUB": "our codebase has a placeholder (ComingSoon, redirect, or old-brand version); Aaron has a real designed page",
			"CLAIMED": "an agent is actively porting — see port_owner",
			"PARTIAL": "port underway; structure landed but components or data wiring incomplete",
			"NEEDS-VERIFY": "port committed locally, awaiting Max review",
			"PR": "PR open against main — see port_pr",
			"PORTED-CLEAN": "verified, matches Aaron's intent, working in our codebase",
			"DIVERGED": "intentionally different from Aaron's — see divergence_reason",
			"LOCKED": "do not touch — see lock_reason"
