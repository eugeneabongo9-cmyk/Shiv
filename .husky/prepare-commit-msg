#!/usr/bin/env sh
# Strip Cursor agent attribution trailers so commits stay under the human author only.
MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
	exit 0
fi

tmp="${MSG_FILE}.strip"
grep -v -E -i 'Co-authored-by:[[:space:]]*Cursor|cursoragent@cursor\.com|Made-with:[[:space:]]*Cursor' "$MSG_FILE" > "$tmp" || true
mv "$tmp" "$MSG_FILE"
