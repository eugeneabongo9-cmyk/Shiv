{
        "$schema": "node_modules/wrangler/config-schema.json",
        "name": "shivworks-network",
        "compatibility_date": "2026-03-20",
        "compatibility_flags": ["nodejs_compat"],
        "pages_build_output_dir": ".svelte-kit/cloudflare",
        "vars": {
                "ENVIRONMENT": "production",
                "PUBLIC_SITE_URL": "https://theshivworksnetwork.com",
                "PUBLIC_SHIVWORKS_MAIN_SITE": "https://shivworks.com",
                "PUBLIC_SHIVWORKS_STORE_URL": "https://shivworkspg.com",
                "PUBLIC_SHIVWORKS_MEMBERSHIP_URL": "https://shivworkspg.com/theshivworksnetwork/",
                "PUBLIC_SUPPORT_EMAIL": "network@shivworks.com",
                // Clerk keys are NOT stored here — set per-environment in Cloudflare Pages
                // (Production: pk_live_* / sk_live_* + CLERK_WEBHOOK_SIGNING_SECRET from prod instance).
                "CLERK_AUTHORIZED_PARTIES": "https://theshivworksnetwork.com,https://www.theshivworksnetwork.com,https://shivworks-network-4zu.pages.dev",
                // Do not set NODE_ENV here — CF Pages injects wrangler vars at build time,
                // which makes pnpm skip devDependencies (vite, svelte-kit, husky). Use ENVIRONMENT.
                "CLOUDFLARE_ACCOUNT_ID": "ce810d489150aad89d66eabff9a0288e"
        },
        "d1_databases": [
                {
                        "binding": "DB",
                        "database_name": "shivworks-network-db",
                        "database_id": "77c0198a-378e-4eb7-aa56-801dc0fa6c3d",
                        "preview_database_id": "34989672-f824-405d-aed9-1efd4497fb7a"
                }
        ],
        "kv_namespaces": [
                {
                        "binding": "KV",
                        "id": "a6e45e2190b9435f91ac645ebf2b0ea2",
                        "preview_id": "a6e45e2190b9435f91ac645ebf2b0ea2"
                }
        ]
}
