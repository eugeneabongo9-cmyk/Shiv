# Public app routing
PUBLIC_SITE_URL=https://network.shivworks.com
PUBLIC_SHIVWORKS_MAIN_SITE=https://shivworks.com
PUBLIC_SHIVWORKS_STORE_URL=https://shivworkspg.com
PUBLIC_SHIVWORKS_MEMBERSHIP_URL=https://shivworkspg.com/theshivworksnetwork/
PUBLIC_CIRCLE_COMMUNITY_URL=https://community.example.com

# Clerk — use pk_test_/sk_test_ for local dev; pk_live_/sk_live_ for Cloudflare Production.
# Never commit real values. Production sets these in Cloudflare Pages encrypted env (not wrangler.jsonc).
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Comma-separated origins Clerk may issue session JWTs for (besides PUBLIC_SITE_URL).
# Production: https://theshivworksnetwork.com and branch preview host if needed.
# Dev only: Replit / local preview hosts.
CLERK_AUTHORIZED_PARTIES=https://theshivworksnetwork.com,https://www.theshivworksnetwork.com,https://shivworks-network-4zu.pages.dev

# (Stripe removed 2026-05-30 — Network uses WooCommerce/Fortis only.
#  See WC_WEBHOOK_SECRET below.)

# Email
RESEND_API_KEY=re_xxx
EMAIL_FROM=ShivWorks Network <noreply@network.shivworks.com>
PUBLIC_SUPPORT_EMAIL=network@shivworks.com
SUPPORT_EMAIL=network@shivworks.com

# Admins
SHIVWORKS_ADMIN_EMAILS=ops@shivworks.com

# Video storage / Cloudflare Stream
# Required only when using the direct upload API and signed Stream playback.
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_STREAM_API_TOKEN=xxx
CLOUDFLARE_STREAM_WEBHOOK_SECRET=whsec_xxx
# Optional comma-separated playback/upload origin allowlist.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=https://network.shivworks.com,https://shivworks-network.replit.app
# Optional signed playback token TTL seconds.
VIDEO_STREAM_TOKEN_TTL_SECONDS=14400

# WooCommerce purchase webhook
# Set in your secrets manager; configure the matching secret in WC → Settings → Webhooks.
# Production rejects placeholders (changeme, test, example, …) and secrets < 16 chars.
# Generate: openssl rand -base64 32
# Validate: ENVIRONMENT=production WC_WEBHOOK_SECRET=... pnpm validate:production-env
# WC_WEBHOOK_SECRET=

# WooCommerce webhook retry runner (POST /api/internal/wc-webhook-retries)
# Prefer CRON_SECRET. WC_WEBHOOK_RETRY_SECRET is accepted as a fallback.
# Call with Authorization: Bearer <secret> or x-cron-secret: <secret>.
# CRON_SECRET=
# WC_WEBHOOK_RETRY_SECRET=

# ActiveCampaign — optional. Used to tag purchasers on successful provisioning.
# Leave unset to disable AC tagging (the webhook still provisions to D1).
# ACTIVECAMPAIGN_API_URL=https://your-account.api-us1.com
# ACTIVECAMPAIGN_API_KEY=replace_me

# Sentry error monitoring
# Server-side (hooks.server.ts reads process.env directly)
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# Client-side (Vite exposes VITE_ prefixed vars to the browser)
VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX

# Database
# When set, app uses Postgres. Otherwise it falls back to local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_PATH=/absolute/path/to/shivworks-network.db
